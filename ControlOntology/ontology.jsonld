    "@value" : "Accept the level of risk based on existing information e.g. pursue the opportunity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Accept"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Action",
