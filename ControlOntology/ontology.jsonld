    "@value" : "Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Current risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DetectiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Detective control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DirectiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Directive control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ExternalAssuranceProviders",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "assurance from external independent assurance providers such as Regulators."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "External Assurance providers"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#FirstLineOfDefence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "the way risks are managed and controlled day-to-day. Assurance comes directly from those responsible for delivering specific objectives or processes. Its value comes from those who know the business, culture and day-to-day challenges."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "First line of defence"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#InherentRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Inherent risk in the HSE is the level of risk before consideration of control and/or action measures."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Inherent risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#InitialRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Initial risk is the level of risk after existing controls are considered when the risk was originally assessed."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Initial risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#PreventativeControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Preventative controls are controls designed to stop, discourage, pre-empt or limit the possibility of an undesirable event before it occurs."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Preventative control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Proactive controls are put in place before the risk materialises"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Proactive control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Reactive controlsfocus on what happens after the risk occurs or which identify weaknesses in our current controls"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Reactive control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Reduce",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Reduce the risk with further actions."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Reduce"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ResidualRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Residual risk in the HSE is the level of risk remaining after consideration of existing controls."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Residual risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#RiskTreatment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Risk treatment is the process to modify risk."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Risk treatment"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#SecondLineOfDefence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "the way the organisation oversees the control framework so that it operates effectively. The assurance provided is separate from those responsible for delivery, but not independent of the management chain, such as risk and compliance functions."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Second line of defence"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TargetRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Target risk in the HSE is the planned level of risk after consideration of both control and action measures."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Target risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ThirdLineOfDefence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "objective and independent assurance, e.g. internal audit, providing reasonable (not absolute) assurance of the overall effectiveness of governance, risk management and controls."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Third line of defence"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TransferRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Transfer the risk e.g. to an identified individual or unit, that has been communicated to and notified, where many of the actions identified as required to mitigate are better managed and are within their span of control."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Transfer the risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TreatementPlan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "treatment plans detail both action and effective control plans, to minimise the likelihood and impact of the identified risk."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Treatmant plan"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#AdministrativeControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Administrative controls change the way work is done or give workers more information by providing workers with relevant procedures, training, or warnings. They’re often used together with higher-level controls."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Administrative Control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Control",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-08"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : ""
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "NIOSH Control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Elimination",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Elimination makes sure the hazard no longer exists. Most effective method"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Elimination"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#EngineeringControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Engineering controls reduce exposure by preventing hazards from coming into contact with workers. They still allow workers to do their jobs, though."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Engineering Control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#PersonalProtectiveEquipment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Personal protective equipment (PPE) includes clothing and devices to protect workers. PPE needs constant effort and attention (including proper use and training) from workers. Higher-level controls aren’t always feasible, and PPE might be needed in conjunction with other control measures. Least effective contols."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Personal protective equipment"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Subsitution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/NIOSH-ControlOntology#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Substitution means changing out a material or process to reduce the hazard."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Substitution"
  } ]
}, {
  "@id" : "https://w3id.org/widoco/vocab#introduction",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
