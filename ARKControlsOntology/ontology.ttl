    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:source "ISO/IEC 27002:2022(E)"^^xsd:string ;
    rdfs:comment """ICT readiness should be planned, implemented, maintained and tested based on business continuity
objectives and ICT continuity requirements."""@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Corrective,
        :OrganizationalControl ;
