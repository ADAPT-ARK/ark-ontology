        arkcyt:Confidentiality,
        arkcyt:Defence,
        arkcyt:Identify,
        arkcyt:InformationProtection,
        arkcyt:Integerity,
        arkcyt:Protection ;
    arkc:hasRelatedConcept arkcyt:Availability,
        arkcyt:Confidentiality,
        arkcyt:Defence,
        arkcyt:Identify,
        arkcyt:InformationProtection,
        arkcyt:Integerity,
        arkcyt:Protection .

:ClearDeskAndClearScreen a rdfs:Class,
        owl:Class ;
