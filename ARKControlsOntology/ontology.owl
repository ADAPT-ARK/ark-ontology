    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlsOntology#hasActionOwner -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlsOntology#hasActionOwner">
        <rdfs:subPropertyOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasControlOwner"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-05</terms:created>
        <rdfs:comment xml:lang="en">Links a https://openark.adaptcentre.ie/Ontologies/ARKCube#Person to an action</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlsOntology#"/>
        <rdfs:label xml:lang="en">has action owner</rdfs:label>
    </owl:ObjectProperty>
    


