<https://openark.adaptcentre.ie/Ontologies/ARKPlatformTerminology#CommunityOfPractice>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "31/05/2022" ;
        <http://purl.org/dc/terms/source>
                "https://www.communityofpractice.ca/" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A community of practice (CoP) is a group of people who share a common concern, a set of problems, or an interest in a topic and who come together to fulfill both individual and group goals." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKPlatformTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Community of Practice (CoP)" .
