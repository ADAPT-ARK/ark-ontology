#################################################################
#    Object Properties
#################################################################

###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasCollaborator
:hasCollaborator rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isCollaboratorOf ;
                 rdfs:domain :Project ;
                 rdfs:range :User ;
                 rdfs:comment "Relates the Project with its collaborating User. The collaborator has a read/write/add subproject rights but not grant rights."@en ;
                 rdfs:label "has collaborator"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasOwner
:hasOwner rdf:type owl:ObjectProperty ;
          owl:inverseOf :isOwnerOf ;
          rdfs:domain :Project ;
          rdfs:range :User ;
          rdfs:comment "Relates the Project with its owner User. The owner has a full read/write/grant access rights."@en ;
          rdfs:label "has owner"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasProjectAnalysis
:hasProjectAnalysis rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isProjectAnalysisOf ;
                    rdfs:domain :Project ;
                    rdfs:range :ProjectAnalysis ;
                    rdfs:comment "Relates a Project with all the analysis done on the Project."@en ;
                    rdfs:label "has project analysis"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasReadOnlyUser
:hasReadOnlyUser rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isReadOnlyUserOf ;
                 rdfs:domain :Project ;
                 rdfs:range :User ;
                 rdfs:comment "Relates the Project with its ReadOnlyUser. The readonly user can view a specific Project but has no grant right."@en ;
                 rdfs:label "has readonly user"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasSubProject
:hasSubProject rdf:type owl:ObjectProperty ;
               owl:inverseOf :isSubProjectOf ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain :Project ;
               rdfs:range :Project ;
               rdfs:comment "Relate a Project with its subproject. A Project can have one or more subprojects within it."@en ;
               rdfs:label "has subproject"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#isCollaboratorOf
:isCollaboratorOf rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range :Project ;
                  rdfs:comment "Relates the collaborating User with a project. "@en ;
                  rdfs:label "is collaborator of"@en ;
                  owl:inverseOf "hasCollaborator" .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#isOwnerOf
:isOwnerOf rdf:type owl:ObjectProperty ;
           rdfs:domain :User ;
           rdfs:range :Project ;
           rdfs:comment "Relates the Owner User with a Project. The owner has a full read/write/grant access rights."@en ;
           rdfs:label "is owner of"@en ;
           owl:inverseOf "hasOwner" .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#isProjectAnalysisOf
:isProjectAnalysisOf rdf:type owl:ObjectProperty ;
                     rdfs:domain :ProjectAnalysis ;
                     rdfs:range :Project ;
                     rdfs:comment "Relates a Project Analysis with its Project."@en ;
                     rdfs:label "is project analysis of"@en ;
                     owl:inverseOf "hasProjectAnalysis" .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#isReadOnlyUserOf
:isReadOnlyUserOf rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range :Project ;
                  rdfs:comment "Relates the ReadOnlyUser with a Project. "@en ;
                  rdfs:label "is readonlyuser of"@en ;
                  owl:inverseOf "hasReadOnlyUser" .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#isSubProjectOf
:isSubProjectOf rdf:type owl:ObjectProperty ;
                rdfs:domain :Project ;
                rdfs:range :Project ;
                rdfs:comment "Relates a project with its parent Project."@en ;
                rdfs:label "is subproject of"@en ;
                owl:inverseOf "hasSubProject" .


#################################################################
#    Data properties
#################################################################

###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#dataStatus
:dataStatus rdf:type owl:DatatypeProperty ;
            rdfs:domain owl:Thing ;
            rdfs:range rdfs:Literal ;
            rdfs:comment "The status of the data. Deleted  when the data is deleted by the user"@en ;
            rdfs:label "data status"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#designedBy
:designedBy rdf:type owl:DatatypeProperty ;
            rdfs:domain :Project ;
            rdfs:range rdfs:Literal ;
            rdfs:comment "The user who designed the project."@en ;
            rdfs:label "designed by"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#efficacy
:efficacy rdf:type owl:DatatypeProperty ;
          rdfs:domain :ProjectAnalysis ;
          rdfs:range rdfs:Literal ;
          rdfs:comment "The efficacy of the solution."@en ;
          rdfs:label "efficacy"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#importance
:importance rdf:type owl:DatatypeProperty ;
            rdfs:domain :ProjectAnalysis ;
            rdfs:range rdfs:Literal ;
            rdfs:comment "Importance of the problem under analysis."@en ;
            rdfs:label "importance"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#name
:name rdf:type owl:DatatypeProperty ;
      rdfs:domain :Project ;
      rdfs:range rdfs:Literal ;
      rdfs:comment "The name of a project"@en ;
      rdfs:label "project name"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#organisationName
:organisationName rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Project ;
                  rdfs:range rdfs:Literal ;
                  rdfs:comment "The name of the organisation "@en ;
                  rdfs:label "organisation name"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#potentialLoss
:potentialLoss rdf:type owl:DatatypeProperty ;
               rdfs:domain :ProjectAnalysis ;
               rdfs:range rdfs:Literal ;
               rdfs:comment "Potential loss due to the problem."@en ;
               rdfs:label "potential loss"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#projectedGain
:projectedGain rdf:type owl:DatatypeProperty ;
               rdfs:domain :ProjectAnalysis ;
               rdfs:range rdfs:Literal ;
               rdfs:comment "The gain achieved by the project."@en ;
               rdfs:label "projected gain"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#projectedValue
:projectedValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :ProjectAnalysis ;
                rdfs:range rdfs:Literal ;
                rdfs:comment "The projected value of the project."@en ;
                rdfs:label "projected value"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#reportTo
:reportTo rdf:type owl:DatatypeProperty ;
          rdfs:domain :Project ;
          rdfs:range rdfs:Literal ;
          rdfs:comment "The person to whom the analysis is reported to."@en ;
          rdfs:label "report to"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#status
:status rdf:type owl:DatatypeProperty ;
        rdfs:domain :Project ;
        rdfs:range rdfs:Literal ;
        rdfs:comment "The current status of a project"@en ;
        rdfs:label "project Status"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#value
:value rdf:type owl:DatatypeProperty ;
       rdfs:domain :ProjectAnalysis ;
       rdfs:range rdfs:Literal ;
       rdfs:comment "An entity’s value is created, preserved, eroded or realized based on the relationship between the benefits derived from resources deployed and the cost of those resources."@en ;
       rdfs:label "value"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#viability
:viability rdf:type owl:DatatypeProperty ;
           rdfs:domain :ProjectAnalysis ;
           rdfs:range rdfs:Literal ;
           rdfs:comment "Viability of the proposed solution."@en ;
           rdfs:label "viablity"@en .


#################################################################
#    Classes
#################################################################

###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#AdminUser
:AdminUser rdf:type owl:Class ;
           rdfs:subClassOf :User ;
           <http://purl.org/dc/elements/1.1/creator> "Ademar" ;
           rdfs:comment "An admin user has access to all projects." ;
           rdfs:label "AdminUser" .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#Project
:Project rdf:type owl:Class ;
         rdfs:comment "An individual or collaborative enterprise that is carefully planned to achieve a particular aim."@en ;
         rdfs:label "Project"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis
:ProjectAnalysis rdf:type owl:Class ;
                 rdfs:comment "Project analysis is a high-level ark project analysis used to identify values, loss, efficacy etc"@en ;
                 rdfs:label "Project Analysis"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#User
:User rdf:type owl:Class ;
      <http://purl.org/dc/elements/1.1/description> "The user of the ARK projects application"@en ;
      rdfs:comment "The user of the project can take three types. Owner, Collaborator, ReadOnlyUser"@en ;
      rdfs:label "User"@en .


#################################################################
#    Individuals
#################################################################

###  https://ark.adaptcentre.ie/Ontologies/ARKProjects#
<https://ark.adaptcentre.ie/Ontologies/ARKProjects#> rdf:type owl:NamedIndividual .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Project
                :ProjectAnalysis
                :User
              )
] .


