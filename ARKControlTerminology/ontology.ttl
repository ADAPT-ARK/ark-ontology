    dcterms:source "ISO IEC 27043:2023" ;
    rdfs:comment "defined organizational function or role serving as the coordinator or focal point of information concerning incident management activities"@en ;
    rdfs:isDefinedBy arkcyt: ;
    skos:definition "defined organizational function or role serving as the coordinator or focal point of information concerning incident management activities"@en ;
