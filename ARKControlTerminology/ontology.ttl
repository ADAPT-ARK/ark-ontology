                                                                    <http://purl.org/dc/terms/description> "This taxonomy defines cybersecurity terms, taken from ISO and NIST documents, that are used to model this domain on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO terms."@en ;
                                                                    <http://purl.org/dc/terms/format> "text/turtle" ;
                                                                    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                                    <http://purl.org/dc/terms/modified> "2024-05-29"^^xsd:date ;
                                                                    <http://purl.org/dc/terms/rights> :RightsStatement ;
                                                                    <http://purl.org/ontology/bibo/status> <http://purl.org/ontology/bibo/status/draft> ;
                                                                    <http://purl.org/vocab/vann/preferredNamespacePrefix> "arkcyt" ;
                                                                    <http://purl.org/vocab/vann/preferredNamespaceUri> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                                                                    <http://schema.org/codeRepository> <https://gogs.adaptcentre.ie/ARK/Ontologies/src/master/ARKControlOntology> ;
                                                                    <http://schema.org/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                                    rdfs:comment "This taxonomy defines cybersecurity terms, taken from ISO and NIST documents, that are used to model this domain on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO terms."@en ;
                                                                    rdfs:label "ARK Cybersecurity Terminology"@en ;
                                                                    owl:versionInfo "0.1" ;
                                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#status> <http://www.w3.org/2003/06/sw-vocab-status/ns#unstable> ;
                                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "ARK Cybersecurity Terminology"@en ;
