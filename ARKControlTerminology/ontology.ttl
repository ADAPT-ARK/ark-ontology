###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AccessControl
:AccessControl rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos/core#Concept> ;
               <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                      "Rob Brennan" ;
               <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
               <http://purl.org/dc/terms/source> "ISO27000:2018" ;
               rdfs:comment "means to ensure that access to assets is authorized and restricted based on business and security requirements"@en ;
               rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
               rdfs:label "Access control"@en ;
               <http://www.w3.org/2004/02/skos/core#broader> :InformationSecurity ;
               <http://www.w3.org/2004/02/skos/core#definition> "means to ensure that access to assets is authorized and restricted based on business and security requirements"@en ;
               <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Access control"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ApplicationSecurity
:ApplicationSecurity rdf:type owl:NamedIndividual ,
                              <http://www.w3.org/2004/02/skos/core#Concept> ;
                     <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                            "Rob Brennan" ;
                     <http://purl.org/dc/terms/created> "2024-03-14"^^xsd:date ;
                     <http://purl.org/dc/terms/source> "ISO/IEC 27002:2022(E)" ;
                     rdfs:comment "includes all tasks that introduce a secure software development life cycle to development teams. Its final goal is to improve security practices and, through that, to find, fix and preferably prevent security issues within applications."@en ;
                     rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                     rdfs:label "Application security"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "includes all tasks that introduce a secure software development life cycle to development teams. Its final goal is to improve security practices and, through that, to find, fix and preferably prevent security issues within applications."@en ;
                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Application security"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AssetManagement
:AssetManagement rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#Concept> ;
                 <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                        "Rob Brennan" ;
                 <http://purl.org/dc/terms/created> "2024-03-14"^^xsd:date ;
                 <http://purl.org/dc/terms/source> "ISO/IEC 27002:2022(E)" ;
                 rdfs:comment "An ISCM capability that identifies unauthorized software or unmanaged devices that are likely to be used by attackers as a platform from which to extend compromise of the network to be mitigated."@en ;
                 rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                 rdfs:label "Asset management"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "An ISCM capability that identifies unauthorized software or unmanaged devices that are likely to be used by attackers as a platform from which to extend compromise of the network to be mitigated."@en ;
                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Asset management"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Attack
:Attack rdf:type owl:NamedIndividual ,
                 <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                               "Rob Brennan" ;
        <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
        <http://purl.org/dc/terms/source> "ISO27000:2018" ;
        rdfs:comment "attempt to destroy, expose, alter, disable, steal or gain unauthorized access to or make unauthorized use of an asset."@en ;
        rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
        rdfs:label "Attack"@en ;
        <http://www.w3.org/2004/02/skos/core#broader> :InformationSecurityIncident ;
        <http://www.w3.org/2004/02/skos/core#definition> "attempt to destroy, expose, alter, disable, steal or gain unauthorized access to or make unauthorized use of an asset."@en ;
        <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Attack"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Audit
:Audit rdf:type owl:NamedIndividual ,
                <http://www.w3.org/2004/02/skos/core#Concept> ;
       <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                              "Rob Brennan" ;
       <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
       <http://purl.org/dc/terms/source> "ISO27000:2018" ;
       rdfs:comment "systematic, independent and documented process (3.54) for obtaining audit evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled Note 1 to entry: An audit can be an internal audit (first party) or an external audit (second party or third party), and it can be a combined audit (combining two or more disciplines). Note 2 to entry: An internal audit is conducted by the organization itself, or by an external party on its behalf. Note 3 to entry: “Audit evidence” and “audit criteria” are defined in ISO 19011."@en ;
       rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
       rdfs:label "Audit"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "systematic, independent and documented process (3.54) for obtaining audit evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled Note 1 to entry: An audit can be an internal audit (first party) or an external audit (second party or third party), and it can be a combined audit (combining two or more disciplines). Note 2 to entry: An internal audit is conducted by the organization itself, or by an external party on its behalf. Note 3 to entry: “Audit evidence” and “audit criteria” are defined in ISO 19011."@en ;
       <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
       <http://www.w3.org/2004/02/skos/core#narrower> :CombinedAudit ,
                                                      :ExternalAudit ,
                                                      :InternalAudit ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Audit"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AuditScope
:AuditScope rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ;
            <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                   "Rob Brennan" ;
            <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
            <http://purl.org/dc/terms/source> "ISO27000:2018" ;
            rdfs:comment "extent and boundaries of an audit (3.3)"@en ;
            rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
            rdfs:label "Audit scope"@en ;
            <http://www.w3.org/2004/02/skos/core#broader> :Audit ;
            <http://www.w3.org/2004/02/skos/core#definition> "extent and boundaries of an audit (3.3)"@en ;
            <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Audit scope"@en .


