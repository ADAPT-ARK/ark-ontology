###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#BaseMeasure
:BaseMeasure rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos/core#Concept> ;
             <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                    "Rob Brennan" ;
             <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
             <http://purl.org/dc/terms/source> "ISO27000:2018" ;
             rdfs:comment "measure (3.42) defined in terms of an attribute and the method for quantifying it Note 1 to entry: A base measure is functionally independent of other measures."@en ;
             rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
             rdfs:label "Base measure"@en ;
             <http://www.w3.org/2004/02/skos/core#broader> :Measure ;
