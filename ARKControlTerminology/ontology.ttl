###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InternalContext
:InternalContext rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#Concept> ;
                 <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                        "Rob Brennan" ;
                 <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
                 <http://purl.org/dc/terms/source> "ISO27000:2018" ;
                 rdfs:comment "internal environment in which the organization (3.50) seeks to achieve its objectives Note 1 to entry: Internal context can include: — governance, organizational structure, roles and accountabilities; — policies (3.53), objectives (3.49), and the strategies that are in place to achieve them; — the capabilities, understood in terms of resources and knowledge (e.g. capital, time, people, processes (3.54), systems and technologies); — information systems (3.35), information flows and decision-making processes (both formal and informal); — relationships with, and perceptions and values of, internal stakeholders (3.37); — the organization's culture; — standards, guidelines and models adopted by the organization; — form and extent of contractual relationships."@en ;
                 rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                 rdfs:label "Internal context"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "internal environment in which the organization (3.50) seeks to achieve its objectives Note 1 to entry: Internal context can include: — governance, organizational structure, roles and accountabilities; — policies (3.53), objectives (3.49), and the strategies that are in place to achieve them; — the capabilities, understood in terms of resources and knowledge (e.g. capital, time, people, processes (3.54), systems and technologies); — information systems (3.35), information flows and decision-making processes (both formal and informal); — relationships with, and perceptions and values of, internal stakeholders (3.37); — the organization's culture; — standards, guidelines and models adopted by the organization; — form and extent of contractual relationships."@en ;
                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                 <http://www.w3.org/2004/02/skos/core#narrower> :CapabilitiesContext ,
                                                                :ContractualContext ,
                                                                :CultureContext ,
                                                                :DecisionMakingProcessContext ,
                                                                :GovernanceContext ,
                                                                :GuidelinesContext ,
                                                                :InformationFlowContext ,
                                                                :InformationSystemContext ,
                                                                :InternalStakeholderContext ,
                                                                :ModelsContext ,
                                                                :ObjectiveContext ,
                                                                :OrganisationalStructureContext ,
                                                                :OrganizationalAccountabilityContext ,
                                                                :OrganizationalRoleContext ,
                                                                :PolicyContext ,
                                                                :StandardsContext ,
                                                                :StrategyContext ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Internal context"@en .


