                        <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
                        <http://purl.org/dc/terms/source> "ISO27000:2041" ;
                        rdfs:comment "Information flow control adds metadata to data flows (data transfer across networks, files read from the disc, and so on) and ensures that sensitive data does not flow from a higher security context to a lower security context."@en ;
                        rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                        rdfs:label "Information flow context"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Information flow control adds metadata to data flows (data transfer across networks, files read from the disc, and so on) and ensures that sensitive data does not flow from a higher security context to a lower security context."@en ;
                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Information flow context"@en .


