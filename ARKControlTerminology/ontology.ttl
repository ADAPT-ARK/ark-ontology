    rdfs:isDefinedBy arkcyt: ;
    skos:broader arkcyt:Organization ;
    skos:definition "person or group of people who are accountable for the performance (3.52) and conformity of the organization (3.50) Note 1 to entry: The governing body can, in some jurisdictions, be a board of directors."@en ;
    skos:inScheme arkcyt: ;
    skos:prefLabel "Governing body"@en .

