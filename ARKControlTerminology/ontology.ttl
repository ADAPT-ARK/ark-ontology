                     rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                     rdfs:label "Information security"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "preservation of confidentiality (3.10), integrity (3.36) and availability (3.7) of information Note 1 to entry: In addition, other properties, such as authenticity (3.6), accountability, non-repudiation (3.48), and reliability (3.55) can also be involved."@en ;
                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Information security"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityAssurance
:InformationSecurityAssurance rdf:type owl:NamedIndividual ,
                                       <http://www.w3.org/2004/02/skos/core#Concept> ;
                              <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                                     "Rob Brennan" ;
                              <http://purl.org/dc/terms/created> "2024-03-14"^^xsd:date ;
                              <http://purl.org/dc/terms/source> "ISO/IEC 27002:2022(E)" ;
                              rdfs:comment "Measure of confidence that the security features, practices, procedures, and architecture of an information system accurately mediates and enforces the security policy."@en ;
                              rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                              rdfs:label "Information security assurance"@en ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Measure of confidence that the security features, practices, procedures, and architecture of an information system accurately mediates and enforces the security policy."@en ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Information security assurance"@en .


