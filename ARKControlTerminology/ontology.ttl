               <http://purl.org/dc/terms/source> "ISO27000:2020" ;
               rdfs:comment "An external audit is performed by an independent auditor or auditing firm not affiliated with the organization being audited."@en ;
               rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
               rdfs:label "External audit"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An external audit is performed by an independent auditor or auditing firm not affiliated with the organization being audited."@en ;
