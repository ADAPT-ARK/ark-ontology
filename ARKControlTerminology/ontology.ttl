###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#PoliticalEnvironment
:PoliticalEnvironment rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#Concept> ;
                      <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                             "Rob Brennan" ;
                      <http://purl.org/dc/terms/created> "2024-04-08"^^xsd:date ;
                      <http://purl.org/dc/terms/source> "ISO27000:2029" ;
                      rdfs:comment "The political environment in the context of cybersecurity refers to the influence of governmental policies, regulations, and actions on cybersecurity practices, strategies, and challenges."@en ;
