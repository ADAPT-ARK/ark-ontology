                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#> ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Review objective"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#RightsStatement
:RightsStatement rdf:type owl:NamedIndividual ,
                          <http://purl.org/dc/terms/RightsStatement> ;
                 <http://purl.org/dc/terms/rights> "This work is licensed under a Creative Commons Attribution 4.0 International License." ;
