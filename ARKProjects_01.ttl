@prefix arkp: <https://ark.adaptcentre.ie/Ontologies/ARKProjects#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vocab: <http://purl.org/vocab/vann/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

arkp: a owl:NamedIndividual,
        owl:Ontology ;
    dc:contributor "Junli Liang",
        "Natalia Duda",
        "Nick McDonald",
        "Rob Brennan" ;
    dc:creator "Yalemisew Abgaz" ;
    dc:description "A model for representing concepts, relationships and axioms for Access Risk Knowledge for organisational risk analysis and management."@en ;
    dc:issued "02/07/2019" ;
    dc:modified "18/04/2020" ;
    dc:publisher "https://www.ark.adaptcentre.ie/" ;
    dc:rights "https://creativecommons.org/licenses/by-nc/4.0/" ;
    dc:title "Access Risk Knowledge Projects Ontology"@en ;
    vocab:preferredNamespacePrefix "ARKP" ;
    vocab:preferredNamespaceUri "https://ark.adaptcentre.ie/Ontologies/ARKProjects#" ;
    owl:versionIRI <https://ark.adaptcentre.ie/Ontologies/ARKProjects/0.1> ;
    owl:versionInfo "0.1" .

arkp:DataStatus a owl:DatatypeProperty ;
    rdfs:label "Data status"@en ;
    dc:description "The status of the data. Deleted  when the data is deleted by the user"@en ;
    rdfs:range rdfs:Literal .

arkp:DesignedBy a owl:DatatypeProperty ;
    rdfs:label "Designed by"@en ;
    dc:description "The user who designed the project"@en ;
    rdfs:range rdfs:Literal .

arkp:Efficacy a owl:DatatypeProperty ;
    rdfs:label "Efficacy"@en ;
    dc:description "The efficacy of the solution."@en ;
    rdfs:range rdfs:Literal .

arkp:Importance a owl:DatatypeProperty ;
    rdfs:label "importance"@en ;
    dc:description "Importance of the problem under analysis."@en ;
    rdfs:range rdfs:Literal .

arkp:Name a owl:DatatypeProperty ;
    rdfs:label "Project name"@en ;
    dc:description "The name of a project"@en ;
    rdfs:range rdfs:Literal .

arkp:OrganisationName a owl:DatatypeProperty ;
    rdfs:label "Organisation name"@en ;
    dc:description "The name of the organisation "@en ;
    rdfs:range rdfs:Literal .

arkp:ProjectedGain a owl:DatatypeProperty ;
    rdfs:label "Projected gain"@en ;
    dc:description "Projected gain"@en ;
    rdfs:range rdfs:Literal .

arkp:ProjectedValue a owl:DatatypeProperty ;
    rdfs:label "Projected value"@en ;
    dc:description "Projected value"@en ;
    rdfs:range rdfs:Literal .

arkp:ReportTo a owl:DatatypeProperty ;
    rdfs:label "Report to"@en ;
    dc:description "The person to whom the analysis is reported to"@en ;
    rdfs:range rdfs:Literal .

arkp:Status a owl:DatatypeProperty ;
    rdfs:label "Project Status"@en ;
    dc:description "The current status of a project"@en ;
    rdfs:range rdfs:Literal .

arkp:Value a owl:DatatypeProperty ;
    rdfs:label "Value"@en ;
    dc:description "an entity’s value is created, preserved, eroded or realized based on the relationship between the benefits derived from resources deployed and the cost of those resources."@en ;
    rdfs:range rdfs:Literal .

arkp:Version a owl:DatatypeProperty ;
    rdfs:label "Aircraft registration number"@en ;
    dc:description "The aircraft registration number "@en ;
    rdfs:range rdfs:Literal .

arkp:Viability a owl:DatatypeProperty ;
    rdfs:label "Viablity"@en ;
    dc:description "Viability"@en ;
    rdfs:range rdfs:Literal .

arkp:hasCollaborator a owl:ObjectProperty ;
    rdfs:label "has collaborator"@en ;
    dc:description "Relates the Project with its collaborating User. The collaborator has a read/write/add subproject rights but not grant rights."@en ;
    rdfs:domain arkp:Project ;
    rdfs:range arkp:User .

arkp:hasOwner a owl:ObjectProperty ;
    rdfs:label "has owner"@en ;
    dc:description "Relates the Project with its owner User. The owner has a full read/write/grant access rights."@en ;
    rdfs:domain arkp:Project ;
    rdfs:range arkp:User .

arkp:hasProjectAnalysis a owl:ObjectProperty ;
    rdfs:label "has project analysis"@en ;
    dc:description "Relates a Project with all the analysis done on the Project."@en ;
    rdfs:domain arkp:Project ;
    rdfs:range arkp:ProjectAnalysis .

arkp:hasReadOnlyUser a owl:ObjectProperty ;
    rdfs:label "has readonly user"@en ;
    dc:description "Relates the Project with its ReadOnlyUser. The readonly user can view a specific Project but has no grant right."@en ;
    rdfs:domain arkp:Project ;
    rdfs:range arkp:User .

arkp:hasSubProject a owl:ObjectProperty ;
    rdfs:label "has subproject"@en ;
    dc:description "Relate a Project with its subproject. A Project can have one or more subprojects within it."@en ;
    rdfs:domain arkp:Project ;
    rdfs:range arkp:Project .

arkp:isCollaboratorOf a owl:ObjectProperty ;
    rdfs:label "is collaborator of"@en ;
    dc:description "Relates the collaborating User with a project. "@en ;
    rdfs:domain arkp:User ;
    rdfs:range arkp:Project ;
    owl:inverseOf "hasCollaborator" .

arkp:isOwnerOf a owl:ObjectProperty ;
    rdfs:label "is owner of"@en ;
    dc:description "Relates the Owner User with a Project. The owner has a full read/write/grant access rights."@en ;
    rdfs:domain arkp:User ;
    rdfs:range arkp:Project ;
    owl:inverseOf "hasOwner" .

arkp:isProjectAnalysisOf a owl:ObjectProperty ;
    rdfs:label "is project analysis of"@en ;
    dc:description "Relates a Project Analysis with its Project."@en ;
    rdfs:domain arkp:ProjectAnalysis ;
    rdfs:range arkp:Project ;
    owl:inverseOf "hasProjectAnalysis" .

arkp:isReadOnlyUserOf a owl:ObjectProperty ;
    rdfs:label "is readonlyuser of"@en ;
    dc:description "Relates the ReadOnlyUser with a Project. "@en ;
    rdfs:domain arkp:User ;
    rdfs:range arkp:Project ;
    owl:inverseOf "hasReadOnlyUser" .

arkp:isSubProjectOf a owl:ObjectProperty ;
    rdfs:label "is subproject of"@en ;
    dc:description "Relates a project with its parent Project."@en ;
    rdfs:domain arkp:Project ;
    rdfs:range arkp:Project ;
    owl:inverseOf "hasSubProject" .

arkp:potentialLoss a owl:DatatypeProperty ;
    rdfs:label "Potential loss"@en ;
    dc:description "Potential loss"@en ;
    rdfs:range rdfs:Literal .

arkp:ProjectAnalysis a owl:Class ;
    rdfs:label "Project analysis is a high-level ark project analysis used to identify values, loss, efficacy etc"@en ;
    dc:description "Project analysis is a high-level ark project analysis used to identify values, loss, efficacy etc"@en ;
    rdfs:comment "Project analysis is a high-level ark project analysis used to identify values, loss, efficacy etc"@en .

arkp:User a owl:Class ;
    rdfs:label "User"@en ;
    dc:description "The user of the ARK projects application"@en ;
    rdfs:comment "The user of the project can take three types. Owner, Collaborator, ReadOnlyUser"@en .

arkp:Project a owl:Class ;
    rdfs:label "Project"@en ;
    dc:description "An individual or collaborative enterprise that is carefully planned to achieve a particular aim."@en ;
    rdfs:comment "An individual or collaborative enterprise that is carefully planned to achieve a particular aim."@en .

