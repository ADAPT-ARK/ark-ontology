        <vann:preferredNamespacePrefix>arkcscOWL</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://openark.adaptcentre.ie/Ontologies/CybersecurityControl-OWL#"/>
        <rdfs:comment xml:lang="en">This taxonomy defines the cybersecurity terms, taken from the ISO27002 document, that are used on the ARK Platform.</rdfs:comment>
        <owl:versionInfo>0.1</owl:versionInfo>
        <vocab:introduction xml:lang="en">This taxonomy defines the cybersecurity terms, taken from the ISO27002 document, that are used on the ARK Platform.</vocab:introduction>
