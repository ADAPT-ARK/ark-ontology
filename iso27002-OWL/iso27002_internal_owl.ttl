        arkcscOWL:Identify,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Recover,
        arkcscOWL:Resillience,
        arkcscOWL:Respond .

arkcscOWL:ContactWithSpecialInterestGroups a owl:Class ;
    rdfs:label "Contact with special interest groups"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization should establish and maintain contact with special interest groups or other specialist security forums and professional associations."@en ;
    rdfs:subClassOf arkcscOWL:Corrective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Defence,
        arkcscOWL:Govrnance,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Recover,
        arkcscOWL:Respond .

arkcscOWL:DataLeakagePrevention a owl:Class ;
    rdfs:label "Data leakage prevention"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Data leakage prevention measures should be applied to systems, networks and any other devices that process, store or transmit sensitive information."@en ;
    rdfs:subClassOf arkcscOWL:Detective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Confidentiality,
        arkcscOWL:Detect,
        arkcscOWL:Information_protection,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:DataMasking a owl:Class ;
    rdfs:label "Data masking"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Data masking should be used in accordance with the organization’s topic-specific policy on access control and other related topic-specific policies, and business requirements, taking applicable legislation into consideration."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Confidentiality,
        arkcscOWL:Information_protection,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:DisciplinaryProcess a owl:Class ;
    rdfs:label "Disciplinary process"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "A disciplinary process should be formalized and communicated to take actions against personnel and other relevant interested parties who have committed an information security policy violation"@en ;
    rdfs:subClassOf arkcscOWL:Corrective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Governance_and_Ecosystem,
        arkcscOWL:Human_resource_security,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Respond .

