arkcscOWL:ICTReadinessForBusinessContinuity a owl:Class ;
    rdfs:label "ICT readiness for business continuity"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
