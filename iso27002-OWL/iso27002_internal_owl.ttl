arkcscOWL:Corrective a owl:Class ;
    rdfs:label "Corrective"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The control acts after an information security incident occurs."@en .

arkcscOWL:Detective a owl:Class ;
