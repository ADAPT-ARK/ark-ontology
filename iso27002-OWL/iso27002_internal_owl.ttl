arkcscOWL:AcceptableUseOfInformationAndOtherAssociatedAssets a owl:Class ;
    rdfs:label "Acceptable use of information and other associated assets"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Rules for the acceptable use and procedures for handling information and other associated assets should be identified, documented and implemented."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Asset_management,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Governance_and_Ecosystem,
        arkcscOWL:Information_protection,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:AccessControl a owl:Class ;
    rdfs:label "Access control"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Rules to control physical and logical access to information and other associated assets should be established and implemented based on business and information security requirements."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Identity_and_access_management,
        arkcscOWL:Integerity,
        arkcscOWL:Proection,
        arkcscOWL:Protect .

arkcscOWL:AccessRights a owl:Class ;
    rdfs:label "Access rights"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Access rights to information and other associated assets should be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Identity_and_access_management,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:AccessToSourceCode a owl:Class ;
    rdfs:label "Access to source code"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Read and write access to source code, development tools and software libraries should be appropriately managed."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Application_security,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Identity_and_access_management,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection,
        arkcscOWL:Secure_configuration .

arkcscOWL:AddressingInformationSecurityWithinSupplierAgreements a owl:Class ;
    rdfs:label "Addressing information security within supplier agreements"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Relevant information security requirements should be established and agreed with each supplier based on the type of supplier relationship."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Governance_and_Ecosystem,
        arkcscOWL:Identify,
        arkcscOWL:Integerity,
        arkcscOWL:Protection,
        arkcscOWL:Supplier_relationships_security .

arkcscOWL:ApplicationSecurityRequirements a owl:Class ;
    rdfs:label "Application security requirements"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information security requirements should be identified, specified and approved when developing or acquiring applications."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Application_security,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Defence,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection,
        arkcscOWL:System_and_network_security .

arkcscOWL:AssessmentAndDecisionOnInformationSecurityEvents a owl:Class ;
    rdfs:label "Assessment and decision on information security events"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization should assess information security events and decide if they are to be categorized as information security incidents."@en ;
    rdfs:subClassOf arkcscOWL:Detective ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Defence,
        arkcscOWL:Detect,
        arkcscOWL:Information_security_event_management,
        arkcscOWL:Integerity,
        arkcscOWL:Respond .

arkcscOWL:AuthenticationInformation a owl:Class ;
    rdfs:label "Authentication information"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Allocation and management of authentication information should be controlled by a management process, including advising personnel on the appropriate handling of authentication information."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Identity_and_access_management,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:CablingSecurity a owl:Class ;
    rdfs:label "Cabling security"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Cables carrying power, data or supporting information services should be protected from interception, interference or damage."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Physical_security,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:CapacityManagement a owl:Class ;
    rdfs:label "Capacity management"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The use of resources should be monitored and adjusted in line with current and expected capacity requirements."@en ;
    rdfs:subClassOf arkcscOWL:Detective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Continuity,
        arkcscOWL:Detect,
        arkcscOWL:Governance_and_Ecosystem,
        arkcscOWL:Identify,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:ChangeManagement a owl:Class ;
    rdfs:label "Change management"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Changes to information processing facilities and information systems should be subject to change management procedures."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Application_security,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection,
        arkcscOWL:System_and_network_security .

arkcscOWL:ClassificationOfInformation a owl:Class ;
    rdfs:label "Classification of information"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information should be classified according to the information security needs of the organization based on confidentiality, integrity, availability and relevant interested party requirements."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Defence,
        arkcscOWL:Identify,
        arkcscOWL:Information_protection,
        arkcscOWL:Integerity,
        arkcscOWL:Protection .

arkcscOWL:ClearDeskAndClearScreen a owl:Class ;
    rdfs:label "Clear desk and clear screen"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Clear desk rules for papers and removable storage media and clear screen rules for information processing facilities should be defined and appropriately enforced."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Confidentiality,
        arkcscOWL:Physical_security,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:ClockSynchronization a owl:Class ;
    rdfs:label "Clock synchronization"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The clocks of information processing systems used by the organization should be synchronized to approved time sources."@en ;
    rdfs:subClassOf arkcscOWL:Detective ;
    arkc:hasRelatedConcept arkcscOWL:Defence,
        arkcscOWL:Detect,
        arkcscOWL:Information_security_event_management,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:CollectionOfEvidence a owl:Class ;
    rdfs:label "Collection of evidence"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization should establish and implement procedures for the identification, collection, acquisition and preservation of evidence related to information security events."@en ;
    rdfs:subClassOf arkcscOWL:Corrective ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Defence,
        arkcscOWL:Detect,
        arkcscOWL:Information_security_event_management,
        arkcscOWL:Integerity,
        arkcscOWL:Respond .

arkcscOWL:ComplianceWithPoliciesRulesAndStandardsForInformationSecurity a owl:Class ;
    rdfs:label "Compliance with policies, rules and standards for information security"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Compliance with the organization’s information security policy, topic-specific policies, rules and standards should be regularly reviewed."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Governance_and_Ecosystem,
