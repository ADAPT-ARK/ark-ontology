        arkcscOWL:Information_security_assurance,
        arkcscOWL:Integerity,
        arkcscOWL:Legal_and_compliance,
        arkcscOWL:Protect .

arkcscOWL:ConfidentialityOrNon-disclosureAgreements a owl:Class ;
    rdfs:label "Confidentiality or non-disclosure agreements"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Confidentiality or non-disclosure agreements reflecting the organization’s needs for the protection of information should be identified, documented, regularly reviewed and signed by personnel and other relevant interested parties."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Asset_management,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Governance_and_Ecosystem,
        arkcscOWL:Human_resource_security,
        arkcscOWL:Information_protection,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Supplier_relationships .

arkcscOWL:ConfigurationManagement a owl:Class ;
    rdfs:label "Configuration management"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Configurations, including security configurations, of hardware, software, services and networks should be established, documented, implemented, monitored and reviewed."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection,
        arkcscOWL:Secure_configuration .

arkcscOWL:ContactWithAuthorities a owl:Class ;
    rdfs:label "Contact with authorities"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization should establish and maintain contact with relevant authorities."@en ;
    rdfs:subClassOf arkcscOWL:Corrective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
