arkcscOWL:IndependentReviewOfInformationSecurity a owl:Class ;
    rdfs:label "Independent review of information security"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization’s approach to managing information security and its implementation including people, processes and technologies should be reviewed independently at planned intervals, or when significant changes occur."@en ;
    rdfs:subClassOf arkcscOWL:Corrective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Governance_and_Ecosystem,
        arkcscOWL:Identify,
