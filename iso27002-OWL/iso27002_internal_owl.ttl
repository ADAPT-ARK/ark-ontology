    rdfs:label "Threat intelligence"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information relating to information security threats should be collected and analysed to produce threat intelligence."@en ;
    rdfs:subClassOf arkcscOWL:Corrective,
        arkcscOWL:Detective,
        arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Defence,
        arkcscOWL:Detect,
        arkcscOWL:Identigy,
        arkcscOWL:Integerity,
        arkcscOWL:Resillience,
        arkcscOWL:Respond,
        arkcscOWL:Threat_and_vulnerability_management .

arkcscOWL:UseOfCryptography a owl:Class ;
    rdfs:label "Use of cryptography"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Rules for the effective use of cryptography, including cryptographic key management, should be defined and implemented."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection,
        arkcscOWL:Secure_configuration .

arkcscOWL:UseOfPrivilegedUtilityPrograms a owl:Class ;
    rdfs:label "Use of privileged utility programs"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The use of utility programs that can be capable of overriding system and application controls should be restricted and tightly controlled."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Application_security,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection,
        arkcscOWL:Secure_configuration,
        arkcscOWL:System_and_network_security .

arkcscOWL:UserEndpointDevices a owl:Class ;
    rdfs:label "User endpoint devices"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information stored on, processed by or accessible via user endpoint devices should be protected."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
    arkc:hasRelatedConcept arkcscOWL:Asset_management,
        arkcscOWL:Availability,
        arkcscOWL:Confidentiality,
        arkcscOWL:Information_protection,
        arkcscOWL:Integerity,
        arkcscOWL:Protect,
        arkcscOWL:Protection .

arkcscOWL:WebFiltering a owl:Class ;
    rdfs:label "Web filtering"@en ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:created "2024-03-14"^^xsd:date ;
    dcterms:creator "ISO/IEC" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Access to external websites should be managed to reduce exposure to malicious content."@en ;
    rdfs:subClassOf arkcscOWL:Preventive ;
