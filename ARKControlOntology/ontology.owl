        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">the way the organisation oversees the control framework so that it operates effectively. The assurance provided is separate from those responsible for delivery, but not independent of the management chain, such as risk and compliance functions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Second line of defence</rdfs:label>
        <skos:definition xml:lang="en">the way the organisation oversees the control framework so that it operates effectively. The assurance provided is separate from those responsible for delivery, but not independent of the management chain, such as risk and compliance functions.</skos:definition>
        <skos:prefLabel xml:lang="en">Second line of defence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#TargetRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#TargetRisk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
