        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <rdfs:comment xml:lang="en">Administrative controls change the way work is done or give workers more information by providing workers with relevant procedures, training, or warnings. They’re often used together with higher-level controls.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/nioshControlOntology#"/>
        <rdfs:label xml:lang="en">Administrative Control</rdfs:label>
