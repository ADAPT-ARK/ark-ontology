        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Inherent risk in the HSE is the level of risk before consideration of control and/or action measures.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Inherent risk</rdfs:label>
        <skos:definition xml:lang="en">Inherent risk in the HSE is the level of risk before consideration of control and/or action measures.</skos:definition>
        <skos:prefLabel xml:lang="en">Inherent risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#InitialRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#InitialRisk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
