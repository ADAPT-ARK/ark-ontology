    <!-- https://openark.adaptcentre.ie/Ontologies/nioshControlOntology#PersonalProtectiveEquipment -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/nioshControlOntology#PersonalProtectiveEquipment">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/nioshControlOntology#NioshControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <rdfs:comment xml:lang="en">Personal protective equipment (PPE) includes clothing and devices to protect workers. PPE needs constant effort and attention (including proper use and training) from workers. Higher-level controls aren’t always feasible, and PPE might be needed in conjunction with other control measures. Least effective contols.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/nioshControlOntology#"/>
        <rdfs:label xml:lang="en">Personal protective equipment</rdfs:label>
        <skos:definition xml:lang="en">Personal protective equipment (PPE) includes clothing and devices to protect workers. PPE needs constant effort and attention (including proper use and training) from workers. Higher-level controls aren’t always feasible, and PPE might be needed in conjunction with other control measures. Least effective contols.</skos:definition>
        <skos:prefLabel xml:lang="en">Personal protective equipment</skos:prefLabel>
    </owl:Class>
    


