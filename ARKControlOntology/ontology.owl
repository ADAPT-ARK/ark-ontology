        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Reduce</rdfs:label>
        <skos:definition xml:lang="en">Reduce the risk with further actions.</skos:definition>
        <skos:prefLabel xml:lang="en">Reduce</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ResidualRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ResidualRisk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
