        <rdfs:label xml:lang="en">Risk treatment</rdfs:label>
        <skos:definition xml:lang="en">Risk treatment is the process to modify risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Risk treatment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#SecondLineOfDefence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#SecondLineOfDefence">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
