        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">in order to monitor the action one person must have lead responsibility.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Action owner</rdfs:label>
        <skos:definition xml:lang="en">in order to monitor the action one person must have lead responsibility.</skos:definition>
        <skos:prefLabel xml:lang="en">Action owner</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#AvoidOrTerminate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#AvoidOrTerminate">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Avoid/Terminate it completely e.g. do not proceed with the planned activity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Avoid/terminate</rdfs:label>
        <skos:definition xml:lang="en">Avoid/Terminate it completely e.g. do not proceed with the planned activity.</skos:definition>
        <skos:prefLabel xml:lang="en">Avoid/terminate</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ControlOwner -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ControlOwner">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">The Control Owner is the person responsible for performing the control. It is the responsibility of the Risk Owner to identify the Control Owner and set a future date to review the control as relevant to the risk to ensure that the control remains effective.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Control owner</rdfs:label>
        <skos:definition xml:lang="en">The Control Owner is the person responsible for performing the control. It is the responsibility of the Risk Owner to identify the Control Owner and set a future date to review the control as relevant to the risk to ensure that the control remains effective.</skos:definition>
        <skos:prefLabel xml:lang="en">Control owner</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#CorrectiveControl -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#CorrectiveControl">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ReactiveControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Corrective controls are designed to correct errors or undesirable events which have occurred and will prevent further occurrences.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Corrective control</rdfs:label>
        <skos:definition xml:lang="en">Corrective controls are designed to correct errors or undesirable events which have occurred and will prevent further occurrences.</skos:definition>
        <skos:prefLabel xml:lang="en">Corrective control</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#CurrentRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#CurrentRisk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Current risk</rdfs:label>
        <skos:definition xml:lang="en">Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed</skos:definition>
        <skos:prefLabel xml:lang="en">Current risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#DetectiveControl -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#DetectiveControl">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ReactiveControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Detective control</rdfs:label>
        <skos:definition xml:lang="en">Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken.</skos:definition>
        <skos:prefLabel xml:lang="en">Detective control</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#DirectiveControl -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#DirectiveControl">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ProactiveControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Directive control</rdfs:label>
        <skos:definition xml:lang="en">Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training.</skos:definition>
        <skos:prefLabel xml:lang="en">Directive control</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ExternalAssuranceProviders -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ExternalAssuranceProviders">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">assurance from external independent assurance providers such as Regulators.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">External Assurance providers</rdfs:label>
        <skos:definition xml:lang="en">assurance from external independent assurance providers such as Regulators.</skos:definition>
        <skos:prefLabel xml:lang="en">External Assurance providers</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#FirstLineOfDefence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#FirstLineOfDefence">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">the way risks are managed and controlled day-to-day. Assurance comes directly from those responsible for delivering specific objectives or processes. Its value comes from those who know the business, culture and day-to-day challenges.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">First line of defence</rdfs:label>
        <skos:definition xml:lang="en">the way risks are managed and controlled day-to-day. Assurance comes directly from those responsible for delivering specific objectives or processes. Its value comes from those who know the business, culture and day-to-day challenges.</skos:definition>
        <skos:prefLabel xml:lang="en">First line of defence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"/>
        <terms:contributor>Nick McDonald</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-08</terms:created>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Controls are measures that maintain and/or modify risk. In the HSE, a control is a measure that is in place, is working effectively and operating to reduce either the likelihood or impact of a risk.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">HSE ERM Control</rdfs:label>
        <skos:definition xml:lang="en">Controls are measures that maintain and/or modify risk. In the HSE, a control is a measure that is in place, is working effectively and operating to reduce either the likelihood or impact of a risk.</skos:definition>
        <skos:prefLabel xml:lang="en">HSE ERM Control</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#InherentRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#InherentRisk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
