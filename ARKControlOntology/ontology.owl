        <skos:prefLabel xml:lang="en">Third line of defence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#TransferRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#TransferRisk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Transfer the risk e.g. to an identified individual or unit, that has been communicated to and notified, where many of the actions identified as required to mitigate are better managed and are within their span of control.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Transfer the risk</rdfs:label>
        <skos:definition xml:lang="en">Transfer the risk e.g. to an identified individual or unit, that has been communicated to and notified, where many of the actions identified as required to mitigate are better managed and are within their span of control.</skos:definition>
        <skos:prefLabel xml:lang="en">Transfer the risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#TreatementPlan -->


