        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:comment xml:lang="en">Reactive controlsfocus on what happens after the risk occurs or which identify weaknesses in our current controls</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"/>
        <rdfs:label xml:lang="en">Reactive control</rdfs:label>
        <skos:definition xml:lang="en">Reactive controlsfocus on what happens after the risk occurs or which identify weaknesses in our current controls</skos:definition>
        <skos:prefLabel xml:lang="en">Reactive control</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#Reduce -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#Reduce">
