     xmlns:ARKCube="https://openark.adaptcentre.ie/Ontologies/ARKCube#">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology#"/>
        <dc:title xml:lang="en">ARK Controls Ontology</dc:title>
        <terms:abstract xml:lang="en">This ontology defines sets of Control classes and their hierachies, taken from the ISO27002 document, HSE documents, that are used on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO controls.</terms:abstract>
        <terms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:description xml:lang="en">This ontology defines sets of Control classes and their hierachies, taken from the ISO27002 document, HSE documents, that are used on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO controls.</terms:description>
        <terms:format>text/turtle</terms:format>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-24</terms:modified>
        <terms:publisher rdf:resource="https://openark.adaptcentre.ie"/>
        <terms:rights rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology#RightsStatement"/>
        <terms:source>ISO 27002:2022(E), https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/, https://www.cdc.gov/niosh/learning/safetyculturehc/module-3/2.html</terms:source>
        <bibo:status rdf:resource="http://purl.org/ontology/bibo/status/draft"/>
        <vann:preferredNamespacePrefix>arkctl</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology#"/>
        <schema:codeRepository rdf:resource="https://gogs.adaptcentre.ie/ARK/Ontologies/src/master/ARKControlOntology"/>
        <schema:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment xml:lang="en">This ontology defines sets of Control classes and their hierachies, taken from the ISO27002 document, HSE documents, that are used on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO controls.</rdfs:comment>
        <owl:versionInfo>0.1</owl:versionInfo>
        <ns:status rdf:resource="http://www.w3.org/2003/06/sw-vocab-status/ns#unstable"/>
        <dcat:accessURL rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology/ontology.ttl"/>
        <dcat:byteSize>450KB</dcat:byteSize>
        <dcat:downloadURL rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology/ontology.ttl"/>
        <vocab:introduction xml:lang="en">This ontology defines sets of Control classes and their hierachies, taken from the ISO27002 document, HSE documents, that are used on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO controls.</vocab:introduction>
        <vocab:rdfxmlSerialization rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology/ontology.ttl"/>
    </owl:Ontology>
    


