                                                                                <http://purl.org/dc/terms/source> <https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/> ;
                                                                                rdfs:comment "Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed"@en ;
                                                                                rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#> ;
                                                                                rdfs:label "Current risk"@en ;
                                                                                <http://www.w3.org/2004/02/skos/core#definition> "Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed"@en ;
                                                                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Current risk"@en .


###  https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DetectiveControl
<https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DetectiveControl> rdf:type owl:Class ;
                                                                                     rdfs:subClassOf <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControl> ;
                                                                                     <http://purl.org/dc/terms/created> "2024-05-15"^^xsd:date ;
                                                                                     <http://purl.org/dc/terms/creator> "Nick McDonald" ;
                                                                                     <http://purl.org/dc/terms/source> <https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/> ;
                                                                                     rdfs:comment "Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken."@en ;
                                                                                     rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#> ;
                                                                                     rdfs:label "Detective control"@en ;
                                                                                     <http://www.w3.org/2004/02/skos/core#definition> "Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken."@en ;
                                                                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Detective control"@en .


###  https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DirectiveControl
<https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DirectiveControl> rdf:type owl:Class ;
                                                                                     rdfs:subClassOf <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControl> ;
                                                                                     <http://purl.org/dc/terms/created> "2024-05-15"^^xsd:date ;
                                                                                     <http://purl.org/dc/terms/creator> "Nick McDonald" ;
                                                                                     <http://purl.org/dc/terms/source> <https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/> ;
                                                                                     rdfs:comment "Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training."@en ;
                                                                                     rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#> ;
                                                                                     rdfs:label "Directive control"@en ;
                                                                                     <http://www.w3.org/2004/02/skos/core#definition> "Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training."@en ;
                                                                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Directive control"@en .


###  https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ExternalAssuranceProviders
<https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ExternalAssuranceProviders> rdf:type owl:Class ;
