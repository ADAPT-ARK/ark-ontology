                                                                                        rdfs:comment "Preventative controls are controls designed to stop, discourage, pre-empt or limit the possibility of an undesirable event before it occurs."@en ;
                                                                                        rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#> ;
