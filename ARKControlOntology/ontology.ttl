###  https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Action
<https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Action> rdf:type owl:Class ;
                                                                           rdfs:subClassOf <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Control> ;
                                                                           <http://purl.org/dc/terms/created> "2024-05-15"^^xsd:date ;
                                                                           <http://purl.org/dc/terms/creator> "Nick McDonald" ;
                                                                           <http://purl.org/dc/terms/source> <https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/> ;
                                                                           rdfs:comment "Actions are a future measure that will maintain and/or modify a risk. In the HSE, an action is a future measure to further reduce either the likelihood or impact of a risk."@en ;
                                                                           rdfs:isDefinedBy <https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#> ;
                                                                           rdfs:label "Action"@en ;
