}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ControlOwner",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Control Owner is the person responsible for performing the control. It is the responsibility of the Risk Owner to identify the Control Owner and set a future date to review the control as relevant to the risk to ensure that the control remains effective."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Control owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Control Owner is the person responsible for performing the control. It is the responsibility of the Risk Owner to identify the Control Owner and set a future date to review the control as relevant to the risk to ensure that the control remains effective."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Control owner"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#CorrectiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Corrective controls are designed to correct errors or undesirable events which have occurred and will prevent further occurrences."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Corrective control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ReactiveControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Corrective controls are designed to correct errors or undesirable events which have occurred and will prevent further occurrences."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Corrective control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#CurrentRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Current risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Current risk"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#DetectiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Detective control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ReactiveControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Detective control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#DirectiveControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Directive control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ProactiveControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Directive control"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#ExternalAssuranceProviders",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "assurance from external independent assurance providers such as Regulators."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
