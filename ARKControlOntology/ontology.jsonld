  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "assurance from external independent assurance providers such as Regulators."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "External Assurance providers"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#FirstLineOfDefence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "the way risks are managed and controlled day-to-day. Assurance comes directly from those responsible for delivering specific objectives or processes. Its value comes from those who know the business, culture and day-to-day challenges."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "First line of defence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "the way risks are managed and controlled day-to-day. Assurance comes directly from those responsible for delivering specific objectives or processes. Its value comes from those who know the business, culture and day-to-day challenges."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "First line of defence"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#HseControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Nick McDonald"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-05-08"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Controls are measures that maintain and/or modify risk. In the HSE, a control is a measure that is in place, is working effectively and operating to reduce either the likelihood or impact of a risk."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/hseErmControlOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "HSE ERM Control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Controls are measures that maintain and/or modify risk. In the HSE, a control is a measure that is in place, is working effectively and operating to reduce either the likelihood or impact of a risk."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "HSE ERM Control"
  } ]
