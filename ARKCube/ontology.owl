        <rdfs:label xml:lang="en">Business Continuity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#catastrophicSeverityAerLingus -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#catastrophicSeverityAerLingus">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityAerLingus"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T17:23:12+00:00</dc:date>
        <rdfs:comment xml:lang="en">Plain: Fatalities or destruction of equipment / loss of aircraft. Qualified (Injury): Fatal. Qualified (Damage): Complete destruction of equipment, grounding of operation. Qualified (ICAO): Total loss or hull loss. Qualified (Operational Impact): Prolonged fleet grounding. Organisational Impact: Change in public perception of Airline&apos;s reputation.</rdfs:comment>
        <rdfs:label xml:lang="en">Catastrophic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#catastrophicSeverityDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#catastrophicSeverityDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityDFB"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Death or multiple irreversible injuries.</rdfs:comment>
        <rdfs:label xml:lang="en">Catastrophic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#closed -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#closed">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus"/>
        <rdfs:comment xml:lang="en">Closed, i.e. that the risk no longer exists e.g. where an unsuitable premises is replaced by a suitable one.</rdfs:comment>
        <rdfs:label xml:lang="en">Closed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#closedApproval -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#closedApproval">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ApprovalStatus"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-03T14:12:27+00:00</dc:date>
        <rdfs:label xml:lang="en">Closed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#compliance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#compliance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks associated with compliance with requirements in relation to the standards set out in relation  to  the  organisation  and  delivery  of  high  quality  services i.e. Statutory, Clinical, Professional and Management Standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#environment -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#environment">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks which threaten the prevention, limitation, elimination, abatement or reduction of environmental   pollution and the preservation of a quality environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEAdversePublicityReputation -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEAdversePublicityReputation">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">National/International media/adverse publicity, &gt; than 3 days. Editorial follows days of news stories &amp; features in National papers.Public confidence in the organisation undermined.HSE use of resources questioned. CEO’s performance questioned. Calls for individual HSE officials to be sanctioned. Taoiseach/Minister forced to comment or intervene. Questions in the Dáil. Public calls (at national level) for specific remedial actions to be taken. Court action. Public (independent) Inquiry.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Adverse Publicity/Reputation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEBusinessContinuity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEBusinessContinuity">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Permanent loss of core service or facility. Disruption to facility leading to significant ‘knock on’ effect.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Business Continuity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSECompliance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSECompliance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Gross failure to meet external standards. Repeated failure to meet national norms and standards/regulations. Severely critical report with possible major reputational or financial implications.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Compliance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEEnvironment -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEEnvironment">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Toxic release affecting off-site with detrimental effect requiring outside assistance.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEFinance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEFinance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">&gt;2.0% budget deficit.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Finance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEHarmToAPerson -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEHarmToAPerson">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Incident leading to death or major permanent incapacity. Event which impacts on large number of service users or member of the public. Permanent psychosocial functioning incapacity.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Harm to a Person</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEObjectivesProjects -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEObjectivesProjects">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Inability to meet project objectives. Reputation of the organisation seriously damaged.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Objectives/Projects</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEServiceUserExperience -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHSEServiceUserExperience">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Totally unsatisfactory service user outcome resulting in long term effects, or extremely poor experience of care provision.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Service User Experience</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremelyImprobableAerLingus -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremelyImprobableAerLingus">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodAerLingus"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0E-6</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:22:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Plain: Unlikely to occur. Qualified (Calendar): No event in more than 10 years. Qualified (Context): Has occurred in industry but not in Aer Lingus. Qualified (per flight): Less than 1 out of 750,000 flights. Probability: &gt;2 x 10^(minus 6).</rdfs:comment>
        <rdfs:label xml:lang="en">Extremely Improbable</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremelyRemoteAerLingus -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremelyRemoteAerLingus">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodAerLingus"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0E-5</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:22:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Plain: Not llikely to, but could, occur. Qualified (Calendar): More than twice a year. Qualified (Context): Sporadic occurrence in Aer Lingus. Qualified (per flight): 1 out of 35,000 flights. Probability: &gt;3 x 10^(minus 5).</rdfs:comment>
        <rdfs:label xml:lang="en">Extremely Remote</rdfs:label>
    </owl:NamedIndividual>
    


