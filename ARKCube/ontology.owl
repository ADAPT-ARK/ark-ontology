    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#minorImpactHSEServiceUserExperience -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#minorImpactHSEServiceUserExperience">
