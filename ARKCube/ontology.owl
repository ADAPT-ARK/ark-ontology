    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#derivedFromProject -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#derivedFromProject">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:subPropertyOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRelatedProject"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-02-01T18:16:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a project to the project from which it was derived. A derivation is a transformation of a project into another, an update of a project resulting in a new one, or the construction of a new project based on a pre-existing project.</rdfs:comment>
        <rdfs:label xml:lang="en">derived from project</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#describesStage -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#describesStage">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Report"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Stage"/>
        <dc:creator xml:lang="en">yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T17:06:09+00:00</dc:date>
        <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-08-07 7:00:00</dc:modified>
        <rdfs:comment xml:lang="en">Links a Project Analysis to a particular Stage of a Project. Also links a Handover Report to its associated stages.</rdfs:comment>
        <rdfs:label xml:lang="en">describes stage</rdfs:label>
    </owl:ObjectProperty>
    


