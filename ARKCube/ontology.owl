    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#almostCertainDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#almostCertainDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodDFB"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.95</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Inadequate health and safety controls, an accident will occur. Probability 90-100%.</rdfs:comment>
        <rdfs:label xml:lang="en">Almost Certain</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#almostCertainHSE -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#almostCertainHSE">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodHSE"/>
        <actualFrequency>At least monthly</actualFrequency>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.99</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</score>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Probability: 99%. Actual Frequency: At least monthly.</rdfs:comment>
        <rdfs:label xml:lang="en">Almost Certain</rdfs:label>
    </owl:NamedIndividual>
    


