    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#minorImpactHSEHarmToAPerson -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#minorImpactHSEHarmToAPerson">
