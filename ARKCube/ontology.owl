        <rdfs:label xml:lang="en">has revision</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRisk -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRisk">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk Assessment Record, a Project, a Project Analysis or a Stage to a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskAssessmentRecord -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskAssessmentRecord">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRegister"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-04-15T22:46:04+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk Register to a Risk Assessment Record.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk assessment record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskAssessor -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskAssessor">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-05-04T21:23:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The person(s) who completed the risk assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk assessor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskColour -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskColour">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a risk class with a specific colour.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk colour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskContext -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskContext">
        <rdfs:subPropertyOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasContext"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskContext"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-Oct-05T15:08:54+00:00</dc:date>
        <rdfs:comment xml:lang="en">Specialised sub-property of hasContext used for linking a RiskDescription with a RiskContext.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskCoordinator -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskCoordinator">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The role of the Risk Coordinator is to assist with the initial assessment of the risk by providing expertise on the subject matter of the risk being assessed and following this to assist with its ongoing review and monitoring.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk coordinator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskDescription -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskDescription">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk to its description. When describing risk it is important to describe the risk using the ‘ICC’  (impact, cause, context) approach. Describe the potential ‘IMPACT’ if the risk were materialised. Describe the ‘CAUSAL FACTORS’ that could result in the risk materialising. Ensure that the ‘CONTEXT’ of the risk is clear, e.g. is the risk ‘target’ well defined (e.g. staff, service user), department, hospital etc.) and the ‘nature’ of the risk clear (e.g. financial, safety, physical loss, perception, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has risk description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskInChange -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskInChange">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskImplementationAssessment"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Project Analysis in Implement Stage to Risk</rdfs:comment>
        <rdfs:label xml:lang="en">has risk in change</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskOwner -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskOwner">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">All risks require assignment of a Risk Owner and it is the responsibility of the Risk Owner to ensure that the risk is assessed and managed in line with organisational policy. This includes ensuring that any actions identified as required to manage the risk have been assigned to an Action Owner along with an agreed date for completion of the action. The Risk Owner is normally the Manager of the area/service in which the risk is identified. It is the responsibility of the Risk Owner to notify risks or actions where appropriate. This is the individual who will be held accountable for the risk and its effective control.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk owner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskRating -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskRating">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk to its Risk Rating. Multiplying the inherent Impact Severity by the Likelihood will give the risk rating.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskStatus -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskStatus">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk to its current status: ‘Open’, ‘Monitor’ or ‘Closed’. Open, i.e. additional controls have been identified as necessary. Monitor, i.e. existing controls are deemed adequate to manage the risk but these need to be periodically reviewed. Closed, i.e. that the risk no longer exists e.g. where an unsuitable premises is replaced by a suitable one.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskType -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskType">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#StandardRiskAssessmentRecord"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskType"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10 14:37:53</dc:date>
        <rdfs:comment xml:lang="en">Links a risk to the specific type of risk being assessed.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSiteService -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSiteService">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#StandardRiskAssessmentRecord"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk Assessment to an organisation or a hospital site/service.</rdfs:comment>
        <rdfs:label xml:lang="en">has hospital site/service</rdfs:label>
        <rdfs:label xml:lang="en">has site/service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSubProject -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSubProject">
        <rdfs:subPropertyOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRelatedProject"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:comment xml:lang="en">Links a parent project to a child project. A Project can have one or more subprojects.</rdfs:comment>
        <rdfs:label xml:lang="en">has subproject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSubquestion -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSubquestion">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Question"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Question"/>
        <dc:creator xml:lang="en">yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-27T16:16:56+00:00</dc:date>
        <rdfs:comment xml:lang="en">Represents and links the subquestion of a question</rdfs:comment>
        <rdfs:label xml:lang="en">has subquestion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSuperProject -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSuperProject">
        <rdfs:subPropertyOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRelatedProject"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-15T18:16:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a child project to its parent project.</rdfs:comment>
        <rdfs:label xml:lang="en">has superproject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSustainability -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasSustainability">
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Sustainability"/>
