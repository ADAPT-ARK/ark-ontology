        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">No likelihood specified.</rdfs:comment>
        <rdfs:label xml:lang="en">Unspecified Likelihood</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#UnspecifiedSeverity -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#UnspecifiedSeverity">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T17:02:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">No severity rating specified.</rdfs:comment>
        <rdfs:label xml:lang="en">Unspecified Severity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#VerifyEmbedStage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#VerifyEmbedStage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:26:37+00:00</dc:date>
        <rdfs:comment xml:lang="en">Verification determines whether or not the outcomes of a project fulfil the requirements established during the Solution Stage, taking into account the quality of planning and implementation. Embedding implies that a particular feature has become a permanent and noticeable feature of the system or organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Verify and Embed Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Viability -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Viability">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>The extent to which the plan is able to work as intended and succeed in achieving its objectives.</dc:description>
        <rdfs:label xml:lang="en">Viability</rdfs:label>
    </owl:Class>
    


