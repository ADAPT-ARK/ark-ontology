    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Activity -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Activity">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:29:07+00:00</dc:date>
        <rdfs:comment xml:lang="en">The condition in which things are happening or being done. Activity refers to the measurable activity within the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Answer -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Answer">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:29:27+00:00</dc:date>
        <rdfs:comment xml:lang="en">A written account in response to a question asked.</rdfs:comment>
        <rdfs:label xml:lang="en">Answer</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ApprovalStatus -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ApprovalStatus">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-03T15:00:27+00:00</dc:date>
        <rdfs:comment xml:lang="en">The approval status of a risk assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Approval Status</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Artefact -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Artefact">
        <dc:creator xml:lang="en">Ademar</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-20 14:31:51</dc:date>
        <rdfs:comment xml:lang="en">Artefacts are associated to an evidence collection. An artefact may be, for example, a dataset containing information relevant to an answer.</rdfs:comment>
        <rdfs:label xml:lang="en">Artefact</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:26:56+00:00</dc:date>
        <rdfs:comment xml:lang="en">Aspect of Reality is a dimension which explores the Functional System, Activity, Sensemaking and Culture across four System Dimensions: Goals, Process, Social, and Knowledge and Information.</rdfs:comment>
        <rdfs:label xml:lang="en">Aspect of Reality</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Cause -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Cause">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The cause of a risk. Something that brings about an effect. Used for a risk description in ICC (impact, cause, context) format.</rdfs:comment>
        <rdfs:label xml:lang="en">Cause</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Context -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Context">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-28T16:34:24+00:00</dc:date>
        <rdfs:comment xml:lang="en">To establish the context means to define the external and internal parameters that organizations must consider when they manage risk. 
An organization’s external context includes its external stakeholders, its local, national, and international environment, as well as any external factors that influence its objectives. An organization’s internal context includes its internal stakeholders, its approach to governance, its contractual relationships, and its capabilities, culture, and standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Context</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Control -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Control">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Any measure or action that modifies or regulates risk. Controls include any policy, procedure, practice, process, technology, technique, method,  or device that modifies or regulates risk. They can exist or be required as additional in order to further mitigate the risk. Risk treatments become controls, or modify existing controls, once they are implemented. A mechanism, process, procedure or action which can be verified, that seeks to reduce the likelihood and/or consequence of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Control</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Culture -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Culture">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:29:07+00:00</dc:date>
        <rdfs:comment xml:lang="en">A set of collective attitudes, values, goals and practices that characterize a community or system</rdfs:comment>
        <rdfs:label xml:lang="en">Culture</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Deliverable -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Deliverable">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The output of an action.</rdfs:comment>
        <rdfs:label xml:lang="en">Deliverable</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Delivery -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Delivery">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-02-08T15:43:16+00:00</dc:date>
        <rdfs:comment xml:lang="en">The extent to which plans and improvements have been delivered and are performing consistently.</rdfs:comment>
        <rdfs:label xml:lang="en">Delivery</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#DevelopStage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#DevelopStage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:26:37+00:00</dc:date>
        <rdfs:comment xml:lang="en">A develop stage question is a Cube question which is asked at the development stage of the Cube questionnaire.</rdfs:comment>
        <rdfs:label xml:lang="en">Develop Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Efficacy -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Efficacy">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>The extent to which the solution or improvement can overcome the problem and produce the required result.</dc:description>
        <rdfs:label xml:lang="en">Efficacy</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Evidence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Evidence">
        <dc:contributor>Ademar</dc:contributor>
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-18T13:05:52+00:00</dc:date>
        <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-20 14:31:51</dc:modified>
        <rdfs:comment xml:lang="en">Evidence is composed of artefacts and are associated with an answer.</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#EvidenceReport -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#EvidenceReport">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-14T10:14:32+00:00</dc:date>
        <rdfs:comment xml:lang="en">A report on the evidence linked to a project.</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence Report</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#EvidenceReportTemplate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#EvidenceReportTemplate">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-15T11:38:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A format template for an evidence report.</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence Report Template</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpactHSE">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Uses HSE primary impact table for definition.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#FinalReport -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#FinalReport">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-14T10:09:32+00:00</dc:date>
        <rdfs:comment xml:lang="en">A report that summarises a completed project.</rdfs:comment>
        <rdfs:label xml:lang="en">Final Report</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#FinalReportTemplate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#FinalReportTemplate">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-15T11:38:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A format template for a final report.</rdfs:comment>
        <rdfs:label xml:lang="en">Final Report Template</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#FunctionalSystem -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#FunctionalSystem">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:29:07+00:00</dc:date>
        <rdfs:comment xml:lang="en">The Functional System refers to the basic causal structure of the system and the relationships that produce outcomes.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional System</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#GainAchieved -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#GainAchieved">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE solution stage.</dc:description>
        <rdfs:label xml:lang="en">Gain Achieved</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Goal -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Goal">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:27:46+00:00</dc:date>
        <rdfs:comment xml:lang="en">An aim or desired outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">Goal</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#HandoverReport -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#HandoverReport">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-14T10:15:32+00:00</dc:date>
        <rdfs:comment xml:lang="en">A report for handing over a project from one stage to another.</rdfs:comment>
        <rdfs:label xml:lang="en">Handover Report</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#HandoverReportTemplate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#HandoverReportTemplate">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-15T11:38:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A format template for a handover report.</rdfs:comment>
        <rdfs:label xml:lang="en">Handover Report Template</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Impact -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Impact">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The impact of a Risk. The powerful effect that something has on somebody/something. The outcome or consequence of an event affecting objectives. It can be expressed either qualitatively or quantitatively, being a loss, disadvantage or gain. There may be a range of possible outcomes associated with an event. Used for risk description following the ICC (impact, cause, context) approach.</rdfs:comment>
        <rdfs:label xml:lang="en">Impact</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The primary area impacted by a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Primary Impact Category</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactHSE">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:59:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risk impact scoring based on the HSE Risk Assessment Tool.</rdfs:comment>
        <rdfs:label xml:lang="en">Impact (HSE)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactSeverity -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactSeverity">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:59:21+00:00</dc:date>
        <rdfs:label xml:lang="en">Impact Severity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ImplementStage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImplementStage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:26:37+00:00</dc:date>
        <rdfs:comment xml:lang="en">Implementation is the execution of a plan. To monitor implementation is to supervise and to continually check and critically observe; to determine the current status and to assess whether required or expected performance levels are being achieved; and to adjust the activity as required.</rdfs:comment>
        <rdfs:label xml:lang="en">Implement Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Importance -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Importance">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>The extent to which the problem is deserving of serious attention because it has great (actual or potential) effects on people or things, or great value is at stake.</dc:description>
        <rdfs:label xml:lang="en">Importance</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#InformationKnowledge -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#InformationKnowledge">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:27:46+00:00</dc:date>
        <rdfs:comment xml:lang="en">Knowledge gained through communication, research, instruction. Familiarity gained by personal experience, vicariously or through collective processes</rdfs:comment>
        <rdfs:label xml:lang="en">Information and Knowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Likelihood -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Likelihood">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The chance of something happening (also described as the probability or frequency of an event occurring).</rdfs:comment>
        <rdfs:label xml:lang="en">Likelihood</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodAerLingus -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodAerLingus">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:22:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The probability that an unsafe event or condition might occur. Likelihood scoring based on the Aer Lingus risk matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">Likelihood (Aer Lingus)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodDFB -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodDFB">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T16:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Likelihood scoring based on the DFB risk matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">Likelihood (DFB)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodHSE">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T16:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Likelihood scoring based on the HSE Risk Assessment Tool.</rdfs:comment>
        <rdfs:label xml:lang="en">Likelihood (HSE)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#LossOrGain -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#LossOrGain">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>CUBE risk analysis factor</dc:description>
        <rdfs:label xml:lang="en">Loss or Gain</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#MajorImpactHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#MajorImpactHSE">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defined by HSE primary impact table.</rdfs:comment>
        <rdfs:label xml:lang="en">Major</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Mechanism -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Mechanism">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-28T16:34:31+00:00</dc:date>
        <rdfs:comment xml:lang="en">The way in which something is transformed, produced, circulated. A mechanism is a device that transforms input forces and movement into a desired set of output forces and movement. Underlying entities, processes, or (social) structures which operate in particular contexts to generate outcomes of interest.</rdfs:comment>
        <rdfs:label xml:lang="en">Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#MinorImpactHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#MinorImpactHSE">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defined by HSE primary impact table.</rdfs:comment>
        <rdfs:label xml:lang="en">Minor</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpactHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpactHSE">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defined by HSE primary impact table.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29 9:09:10</dc:date>
        <rdfs:comment xml:lang="en">Uses HSE primary impact table definition.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ObligationToActRating -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ObligationToActRating">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-02-08T15:43:16+00:00</dc:date>
        <rdfs:comment xml:lang="en">Used in the CUBE project analysis process to assign a weight or priority to the obligation to act generated at a specific project stage.</rdfs:comment>
        <rdfs:label xml:lang="en">Obligation to Act Rating</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10T10:21:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A group of people who work together in an organized way for a shared purpose e.g., a hospital, a clinic or a service. An organization can be part of or contain other organisations.</rdfs:comment>
        <rdfs:label xml:lang="en">Organisation</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#OrganisationalUnit -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#OrganisationalUnit">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29t09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">A unit that part of an Organisation, e.g., a ward, department, branch or statutory body,  and that only has full recognition within the context of that Organisation. In particular the unit would not be regarded as a legal entity in its own right.</rdfs:comment>
        <rdfs:label xml:lang="en">Organisational Unit</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Outcome -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Outcome">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-28T16:34:39+00:00</dc:date>
        <rdfs:comment xml:lang="en">The end product of a purposive activity. Outcomes can be either intended or unintended, can be proximal, intermediate or final, and result from the activation of different mechanisms in different contexts.</rdfs:comment>
        <rdfs:label xml:lang="en">Outcome</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Person -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defines a person, for example in an organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#PlanPrepareStage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#PlanPrepareStage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:26:37+00:00</dc:date>
        <rdfs:comment xml:lang="en">Identifies the diverse activities required to achieve a desired goal and represent these in a plan. Prepares for the implementation of the plan.</rdfs:comment>
        <rdfs:label xml:lang="en">Plan and Prepare Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Post -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Post">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10T11:38:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A position held by a Person within an organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Post</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#PotentialLoss -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#PotentialLoss">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>CUBE Problem Stage. Loss is the fact of no longer having something or having less of it than before.</dc:description>
        <rdfs:label xml:lang="en">Potential Loss</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Priority -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Priority">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-19T16:20:56+00:00</dc:date>
        <rdfs:comment xml:lang="en">The significance of an item (compared to all the Cube dimensions) in contributing to defining the context, identifying key mechanisms or describing critical outcomes, in a particular phase of an ARK Project.</rdfs:comment>
        <rdfs:label xml:lang="en">Priority</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProblemStage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProblemStage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:22:54+00:00</dc:date>
        <rdfs:comment xml:lang="en">Describes the ‘as-is’ situation and identifies aspects which may not be working as well as they could be, leading to potential damage, harm or other unwanted outcomes. Describes the relevant dimensions of the problem space.</rdfs:comment>
        <rdfs:label xml:lang="en">Problem Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProcessSequence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProcessSequence">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:27:46+00:00</dc:date>
        <rdfs:comment xml:lang="en">The key activity of the operation; a sequence of activities and stages through which an initial state is transformed into the final state</rdfs:comment>
        <rdfs:label xml:lang="en">Process/Sequence</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Project -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project">
        <rdfs:comment xml:lang="en">An individual or collaborative enterprise that is carefully planned to achieve a particular aim.</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-12T16:28:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">In the CUBE methodology this is an assessment of:
    Risk (or Operational risk) in the problem stage.
    (Potential) mitigation of risk in the solution stage.
    (Potential) Risk in Change in the planning stage.
    Risk in Implementation (actual risk in change) / Implementation risk in the implementation stage.
    Residual risk (verified following implementation) in the verify stage.</rdfs:comment>
        <rdfs:comment xml:lang="en">Project analysis is a high-level ark project analysis used to identify values, loss, efficacy etc</rdfs:comment>
        <rdfs:label xml:lang="en">Project Analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectDescription -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectDescription">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-14T20:53:04+00:00</dc:date>
        <rdfs:comment xml:lang="en">A description of a Project.</rdfs:comment>
        <rdfs:label xml:lang="en">Project Description</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedGain -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedGain">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE solution stage.</dc:description>
        <rdfs:label xml:lang="en">Projected Gain</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedReliabilityOfGain -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedReliabilityOfGain">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE plan stage.</dc:description>
        <rdfs:label xml:lang="en">Projected Reliability of Gain</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedRiskRating -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedRiskRating">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <rdfs:label xml:lang="en">Projected Risk Rating</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Question -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Question">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:20:23+00:00</dc:date>
        <rdfs:comment xml:lang="en">A question is an expression used to request information about a specific topic. A question may be asked in various forms and may seek different kinds of answers.</rdfs:comment>
        <rdfs:label xml:lang="en">Question</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Questionnaire -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Questionnaire">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T14:18:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">A set of structured questions which seek information on a topic of interest from respndents.</rdfs:comment>
        <rdfs:label xml:lang="en">Questionnaire</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ReliabilityOfGain -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ReliabilityOfGain">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE implement  stage.</dc:description>
        <rdfs:label xml:lang="en">Reliability of Gain</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Report -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Report">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-18T13:07:08+00:00</dc:date>
        <rdfs:comment xml:lang="en">A written account of an activity or investigation.</rdfs:comment>
        <rdfs:label xml:lang="en">Report</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ReportTemplate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ReportTemplate">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-15T11:38:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A report format template.</rdfs:comment>
        <rdfs:label xml:lang="en">Report Template</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risk is the effect of uncertainty on objectives. It is measured in terms of consequences and likelihood. In the context of the HSE and its services, it is any condition or circumstance which may impact on the achievement of objectives and/or have a significant impact on the day-to-day operations. This includes failing to maximise any opportunity that would help the HSE or service meet its objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessment -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessment">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE problem stage.</dc:description>
        <rdfs:label xml:lang="en">Risk Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Used to collect risk information from a risk assessment, for example in a risk register.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Assessment Record (Form)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordAerLingus -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordAerLingus">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-08T09:09:10+00:00</dc:date>
        <rdfs:label xml:lang="en">Risk Assessment Record Aer Lingus</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordDFB -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordDFB">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-08T09:09:10+00:00</dc:date>
        <rdfs:label xml:lang="en">Risk Assessment Record DFB</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordHSE -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordHSE">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-08T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Used to collect risk information from a risk assessment, for example in a risk register. Supports HSE risk assessment form fields.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Assessment Record HSE</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordSJH -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecordSJH">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-08T09:09:10+00:00</dc:date>
        <rdfs:label xml:lang="en">Risk Assessment Record SJH</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskContext -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskContext">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <rdfs:comment xml:lang="en">Establishing the context means to define the external and internal factors that the HSE and its services must consider when they manage risk. Used for risk description in ICC (impact, cause, context) format. Used to relate HSE concept of the context of a risk to CUBE concept of context.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Context</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription">
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Desribes a risk in ICC (Impact, Cause, Context) format.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Description</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskImplementationAssessment -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskImplementationAssessment">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE plan stage.</dc:description>
        <rdfs:label xml:lang="en">Risk Implementation Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskInChangeAssessment -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskInChangeAssessment">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE plan stage.</dc:description>
        <rdfs:label xml:lang="en">Risk in Change Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskMitigation -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskMitigation">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE solution stage.</dc:description>
        <rdfs:label xml:lang="en">Risk Mitigation</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The estimated level of risk taking into consideration the existing controls in place. Defined by cross-referencing the impact severity and likelihood in the risk matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Rating</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRegister -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRegister">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-04-14T14:39:36+00:00</dc:date>
        <rdfs:comment xml:lang="en">A grouping of Risk Assessment Records (Forms).</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Register</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Used to record the status of a risk: ‘Open’, ‘Monitor’ or ‘Closed’. Open, i.e. additional controls have been identified as necessary. Monitor, i.e. existing controls are deemed adequate to manage the risk but these need to be periodically reviewed. Closed, i.e. that the risk no longer exists e.g. where an unsuitable premises is replaced by a suitable one.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Status</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskType -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskType">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10T14:41:26+00:00</dc:date>
        <rdfs:comment xml:lang="en">The type of risk being assessed in a risk assessment form.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Type</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskTypeSJH -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskTypeSJH">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-08T09:09:10+00:00</dc:date>
        <rdfs:label xml:lang="en">Risk Type SJH</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskVerificationAssessment -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskVerificationAssessment">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-18T13:34:27+00:00</dc:date>
        <dc:description>Identfied during the CUBE plan stage.</dc:description>
        <rdfs:label xml:lang="en">Risk Verification Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#SenseMaking -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#SenseMaking">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:29:07+00:00</dc:date>
        <rdfs:comment xml:lang="en">Sensemaking focuses on the different ways people understand the situation they are in and how they respond to it, while Culture represents the shared values, norms, expectations of various parties in the organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensemaking</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Severity -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Severity">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T17:17:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The extent of the damage to the institution, its people, and its goals and objectives resulting from a risk event occurring.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityAerLingus -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityAerLingus">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T17:17:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Possible consequences of an unsafe event or condition, taking as reference the worst foreseeable situation. Severity scoring based on the Aer Lingus risk matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity (Aer Lingus)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityDFB -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityDFB">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Severity scoring based on the DFB risk matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity (DFB)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Social -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Social">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:27:46+00:00</dc:date>
        <rdfs:comment xml:lang="en">Dimension relating to a community or its organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Social</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#SolutionStage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#SolutionStage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:26:37+00:00</dc:date>
        <rdfs:comment xml:lang="en">Describes a potential ‘to-be’ situation in which the problem dimensions are addressed with an effective solution or improvement. Identifies control measures that can prevent unwanted outcomes.</rdfs:comment>
        <rdfs:label xml:lang="en">Solution Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Stage -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Stage">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:21:31+00:00</dc:date>
        <rdfs:comment xml:lang="en">A stage is the stage on the cube questionnaire.</rdfs:comment>
        <rdfs:label xml:lang="en">Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#StandardRiskAssessmentRecord -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#StandardRiskAssessmentRecord">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-08T09:09:10+00:00</dc:date>
        <rdfs:label xml:lang="en">Standard Risk Assessment Record</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#StatusReport -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#StatusReport">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">A report that provides an update on the status of a project.</rdfs:comment>
        <rdfs:label xml:lang="en">Status Report</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#StatusReportTemplate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#StatusReportTemplate">
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">A template for a status report.</rdfs:comment>
        <rdfs:label xml:lang="en">Status Report Template</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Sustainability -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Sustainability">
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-02-08T15:43:16+00:00</dc:date>
        <rdfs:comment xml:lang="en">The extent to which the elements of the plan are being implemented in a way that sustains the expected performance level.</rdfs:comment>
        <rdfs:label xml:lang="en">Sustainability</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#SystemDimension -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#SystemDimension">
        <dc:creator xml:lang="en">Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-11-13T15:28:50+00:00</dc:date>
        <rdfs:comment xml:lang="en">This focuses on the Goals, Process, Social, and Knowledge and Information.</rdfs:comment>
        <rdfs:label xml:lang="en">System Dimension</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#UnspecifiedImpact -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#UnspecifiedImpact">
