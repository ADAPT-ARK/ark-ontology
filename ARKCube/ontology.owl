     xmlns:schema="http://schema.org/"
     xmlns:ARKCube="https://openark.adaptcentre.ie/Ontologies/ARKCube#">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube/ontology.ttl"/>
        <dc:title xml:lang="en">Access Risk Knowledge Cube Ontology</dc:title>
        <terms:abstract xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, the Centre for Innovative Human Systems, Trinity College Dublin (Prof Nick McDonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</terms:abstract>
        <terms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <terms:contributor>Ademar Crotti Junior</terms:contributor>
        <terms:contributor>Julio Hernandez</terms:contributor>
        <terms:contributor>Natalia Duda</terms:contributor>
        <terms:contributor>Nick McDonald</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:creator>Lucy McKenna</terms:creator>
        <terms:creator>Rob Brennan</terms:creator>
        <terms:creator>Yalemisew Abgaz</terms:creator>
        <terms:description xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, the Centre for Innovative Human Systems, Trinity College Dublin (Prof Nick McDonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</terms:modified>
        <terms:publisher>https://openark.adaptcentre.ie</terms:publisher>
        <terms:rights rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlsOntology#RightsStatement"/>
        <terms:title xml:lang="en">Access Risk Knowledge Cube Ontology</terms:title>
        <bibo:status rdf:resource="http://purl.org/ontology/bibo/unstable"/>
        <vann:preferredNamespacePrefix>arkc</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#"/>
        <schema:codeRepository rdf:resource="https://gogs.adaptcentre.ie/ARK/Ontologies/src/master/ARKCube"/>
        <schema:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, the Centre for Innovative Human Systems, Trinity College Dublin (Prof Nick McDonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</rdfs:comment>
        <owl:versionInfo>0.85</owl:versionInfo>
        <ns:status rdf:resource="http://www.w3.org/2003/06/sw-vocab-status/ns#unstable"/>
        <dcat:dataset rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Dataset"/>
        <dcat:service rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#AccessService"/>
        <vocab:introduction xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, the Centre for Innovative Human Systems, Trinity College Dublin (Prof Nick McDonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</vocab:introduction>
        <vocab:rdfxmlSerialization rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube/ontology.ttl"/>
    </owl:Ontology>
    


