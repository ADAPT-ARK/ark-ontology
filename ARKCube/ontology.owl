        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T20:18:16+00:00</dc:date>
        <rdfs:comment xml:lang="en">Release affecting minimal off-site area requiring external assistance (fire brigade, radiation, protection service, etc.)</rdfs:comment>
        <rdfs:label xml:lang="en">Major Impact - Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#majorImpactHSEFinance -->


