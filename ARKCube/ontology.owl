        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:17:44+00:00</dc:date>
        <rdfs:comment xml:lang="en">On site release contained by organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate Impact  - Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEFinance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEFinance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:17:44+00:00</dc:date>
        <rdfs:comment xml:lang="en">0.5-1.0% budget deficit.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate Impact  - Finance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEHarmToAPerson -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEHarmToAPerson">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:17:44+00:00</dc:date>
        <rdfs:comment xml:lang="en">Significant injury requiring medical treatment e.g. Fracture and/or counselling. Agency reportable, e.g. HSA, Gardaí (violent and aggressive acts). &gt;3 Days absence. 3-8 Days extended hospital Stay. Impaired psychosocial functioning greater than one month less than six months.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate Impact  - Harm to a Person</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEObjectivesProjects -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEObjectivesProjects">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:17:44+00:00</dc:date>
        <rdfs:comment xml:lang="en">Reduction in scope or quality of project; project objectives or schedule.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate Impact  - Objectives/Projects</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEServiceUserExperience -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateImpactHSEServiceUserExperience">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:17:44+00:00</dc:date>
        <rdfs:comment xml:lang="en">Unsatisfactory service user experience related to less than optimal treatment resulting in short term effects (less than 1 week).</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate Impact  - Service User Experience</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateSeverityDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#moderateSeverityDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityDFB"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Injury / harm that is of a temporary nature and results in less than 3 days absence.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#monitor -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#monitor">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus"/>
        <rdfs:comment xml:lang="en">Monitor, i.e. existing controls are deemed adequate to manage the risk but these need to be periodically reviewed.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEAdversePublicityReputation -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEAdversePublicityReputation">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:17:44+00:00</dc:date>
        <rdfs:comment xml:lang="en">Rumours, no media coverage. No public concerns voiced.Little effect on staff morale. No review/investigation necessary.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Adverse Publicity/Reputation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEBusinessContinuity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEBusinessContinuity">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:15:34+00:00</dc:date>
        <rdfs:comment xml:lang="en">Interruption in a service which does not impact on the delivery of service user care or the ability to continue to provide service.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Business Continuity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSECompliance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSECompliance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T18:56:12+00:00</dc:date>
        <rdfs:comment xml:lang="en">Minor non-compliance with internal PPPGs. Small number of minor issues requiring improvement.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Compliance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEEnvironment -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEEnvironment">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:18:56+00:00</dc:date>
        <rdfs:comment xml:lang="en">Nuisance Release.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEFinance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEFinance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:18:11+00:00</dc:date>
        <rdfs:comment xml:lang="en">0.33% budget deficit.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Finance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEHarmToAPerson -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEHarmToAPerson">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T17:32:12+00:00</dc:date>
        <rdfs:comment xml:lang="en">Adverse event leading to minor injury not requiring first aid. No impaired Psychosocial functioning.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Harm to a Person</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEObjectivesProjects -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEObjectivesProjects">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T19:15:34+00:00</dc:date>
        <rdfs:comment xml:lang="en">Barely noticeable reduction in scope, quality or schedule.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Objectives/Projects</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEServiceUserExperience -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactHSEServiceUserExperience">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-25T17:27:12+00:00</dc:date>
        <rdfs:comment xml:lang="en">Reduced quality of service user experience related to inadequate provision of information.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Service User Experience</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#open -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#open">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus"/>
        <rdfs:comment xml:lang="en">Open, i.e. additional controls have been identified as necessary.</rdfs:comment>
        <rdfs:label xml:lang="en">Open</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#operational -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#operational">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskType"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10T14:46:14+00:00</dc:date>
        <rdfs:comment xml:lang="en">Operational risks relate to the day-to-day delivery of activities, operational business plans and objectives. Operational risks typically have a short-term focus. Whilst they may impact a number of areas of the service, this does not necessarily make them a strategic risk. Operational risks may have the ability to impact strategic and other operational risks.</rdfs:comment>
        <rdfs:label xml:lang="en">Operational</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#possibleDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#possibleDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodDFB"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">If the situation is not well managed an accident is likely to occur. Probability 30-60%.</rdfs:comment>
        <rdfs:label xml:lang="en">Possible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#possibleHSE -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#possibleHSE">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodHSE"/>
        <actualFrequency>Occurs every 1-2 years</actualFrequency>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Probability: 50%. Actual Frequency: Occurs every 1-2 years.</rdfs:comment>
        <rdfs:label xml:lang="en">Possible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#probableAerLingus -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#probableAerLingus">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodAerLingus"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">7.0E-4</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:22:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Plain: Likely to occur. Qualified (Calendar): More than once a week. Qualified (Context): Has occurred many times in Aer Lingus. Qualified (per flight): 1 out of 1500 flights. Probability: &gt;7 x 10^(minus 4).</rdfs:comment>
        <rdfs:label xml:lang="en">Probable</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#rareDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#rareDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodDFB"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Accidents could only happen under certain conditions. The situation is very well controlled, and all reasonable precautions have been taken. Probability: &lt;10%.</rdfs:comment>
        <rdfs:label xml:lang="en">Rare</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#rareRemoteHSE -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#rareRemoteHSE">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodHSE"/>
        <actualFrequency>Occurs every 5 years</actualFrequency>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.01</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</score>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Probability: 1%. Actual Frequency: Occurs every 5 years or more.</rdfs:comment>
        <rdfs:label xml:lang="en">Rare/Remote</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#rejected -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#rejected">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ApprovalStatus"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-03T14:12:27+00:00</dc:date>
        <rdfs:label xml:lang="en">Rejected</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#remoteAerLingus -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#remoteAerLingus">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodAerLingus"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0E-4</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-01T18:22:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Plain: Could occur, or has occurred. Qualified (Calendar): More than once a month. Qualified (Context): Has occurred in Aer Lingus. Qualified (per flight): 1 out of 6000 flights. Probability: &gt;2 x 10^(minus 4).</rdfs:comment>
        <rdfs:label xml:lang="en">Remote</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#seriousSeverityDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#seriousSeverityDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#SeverityDFB"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Injury / harm that is of a temporary nature and results in more than 3 days absence but not more than 28 days.</rdfs:comment>
        <rdfs:label xml:lang="en">Serious</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#serviceUserExperience -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#serviceUserExperience">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks which threaten the delivery of a service provision to  service users in terms of quality, in a  comfortable,  caring  and  safe  environment,  delivered  in  a  calm  and reassuring  way;  having  information  to  make  choices,  to  feel  confident  and  to  feel  in  control;  being  listened  to  and talked  to as an  equal;  being treated with honesty, respect and dignity.</rdfs:comment>
        <rdfs:label xml:lang="en">Service User Experience</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#strategic -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#strategic">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskType"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10T14:45:13+00:00</dc:date>
        <rdfs:comment xml:lang="en">A strategic risk has the ability to impact on the achievement/delivery of the organisation&apos;s strategic objectives/directions. Strategic risks relate to the highest level of objective for the organisation, which typically have a long-term focus and are linked to the organisation&apos;s strategic plan.</rdfs:comment>
        <rdfs:label xml:lang="en">Strategic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#unlikelyDFB -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#unlikelyDFB">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#LikelihoodDFB"/>
        <probability rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2</probability>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</score>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The situation is well under control, but occasional lapses could occur. Probability 10-30%.</rdfs:comment>
        <rdfs:label xml:lang="en">Unlikely</rdfs:label>
