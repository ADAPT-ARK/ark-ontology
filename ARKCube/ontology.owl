        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-28T16:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">No impact level specified.</rdfs:comment>
        <rdfs:label xml:lang="en">Unspecified Impact</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#UnspecifiedLikelihood -->


