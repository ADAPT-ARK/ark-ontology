        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Evidence"/>
        <dc:creator xml:lang="en">Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-14T13:19:43+00:00</dc:date>
        <rdfs:comment xml:lang="en">The cited evidence provides an authoritative description or definition of the subject under discussion.</rdfs:comment>
        <rdfs:label xml:lang="en">cites as authority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#citesAsPotentialSolution -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#citesAsPotentialSolution">
