      <http://purl.org/dc/elements/1.1/date> "2019-11-13T15:27:46+00:00" ;
      rdfs:comment "An aim or desired outcome."@en ;
      rdfs:label "Goal"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Impact
:Impact rdf:type owl:Class ;
        rdfs:subClassOf [ owl:intersectionOf ( <https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity>
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :textualDescription ;
                                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange rdf:PlainLiteral
                                               ]
                                             ) ;
                          rdf:type owl:Class
                        ] ;
        <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
        <http://purl.org/dc/elements/1.1/date> "2020-09-22T09:53:21+00:00" ;
        rdfs:comment "The imact of a Risk. Used for risk description in ICC (impact, cause, context) format. The outcome or consequence of an event affecting objectives. It can be expressed either qualitatively or quantitatively, being a loss, disadvantage or gain. There may be a range of possible outcomes associated with an event."@en ;
        rdfs:label "Impact"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory
:ImpactCategory rdf:type owl:Class ;
