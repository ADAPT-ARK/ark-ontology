             rdfs:comment "Defined by HSE impact table."@en ;
             rdfs:label "Major Impact"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Mechanism
:Mechanism rdf:type owl:Class ;
           rdfs:subClassOf [ owl:intersectionOf ( <https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity>
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :textualDescription ;
                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
           <http://purl.org/dc/elements/1.1/creator> "Yalemisew" ;
