                 rdfs:comment "Links a risk description to a cause."@en ;
                 rdfs:label "has cause"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#hasContext
ARKCube:hasContext rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( ARKCube:Project
                                               ARKCube:ProjectAnalysis
                                             )
                               ] ;
                   rdfs:range ARKCube:Context ;
                   dc:creator "yalemisew" ;
                   dc:date "2020-01-29T16:05:29+00:00" ;
                   rdfs:comment "The context of a project phase."@en ;
                   rdfs:label "has context"@en ;
                   owl:inverseOf "isContextOf" .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#hasDataset
ARKCube:hasDataset rdf:type owl:ObjectProperty ;
                   rdfs:domain ARKCube:Artefact ;
                   rdfs:range rdfs:Resource ;
                   dc:creator "Ademar" ;
                   dc:date "2020-05-15T14:18:45.087269" ;
                   rdfs:comment "Evidence may contain dataset descriptions" ;
                   rdfs:label "has dataset" .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#hasDeliverable
ARKCube:hasDeliverable rdf:type owl:ObjectProperty ;
