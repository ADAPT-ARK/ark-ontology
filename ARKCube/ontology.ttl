#################################################################
#    Object Properties
#################################################################

###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasAnswer
:hasAnswer rdf:type owl:ObjectProperty ;
           owl:inverseOf :isAnswerOf ;
           rdfs:domain :Question ;
           rdfs:range :Answer ;
           <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
           <http://purl.org/dc/elements/1.1/date> "2019-11-13T17:07:21+00:00" ;
           rdfs:comment "Represents and links the answer to the question." ;
           rdfs:label "has answer"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasArtefact
:hasArtefact rdf:type owl:ObjectProperty ;
             rdfs:domain :Evidence ;
             rdfs:range :Artefact ;
             <http://purl.org/dc/elements/1.1/creator> "Ademar" ;
             <http://purl.org/dc/elements/1.1/date> "2020-05-20T14:31:50.607524" ;
             rdfs:comment "Associates an evidence to artefacts" ;
             rdfs:label "has artefact" .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasAspect
:hasAspect rdf:type owl:ObjectProperty ;
           owl:inverseOf :isAspectOf ;
           rdfs:domain :Question ;
           rdfs:range :AspectOfReality ;
           <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
           <http://purl.org/dc/elements/1.1/date> "2019-11-13T17:06:24+00:00" ;
           rdfs:comment "A question has an aspect." ;
           rdfs:label "has aspect"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasContext
:hasContext rdf:type owl:ObjectProperty ;
            owl:inverseOf :isContextOf ;
            rdfs:range :Context ;
            <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
            <http://purl.org/dc/elements/1.1/date> "2020-01-29T16:05:29+00:00" ;
            rdfs:comment "A phase of a project has a context." ;
            rdfs:label "has context"@en ;
            owl:inverseOf "isContextOf" .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasDataset
:hasDataset rdf:type owl:ObjectProperty ;
            rdfs:domain :Artefact ;
            rdfs:range rdfs:Resource ;
            <http://purl.org/dc/elements/1.1/creator> "Ademar" ;
            <http://purl.org/dc/elements/1.1/date> "2020-05-15T14:18:45.087269" ;
            rdfs:comment "Evidence may contain dataset descriptions" ;
            rdfs:label "has dataset" .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasDimension
:hasDimension rdf:type owl:ObjectProperty ;
              owl:inverseOf :isDimensionOf ;
              rdfs:domain :Question ;
              rdfs:range :SystemDimension ;
              <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
              <http://purl.org/dc/elements/1.1/date> "2019-11-18T14:52:55+00:00" ;
              rdfs:comment "A question has dimension." ;
              rdfs:label "has dimension" .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasEvidence
:hasEvidence rdf:type owl:ObjectProperty ;
             rdfs:domain :Answer ;
             rdfs:range :Evidence ;
             <http://purl.org/dc/elements/1.1/contributor> "Ademar" ;
             <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
             <http://purl.org/dc/elements/1.1/date> "2019-11-18T13:07:27+00:00" ;
             <http://purl.org/dc/elements/1.1/modified> "2020-05-20T12:28:07.518488" ;
             rdfs:comment "An answer has its own evidence."@en ;
             rdfs:label "has evidence"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasEvidenceRule
:hasEvidenceRule rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isEvidenceRuleOf ;
                 rdfs:domain :Answer ;
                 <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
                 <http://purl.org/dc/elements/1.1/date> "2019-11-18T13:07:41+00:00" ;
                 rdfs:comment "Represents and links evidence rule with  question." ;
                 rdfs:label "has evidence rule"@en .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasMechanism
:hasMechanism rdf:type owl:ObjectProperty ;
              owl:inverseOf :isMechanismOf ;
              rdfs:range :Mechanism ;
              <http://purl.org/dc/elements/1.1/creator> "yalemisew" ;
              <http://purl.org/dc/elements/1.1/date> "2020-01-29T16:05:38+00:00" ;
              rdfs:comment "This property links the project phase with Mechanism." ;
              rdfs:label "has mechanism"@en ;
              owl:inverseOf "isMechanismOf" .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasOutcome
:hasOutcome rdf:type owl:ObjectProperty ;
