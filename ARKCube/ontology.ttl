###  http://purl.org/dc/elements/RiskContext
<http://purl.org/dc/elements/RiskContext> rdf:type owl:Class ;
                                          rdfs:subClassOf [ owl:intersectionOf ( :Context
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :textualDescription ;
                                                                                   owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                   owl:onDataRange rdf:PlainLiteral
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                          <http://purl.org/dc/elements/1.1/creator> "Rob Brennan"@en ;
                                          rdfs:comment "The context of a Risk. Used for risk description in ICC (impact, cause, context) format. Used to relate HSE concept of the context of a risk to CUBE concept of context."@en ;
                                          rdfs:label "Risk Context"@en .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


