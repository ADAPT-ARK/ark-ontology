            rdfs:comment "Represents the outcome of the phases of a project." ;
            rdfs:label "has outcome"@en ;
            owl:inverseOf "isOutcomeOf" .


###  https://ark.adaptcentre.ie/Ontologies/ARKCube#hasQuestion
:hasQuestion rdf:type owl:ObjectProperty ;
             owl:inverseOf :isQuestionOf ;
