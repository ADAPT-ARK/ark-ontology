###  https://openark.adaptcentre.ie/Ontologies/ARKCube#MinorImpact
:MinorImpact rdf:type owl:Class ;
             rdfs:subClassOf [ owl:intersectionOf ( :Impact
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :score ;
                                                      owl:hasValue "2"^^xsd:int
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
             <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
             <http://purl.org/dc/elements/1.1/date> "2020-09-29T09:09:10+00:00" ;
             rdfs:comment "Defined by HSE impact table."@en ;
             rdfs:label "Minor Impact"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#ModerateImpact
:ModerateImpact rdf:type owl:Class ;
                rdfs:subClassOf [ owl:intersectionOf ( :Impact
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :score ;
                                                         owl:hasValue "3"^^xsd:int
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
                <http://purl.org/dc/elements/1.1/date> "2020-09-29T09:09:10+00:00" ;
                rdfs:comment "Defined by HSE impact table."@en ;
                rdfs:label "Moderate Impact"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpact
:NegligibleImpact rdf:type owl:Class ;
                  rdfs:subClassOf [ owl:intersectionOf ( :Impact
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :score ;
                                                           owl:hasValue "1"^^xsd:int
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
                  <http://purl.org/dc/elements/1.1/date> "2020-09-29 09:09:10"@en ;
                  rdfs:comment "Uses HSE impact table definition."@en ;
                  rdfs:label "Negligible Impact"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#ObligationToActRating
:ObligationToActRating rdf:type owl:Class ;
