###  https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact
:ExtremeImpact rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( :Impact
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :score ;
                                                        owl:hasValue "5"^^xsd:int
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
               <http://purl.org/dc/elements/1.1/date> "2020-09-29T09:09:10+00:00" ;
               rdfs:comment "Uses HSE impact table for definition."@en ;
               rdfs:label "Extreme Impact"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#FunctionalSystem
:FunctionalSystem rdf:type owl:Class ;
                  rdfs:subClassOf :AspectOfReality ;
