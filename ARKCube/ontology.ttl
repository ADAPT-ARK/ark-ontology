<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Action
:Action rdf:type owl:Class ;
        rdfs:subClassOf [ owl:intersectionOf ( :Control
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :textualDescription ;
                                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ]
                                             ) ;
                          rdf:type owl:Class
                        ] ;
        <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
        <http://purl.org/dc/elements/1.1/date> "2020-09-29T09:09:10+00:00" ;
        rdfs:label "Action"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Activity
:Activity rdf:type owl:Class ;
          rdfs:subClassOf :AspectOfReality ;
          <http://purl.org/dc/elements/1.1/creator> "Yalemisew" ;
          <http://purl.org/dc/elements/1.1/date> "2019-11-13T15:29:07+00:00" ;
          rdfs:comment "The condition in which things are happening or being done. Activity refers to the measurable activity within the system."@en ;
          rdfs:label "Activity"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Answer
:Answer rdf:type owl:Class ;
        rdfs:subClassOf [ owl:intersectionOf ( <https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity>
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasEvidence ;
                                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                 owl:onClass :Evidence
                                               ]
                                             ) ;
                          rdf:type owl:Class
                        ] ;
        <http://purl.org/dc/elements/1.1/creator> "Yalemisew" ;
        <http://purl.org/dc/elements/1.1/date> "2019-11-13T15:29:27+00:00" ;
        rdfs:comment "A written account in response to a question asked."@en ;
        rdfs:label "Answer"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Artefact
:Artefact rdf:type owl:Class ;
          rdfs:subClassOf <https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity> ;
          <http://purl.org/dc/elements/1.1/creator> "Ademar" ;
          <http://purl.org/dc/elements/1.1/date> "2020-05-20T14:31:50.607524" ;
          rdfs:comment "Artefacts are associated to an evidence collection. An artefact may be, for example, a dataset containing information relevant to an answer." ;
          rdfs:label "Artefact" .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality
:AspectOfReality rdf:type owl:Class ;
                 <http://purl.org/dc/elements/1.1/creator> "Yalemisew" ;
                 <http://purl.org/dc/elements/1.1/date> "2019-11-13T15:26:56+00:00"^^xsd:dateTime ;
                 rdfs:comment "Aspect of Reality is a dimension which explores the Functional System, Activity, Sensemaking and Culture across four System Dimensions: Goals, Process, Social, and Knowledge and Information."@en ;
                 rdfs:label "Aspect of Reality"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Cause
:Cause rdf:type owl:Class ;
       rdfs:subClassOf [ owl:intersectionOf ( <https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity>
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty :textualDescription ;
                                                owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange rdf:PlainLiteral
                                              ]
                                            ) ;
                         rdf:type owl:Class
                       ] ;
       <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
       <http://purl.org/dc/elements/1.1/date> "2020-09-29T09:09:10+00:00" ;
       rdfs:comment "The cause of a Risk. Used for risk description in ICC (impact, cause, context) format."@en ;
       rdfs:label "Cause"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Context
:Context rdf:type owl:Class ;
         rdfs:subClassOf [ owl:intersectionOf ( <https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity>
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :textualDescription ;
                                                  owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange rdf:PlainLiteral
                                                ]
                                              ) ;
                           rdf:type owl:Class
                         ] ;
         <http://purl.org/dc/elements/1.1/creator> "Yalemisew" ;
         <http://purl.org/dc/elements/1.1/date> "2020-01-28T16:34:24+00:00" ;
         rdfs:comment "Wider circumstances of the system."@en ;
         rdfs:label "Context"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Control
:Control rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :textualDescription ;
                           owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                           owl:onDataRange rdf:PlainLiteral
                         ] ;
         <http://purl.org/dc/elements/1.1/creator> "Rob Brennan" ;
         <http://purl.org/dc/elements/1.1/date> "2020-09-29T09:09:10+00:00" ;
         rdfs:comment "A mechanism, process, procedure or action which can be verified, which seeks to reduce the likelihood and/or consequence of a risk. Controls include any process, policy, device, practice, or other  actions which modify risk. They can exist or be required as additional in order to further mitigate the risk."@en ;
         rdfs:label "Control"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Culture
:Culture rdf:type owl:Class ;
         rdfs:subClassOf :AspectOfReality ;
         <http://purl.org/dc/elements/1.1/creator> "Yalemisew" ;
         <http://purl.org/dc/elements/1.1/date> "2019-11-13T15:29:07+00:00" ;
         rdfs:comment "A set of collective attitudes, values, goals and practices that characterize a community or system"@en ;
         rdfs:label "Culture"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Deliverable
:Deliverable rdf:type owl:Class ;
