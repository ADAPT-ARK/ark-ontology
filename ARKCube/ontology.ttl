                    dc:creator "Lucy McKenna" ;
                    dc:date "2021-09-28T11:09:10+00:00"^^xsd:dateTime ;
                    rdfs:comment "If the situation is not well managed an accident is likely to occur. Probability 30-60%."@en ;
                    rdfs:label "Possible"@en ;
                    ARKCube:probability "[0.3,0.6]"^^xsd:float ;
                    ARKCube:score "3"^^xsd:int .


