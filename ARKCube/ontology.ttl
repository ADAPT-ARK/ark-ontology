                  dc:creator "yalemisew" ;
                  dc:date "2019-11-13T17:06:24+00:00" ;
                  rdfs:comment "A question has an aspect." ;
                  rdfs:label "has aspect"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#hasCause
ARKCube:hasCause rdf:type owl:ObjectProperty ;
