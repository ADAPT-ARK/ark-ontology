                    dc:creator "Rob Brennan"@en ;
                    dc:date "2020-09-29T09:09:10+00:00"@en ;
                    rdfs:comment "Probability: 50%. Actual Frequency: Occurs every 1-2 years."@en ;
                    rdfs:label "Possible"@en ;
                    ARKCube:actualFrequency "Occurs every 1-2 years" ;
                    ARKCube:probability "0.5"^^xsd:float ;
                    ARKCube:score "3"^^xsd:int .


