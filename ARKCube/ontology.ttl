###  https://openark.adaptcentre.ie/Ontologies/ARKCube#PotentialLoss
:PotentialLoss rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( :LossOrGain
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :textualDescription ;
                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange rdf:PlainLiteral
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               <http://purl.org/dc/elements/1.1/creator> "Rob Brennan"@en ;
               <http://purl.org/dc/elements/1.1/date> "2020-12-18T13:34:27+00:00"@en ;
               <http://purl.org/dc/elements/1.1/description> "CUBE Problem Stage. Loss is the fact of no longer having something or having less of it than before."@en ;
               rdfs:label "Potential Loss"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#Priority
:Priority rdf:type owl:Class ;
