                                            owl:hasValue "3"^^xsd:int
                                          ] ;
                          dc:creator "Rob Brennan" ;
                          dc:date "2020-09-29T09:09:10+00:00" ;
                          rdfs:comment "Defined by HSE primary impact table."@en ;
                          rdfs:label "Moderate"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKCube#NegligibleImpactHSE
ARKCube:NegligibleImpactHSE rdf:type owl:Class ;
                            rdfs:subClassOf ARKCube:ImpactHSE ,
                                            [ rdf:type owl:Restriction ;
