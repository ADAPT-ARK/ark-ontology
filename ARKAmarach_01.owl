    <!-- https://ark.adaptcentre.ie/Ontologies/ARKAmarach#hasAircraftStatus -->

    <owl:ObjectProperty rdf:about="https://ark.adaptcentre.ie/Ontologies/ARKAmarach#hasAircraftStatus">
