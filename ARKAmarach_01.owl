<?xml version="1.0"?>
<rdf:RDF xmlns="https://ark.adaptcentre.ie/Ontologies/ARKAmarach#"
     xml:base="https://ark.adaptcentre.ie/Ontologies/ARKAmarach"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
