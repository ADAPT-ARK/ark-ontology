    <owl:Ontology rdf:about="https://ark.adaptcentre.ie/Ontologies/ARKAmarach#">
        <owl:versionIRI rdf:resource="https://ARKAmarach.adaptcentre.ie/Ontologies/ARKAmarach/0.1"/>
        <dc:contributor>Conor Nolan</dc:contributor>
        <dc:contributor>Jessica Brown</dc:contributor>
        <dc:contributor>Nick McDonald</dc:contributor>
        <dc:contributor>Rob Brennan</dc:contributor>
        <dc:creator>Yalemisew Abgaz</dc:creator>
        <dc:description xml:lang="en">A model for representing concepts, relationships and axioms for Aviation Risk Knowledge flight operaiton reporting system.</dc:description>
        <dc:issued>02/07/2019</dc:issued>
        <dc:modified>02/07/2019</dc:modified>
        <dc:publisher>https://www.ARKAmarach.adaptcentre.ie/</dc:publisher>
        <dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
        <dc:title xml:lang="en">Access Risk Knowledge Ontology Amarach Report Ontology</dc:title>
        <vocab:preferredNamespacePrefix>ARKAM</vocab:preferredNamespacePrefix>
        <vocab:preferredNamespaceUri>https://ARKAmarach.adaptcentre.ie/Ontologies/ARKAmarach#</vocab:preferredNamespaceUri>
        <owl:versionInfo>0.1</owl:versionInfo>
    </owl:Ontology>
    


