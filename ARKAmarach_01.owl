        <rdfs:range rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKAmarach#AircraftStatus"/>
        <dc:description xml:lang="en">Relates the aircraft status with a given report</dc:description>
        <rdfs:label xml:lang="en">has aircraft status</rdfs:label>
    </owl:ObjectProperty>
    


