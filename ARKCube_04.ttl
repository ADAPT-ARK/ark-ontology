arkc:InformationKnowledge a owl:Class ;
    rdfs:label "Information and Knowledge"@en ;
    dc:creator "yalemisew" ;
    dc:date "2019-11-13T15:27:46+00:00" ;
    rdfs:comment """Knowledge gained through communication, research, instruction.
Familiarity gained by personal experience, vicariously or through collective processes"""@en ;
    rdfs:subClassOf arkc:Aspect .

arkc:Mechanism a owl:Class ;
    rdfs:label "Mechanism"@en ;
