arkc: a owl:NamedIndividual,
        owl:Ontology ;
    dc:contributor "Junli Liang"@en,
        "Natalia Duda"@en,
        "Nick Mcdonald"@en,
        "Rob Brennan"@en ;
    dc:creator "Yalemisew Abgaz"@en ;
    dc:description "This ontology supports the cube questionnaire developed by TCD"@en ;
    dc:issued "02/07/2019" ;
    dc:modified "182/04/2020" ;
    dc:publisher "https://www.ARKAmarach.adaptcentre.ie/" ;
    dc:rights "https://creativecommons.org/licenses/by-nc/4.0/" ;
    dc:title "Access Risk Knowledge Cube Questionnaire Ontology"@en ;
    vocab:preferredNamespacePrefix "ARKC" ;
    vocab:preferredNamespaceUri "https://ARKAmarach.adaptcentre.ie/Ontologies/ARKCube#" ;
    rdfs:comment "This ontology supports the cube questionnaire developed by TCD"@en ;
    owl:versionIRI <https://ark.adaptcentre.ie/Ontologies/ARKCube/0.4> ;
    owl:versionInfo "0.4" .

arkc:Action a owl:Class ;
    rdfs:label "Action"@en ;
    dc:creator "yalemisew" ;
    dc:date "2019-11-13T15:29:07+00:00" ;
    rdfs:subClassOf arkc:Dimension .

arkc:Answer a owl:Class ;
    rdfs:label "Answer"@en ;
    dc:creator "yalemisew" ;
    dc:date "2019-11-13T15:29:27+00:00" ;
    rdfs:comment "A written account in response to a question asked."@en .

arkc:Context a owl:Class ;
    rdfs:label "Context"@en ;
    dc:creator "yalemisew" ;
    dc:date "2020-01-28T16:34:24+00:00" .

arkc:Culture a owl:Class ;
    rdfs:label "Culture"@en ;
    dc:creator "yalemisew" ;
    dc:date "2019-11-13T15:29:07+00:00" ;
    rdfs:comment "A set of collective attitudes, values, goals and practives that characterize a community or system"@en ;
    rdfs:subClassOf arkc:Dimension .

arkc:DevelopStage a owl:Class ;
    rdfs:label "Develop Stage"@en ;
    dc:creator "yalemisew" ;
    dc:date "2019-11-13T15:26:37+00:00" ;
    rdfs:comment "A develop stage question is a cube  question which is asked at the development stage of the cube questionnaire."@en ;
