@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AcceptableUseOfInformationAndOtherAssociatedAssets> rdfs:label "Acceptable use of information and other associated assets" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Rules for the acceptable use and procedures for handling information and other associated assets
should be identified, documented and implemented.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AccessControl> rdfs:label "Access control" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Rules to control physical and logical access to information and other associated assets should be
established and implemented based on business and information security requirements.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AccessRights> rdfs:label "Access rights" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Access rights to information and other associated assets should be provisioned, reviewed, modified
and removed in accordance with the organization’s topic-specific policy on and rules for access control.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AccessToSourceCode> rdfs:label "Access to source code" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Read and write access to source code, development tools and software libraries should be appropriately
managed.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AddressingInformationSecurityWithinSupplierAgreements> rdfs:label "Addressing information security within supplier agreements" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Relevant information security requirements should be established and agreed with each supplier based
on the type of supplier relationship.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ApplicationSecurityRequirements> rdfs:label "Application security requirements" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information security requirements should be identified, specified and approved when developing or
acquiring applications.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AssessmentAndDecisionOnInformationSecurityEvents> rdfs:label "Assessment and decision on information security events" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should assess information security events and decide if they are to be categorized as
information security incidents.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:AuthenticationInformation> rdfs:label "Authentication information" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Allocation and management of authentication information should be controlled by a management
process, including advising personnel on the appropriate handling of authentication information.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:CablingSecurity> rdfs:label "Cabling security" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Cables carrying power, data or supporting information services should be protected from interception,
interference or damage.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:CapacityManagement> rdfs:label "Capacity management" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The use of resources should be monitored and adjusted in line with current and expected capacity
requirements.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ChangeManagement> rdfs:label "Change management" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Changes to information processing facilities and information systems should be subject to change
management procedures.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ClassificationOfInformation> rdfs:label "Classification of information" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information should be classified according to the information security needs of the organization based
on confidentiality, integrity, availability and relevant interested party requirements.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ClearDeskAndClearScreen> rdfs:label "Clear desk and clear screen" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Clear desk rules for papers and removable storage media and clear screen rules for information
processing facilities should be defined and appropriately enforced.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ClockSynchronization> rdfs:label "Clock synchronization" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The clocks of information processing systems used by the organization should be synchronized to
approved time sources.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:CollectionOfEvidence> rdfs:label "Collection of evidence" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should establish and implement procedures for the identification, collection,
acquisition and preservation of evidence related to information security events.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ComplianceWithPolicies,RulesAndStandardsForInformationSecurity> rdfs:label "Compliance with policies, rules and standards for information security" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Compliance with the organization’s information security policy, topic-specific policies, rules and
standards should be regularly reviewed.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ConfidentialityOrNon-disclosureAgreements> rdfs:label "Confidentiality or non-disclosure agreements" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Confidentiality or non-disclosure agreements reflecting the organization’s needs for the protection of
information should be identified, documented, regularly reviewed and signed by personnel and other
relevant interested parties.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ConfigurationManagement> rdfs:label "Configuration management" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Configurations, including security configurations, of hardware, software, services and networks should
be established, documented, implemented, monitored and reviewed.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ContactWithAuthorities> rdfs:label "Contact with authorities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization should establish and maintain contact with relevant authorities." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ContactWithSpecialInterestGroups> rdfs:label "Contact with special interest groups" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should establish and maintain contact with special interest groups or other specialist
security forums and professional associations.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:DataLeakagePrevention> rdfs:label "Data leakage prevention" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Data leakage prevention measures should be applied to systems, networks and any other devices that
process, store or transmit sensitive information.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:DataMasking> rdfs:label "Data masking" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Data masking should be used in accordance with the organization’s topic-specific policy on access
control and other related topic-specific policies, and business requirements, taking applicable
legislation into consideration.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:DisciplinaryProcess> rdfs:label "Disciplinary process" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """A disciplinary process should be formalized and communicated to take actions against personnel and
other relevant interested parties who have committed an information security policy violation""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:DocumentedOperatingProcedures> rdfs:label "Documented operating procedures" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Operating procedures for information processing facilities should be documented and made available
to personnel who need them.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:EquipmentMaintenance> rdfs:label "Equipment maintenance" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Equipment should be maintained correctly to ensure availability, integrity and confidentiality of
information.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:EquipmentSitingAndProtection> rdfs:label "Equipment siting and protection" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Equipment should be sited securely and protected." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ICTReadinessForBusinessContinuity> rdfs:label "ICT readiness for business continuity" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """ICT readiness should be planned, implemented, maintained and tested based on business continuity
objectives and ICT continuity requirements.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:IdentityManagement> rdfs:label "Identity management" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The full life cycle of identities should be managed." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:IndependentReviewOfInformationSecurity> rdfs:label "Independent review of information security" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization’s approach to managing information security and its implementation including people,
processes and technologies should be reviewed independently at planned intervals, or when significant
changes occur.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationAccessRestriction> rdfs:label "Information access restriction" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Access to information and other associated assets should be restricted in accordance with the
established topic-specific policy on access control.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationBackup> rdfs:label "Information backup" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Backup copies of information, software and systems should be maintained and regularly tested in
accordance with the agreed topic-specific policy on backup.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationDeletion> rdfs:label "Information deletion" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information stored in information systems, devices or in any other storage media should be deleted
when no longer required.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityAwareness,EducationAndTraining> rdfs:label "Information security awareness, education and training" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Personnel of the organization and relevant interested parties should receive appropriate information
security awareness, education and training and regular updates of the organization's information
security policy, topic-specific policies and procedures, as relevant for their job function.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityDuringDisruption> rdfs:label "Information security during disruption" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should plan how to maintain information security at an appropriate level during
disruption.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityEventReporting> rdfs:label "Information security event reporting" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should provide a mechanism for personnel to report observed or suspected
information security events through appropriate channels in a timely manner.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityForUseOfCloudServices> rdfs:label "Information security for use of cloud services" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Processes for acquisition, use, management and exit from cloud services should be established in
accordance with the organization’s information security requirements.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityInProjectManagement> rdfs:label "Information security in project management" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information security should be integrated into project management." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityInSupplierRelationships> rdfs:label "Information security in supplier relationships" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Processes and procedures should be defined and implemented to manage the information security
risks associated with the use of supplier’s products or services.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityIncidentManagementPlanningAndPreparation> rdfs:label "Information security incident management planning and preparation" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should plan and prepare for managing information security incidents by defining,
establishing and communicating information security incident management processes, roles and
responsibilities.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationSecurityRolesAndResponsibilities> rdfs:label "Information security roles and responsibilities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information security roles and responsibilities should be defined and allocated according to the organization needs." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InformationTransfer> rdfs:label "Information transfer" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information transfer rules, procedures, or agreements should be in place for all types of transfer
facilities within the organization and between the organization and other parties.
""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InstallationOfSoftwareOnOperationalSystems> rdfs:label "Installation of software on operational systems" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Procedures and measures should be implemented to securely manage software installation on
operational systems.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:IntellectualPropertyRights> rdfs:label "Intellectual property rights" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The organization should implement appropriate procedures to protect intellectual property rights" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:InventoryOfInformationAndOtherAssociatedAssets> rdfs:label "Inventory of information and other associated assets" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """An inventory of information and other associated assets, including owners, should be developed and
maintained.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:LabellingOfInformation> rdfs:label "Labelling of information" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """An appropriate set of procedures for information labelling should be developed and implemented in
accordance with the information classification scheme adopted by the organization.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:LearningFromInformationSecurityIncidents> rdfs:label "Learning from information security incidents" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Knowledge gained from information security incidents should be used to strengthen and improve the
information security controls.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:Legal,Statutory,RegulatoryAndContractualRequirements> rdfs:label "Legal, statutory, regulatory and contractual requirements" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Legal, statutory, regulatory and contractual requirements relevant to information security and the
organization’s approach to meet these requirements should be identified, documented and kept up to
date.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:Logging> rdfs:label "Logging" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Logs that record activities, exceptions, faults and other relevant events should be produced, stored,
protected and analysed.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ManagementOfTechnicalVulnerabilities> rdfs:label "Management of technical vulnerabilities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information about technical vulnerabilities of information systems in use should be obtained, the
organization’s exposure to such vulnerabilities should be evaluated and appropriate measures should
be taken.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ManagementResponsibilities> rdfs:label "Management responsibilities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Management should require all personnel to apply information security in accordance with the established information security policy, topic-specific policies and procedures of the organization." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ManagingInformationSecurityInTheICTSupplyChain> rdfs:label "Managing information security in the ICT supply chain" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Processes and procedures should be defined and implemented to manage the information security
risks associated with the ICT products and services supply chain.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:Monitoring,ReviewAndChangeManagementOfSupplierServices> rdfs:label "Monitoring, review and change management of supplier services" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should regularly monitor, review, evaluate and manage change in supplier information
security practices and service delivery.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:MonitoringActivities> rdfs:label "Monitoring activities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Networks, systems and applications should be monitored for anomalous behaviour and appropriate
actions taken to evaluate potential information security incidents.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:NetworksSecurity> rdfs:label "Networks security" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Networks and network devices should be secured, managed and controlled to protect information in
systems and applications.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:OrganizationalControls> rdfs:label "Organizational controls" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:OutsourcedDevelopment> rdfs:label "Outsourced development" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should direct, monitor and review the activities related to outsourced system
development.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PeopleControls> rdfs:label "People controls" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PhysicalControls> rdfs:label "Physical controls" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PhysicalEntry> rdfs:label "Physical entry" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Secure areas should be protected by appropriate entry controls and access points." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PhysicalSecurityMonitoring> rdfs:label "Physical security monitoring" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Premises should be continuously monitored for unauthorized physical access." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PhysicalSecurityPerimeters> rdfs:label "Physical security perimeters" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "" ;
    rdfs:comment """Security perimeters should be defined and used to protect areas that contain information and other
associated assets.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PoliciesForInformationSecurity> rdfs:label "Policies for information security" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information security policy and topic-specific policies should be defined, approved by management, published, communicated to and acknowledged by relevant personnel and relevant interested parties, and reviewed at planned intervals and if significant changes occur." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PrivacyAndProtectionOfPII> rdfs:label "Privacy and protection of PII" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The organization should identify and meet the requirements regarding the preservation of privacy and
protection of PII according to applicable laws and regulations and contractual requirements""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:PrivilegedAccessRights> rdfs:label "Privileged access rights" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "The allocation and use of privileged access rights should be restricted and managed." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ProtectingAgainstPhysicalAndEnvironmentalThreats> rdfs:label "Protecting against physical and environmental threats" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Protection against physical and environmental threats, such as natural disasters and other intentional
or unintentional physical threats to infrastructure should be designed and implemented.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ProtectionAgainstMalware> rdfs:label "Protection against malware" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Protection against malware should be implemented and supported by appropriate user awareness." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ProtectionOfInformationSystemsDuringAuditTesting> rdfs:label "Protection of information systems during audit testing" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Audit tests and other assurance activities involving assessment of operational systems should be
planned and agreed between the tester and appropriate management.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ProtectionOfRecords> rdfs:label "Protection of records" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Records should be protected from loss, destruction, falsification, unauthorized access and unauthorized
release""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:RedundancyOfInformationProcessingFacilities> rdfs:label "Redundancy of information processing facilities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information processing facilities should be implemented with redundancy sufficient to meet availability
requirements.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:RemoteWorking> rdfs:label "Remote working" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Security measures should be implemented when personnel are working remotely to protect information
accessed, processed or stored outside the organization’s premises.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ResponseToInformationSecurityIncidents> rdfs:label "Response to information security incidents" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information security incidents should be responded to in accordance with the documented procedures." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ResponsibilitiesAfterTerminationOrChangeOfEmployment> rdfs:label "Responsibilities after termination or change of employment" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information security responsibilities and duties that remain valid after termination or change of
employment should be defined, enforced and communicated to relevant personnel and other interested
parties.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ReturnOfAssets> rdfs:label "Return of assets" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Personnel and other interested parties as appropriate should return all the organization’s assets in
their possession upon change or termination of their employment, contract or agreement.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:Screening> rdfs:label "Screening" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Background verification checks on all candidates to become personnel should be carried out prior to
joining the organization and on an ongoing basis taking into consideration applicable laws, regulations
and ethics and be proportional to the business requirements, the classification of the information to be
accessed and the perceived risks.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecureAuthentication> rdfs:label "Secure authentication" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Secure authentication technologies and procedures should be implemented based on information
access restrictions and the topic-specific policy on access control""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecureCoding> rdfs:label "Secure coding" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Secure coding principles should be applied to software development." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecureDevelopmentLifeCycle> rdfs:label "Secure development life cycle" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Rules for the secure development of software and systems should be established and applied." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecureDisposalOrRe-useOfEquipment> rdfs:label "Secure disposal or re-use of equipment" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Items of equipment containing storage media should be verified to ensure that any sensitive data and
licensed software has been removed or securely overwritten prior to disposal or re-use""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecureSystemArchitectureAndEngineeringPrinciples> rdfs:label "Secure system architecture and engineering principles" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Principles for engineering secure systems should be established, documented, maintained and applied
to any information system development activities. """ .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecuringOffices,RoomsAndFacilities> rdfs:label "Securing offices, rooms and facilities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Physical security for offices, rooms and facilities should be designed and implemented." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecurityOfAssetsOff-premises> rdfs:label "Security of assets off-premises" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Off-site assets should be protected." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecurityOfNetworkServices> rdfs:label "Security of network services" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Security mechanisms, service levels and service requirements of network services should be identified,
implemented and monitored.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SecurityTestingInDevelopmentAndAcceptance> rdfs:label "Security testing in development and acceptance" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Security testing processes should be defined and implemented in the development life cycle." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SegregationOfDuties> rdfs:label "Segregation of duties" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Conflicting duties and conflicting areas of responsibility should be segregated." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SegregationOfNetworks> rdfs:label "Segregation of networks" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Groups of information services, users and information systems should be segregated in the
organization’s networks.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SeparationOfDevelopment,TestAndProductionEnvironments> rdfs:label "Separation of development, test and production environments" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Development, testing and production environments should be separated and secured" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:StorageMedia> rdfs:label "Storage media" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Storage media should be managed through their life cycle of acquisition, use, transportation and
disposal in accordance with the organization’s classification scheme and handling requirements""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:SupportingUtilities> rdfs:label "Supporting utilities" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information processing facilities should be protected from power failures and other disruptions caused
by failures in supporting utilities.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:TechnologicalControls> rdfs:label "Technological controls" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:TermsAndConditionsOfEmployment> rdfs:label "Terms and conditions of employment" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The employment contractual agreements should state the personnel’s and the organization’s
responsibilities for information security.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:TestInformation> rdfs:label "Test information" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Test information should be appropriately selected, protected and managed." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:ThreatIntelligence> rdfs:label "Threat intelligence" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Information relating to information security threats should be collected and analysed to produce threat
intelligence.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:UseOfCryptography> rdfs:label "Use of cryptography" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """Rules for the effective use of cryptography, including cryptographic key management, should be defined
and implemented.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:UseOfPrivilegedUtilityPrograms> rdfs:label "Use of privileged utility programs" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment """The use of utility programs that can be capable of overriding system and application controls should be
restricted and tightly controlled.""" .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:UserEndpointDevices> rdfs:label "User endpoint devices" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Information stored on, processed by or accessible via user endpoint devices should be protected." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:WebFiltering> rdfs:label "Web filtering" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Access to external websites should be managed to reduce exposure to malicious content." .

<https://openark.adaptcentre.ie/Ontologies#iso27002#Control_prefix:WorkingInSecureAreas> rdfs:label "Working in secure areas" ;
    dcterms:contributor "Junli Liang",
        "Rob Brennan" ;
    dcterms:creator "" ;
    dcterms:title "ISO/IEC 27002:2022(E)" ;
    rdfs:comment "Security measures for working in secure areas should be designed and implemented." .

