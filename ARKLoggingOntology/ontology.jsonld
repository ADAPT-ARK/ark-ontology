}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code400",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "400"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The server cannot or will not process the request due to something that is perceived to be a client error (e.g., malformed request syntax, invalid request message framing, or deceptive request routing)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bad Request"
  } ]
}, {
  "@id" : "https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code401",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "401"
  } ],
