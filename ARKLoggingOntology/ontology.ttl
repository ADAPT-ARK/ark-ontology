@prefix : <https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#> .

<https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#> rdf:type owl:Ontology ;
                                                                 owl:versionIRI <https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology> ;
                                                                 <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                                                                        "Rob Brennan" ;
                                                                 <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
                                                                 <http://purl.org/dc/terms/creator> "Junli Liang" ;
                                                                 <http://purl.org/dc/terms/description> "This ontology dedines owl classes and properties, that are used to generate network/audit logs"@en ;
                                                                 <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by-nc/4.0/> ;
                                                                 <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
                                                                 <http://purl.org/dc/terms/publisher> "https://www.openark.adaptcentre.ie/" ;
                                                                 <http://purl.org/dc/terms/title> "ARK Logging Ontology"@en ;
                                                                 <http://purl.org/vocab/vann/preferredNamespacePrefix> "arkLog" ;
                                                                 <http://purl.org/vocab/vann/preferredNamespaceUri> "https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#" ;
                                                                 owl:versionInfo "0.0.2" .

#################################################################
#    Annotation properties
#################################################################

###  http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId
<http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEntityAccessEvent
:hasEntityAccessEvent rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasEvent ;
                      rdfs:domain :EntityAccessLogEntry ;
                      rdfs:range :EntityAccessEvent ;
                      <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                             "Rob Brennan" ;
                      <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                      <http://purl.org/dc/terms/creator> "Junli Liang" ;
                      <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
                      rdfs:comment "links a log entry to a entity access event."@en ;
                      rdfs:label "has entity access event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEvent
:hasEvent rdf:type owl:ObjectProperty ;
          rdfs:domain :Entry ;
          rdfs:range :Event ;
          <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                 "Rob Brennan" ;
          <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
          <http://purl.org/dc/terms/creator> "Junli Liang" ;
          <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
          rdfs:comment "links a log entry to a log event."@en ;
          rdfs:label "has event"@en .


#################################################################
#    Data properties
#################################################################

###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#entityId
:entityId rdf:type owl:DatatypeProperty ;
          rdfs:domain :EntityAccessLogEntry ;
          rdfs:range xsd:string ;
          <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                 "Rob Brennan" ;
          <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
          <http://purl.org/dc/terms/creator> "Junli Liang" ;
          <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
          rdfs:comment "record the ID of the entity that is accessed."@en ;
          rdfs:label "Entity ID"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEndpoint
:hasEndpoint rdf:type owl:DatatypeProperty ;
             rdfs:domain :Entry ;
             rdfs:range xsd:string ;
             <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                    "Rob Brennan" ;
             <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
             <http://purl.org/dc/terms/creator> "Junli Liang" ;
             <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
             rdfs:comment "record the endpoint of the request that is going to send to."@en ;
             rdfs:label "has endpoint"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hexCode
:hexCode rdf:type owl:DatatypeProperty ;
         rdfs:domain :Level ;
         rdfs:range xsd:string ;
         <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                "Rob Brennan" ;
         <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
         <http://purl.org/dc/terms/creator> "Junli Liang" ;
         <http://purl.org/dc/terms/modified> "2024-05-16"^^xsd:date ;
         rdfs:comment "record the hex code of the log level."@en ;
         rdfs:label "hex code"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ip4Address
:ip4Address rdf:type owl:DatatypeProperty ;
            rdfs:domain :Entry ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                   "Rob Brennan" ;
            <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
            <http://purl.org/dc/terms/creator> "Junli Liang" ;
            <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
            rdfs:comment "record the IP4 address of a client who performed the event. The IP4 address should be encrypted."@en ;
            rdfs:label "IP4 address"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#levelCode
:levelCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Level ;
           rdfs:range xsd:integer ;
           <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                  "Rob Brennan" ;
           <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
           <http://purl.org/dc/terms/creator> "Junli Liang" ;
           <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
           rdfs:comment "record the level code of the log. Useful in filtering, sorting"@en ;
           rdfs:label "level code"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#userId
:userId rdf:type owl:DatatypeProperty ;
        rdfs:domain :Entry ;
        rdfs:range xsd:string ;
        <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                               "Rob Brennan" ;
        <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
        <http://purl.org/dc/terms/creator> "Junli Liang" ;
        <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
        rdfs:comment "record the user ID of the user who performed the event."@en ;
        rdfs:label "user ID"@en .


#################################################################
#    Classes
#################################################################

###  http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Entry
<http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Entry> rdf:type owl:Class .


###  http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level
<http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level> rdf:type owl:Class .


###  http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Resource
<http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Resource> rdf:type owl:Class .


###  http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode
<http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode> rdf:type owl:Class .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#EntityAccessEvent
:EntityAccessEvent rdf:type owl:Class ;
                   rdfs:subClassOf :Event ;
                   <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                                          "Rob Brennan" ;
                   <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                   <http://purl.org/dc/terms/creator> "Junli Liang" ;
                   <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
                   rdfs:comment "An event that is related to accessing a resource i.e. arkc:Project, arkc:Evidence. The resource Id should be linked to a log via arkLog:resourceId"@en ;
                   rdfs:label "Entity Access Event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#EntityAccessLogEntry
:EntityAccessLogEntry rdf:type owl:Class ;
                      rdfs:subClassOf :Entry ;
                      <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                      <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
                      rdfs:comment "Log entry for entity access events"@en ;
                      rdfs:label "Entity Access Log entry"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Entry
:Entry rdf:type owl:Class ;
       rdfs:subClassOf <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Entry> ;
       <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                              "Rob Brennan" ;
       <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
       <http://purl.org/dc/terms/creator> "Junli Liang" ;
       <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
       rdfs:comment "A log entry in ARK."@en ;
       rdfs:label "ARK Log Entry"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event
:Event rdf:type owl:Class ;
       <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                              "Rob Brennan" ;
       <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
       <http://purl.org/dc/terms/creator> "Junli Liang" ;
       <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
       rdfs:comment "An event that is logged."@en ;
       rdfs:label "ARK Log event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level
:Level rdf:type owl:Class ;
       rdfs:subClassOf <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level> ;
       <http://purl.org/dc/terms/contributor> "Junli Liang" ,
                                              "Rob Brennan" ;
       <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
       <http://purl.org/dc/terms/creator> "Junli Liang" ;
       <http://purl.org/dc/terms/modified> "2024-05-27"^^xsd:date ;
       rdfs:comment "A level of the log, that is used in ARK."@en ;
       rdfs:label "ARK Log entry level"@en .


#################################################################
#    Individuals
#################################################################

###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#click
:click rdf:type owl:NamedIndividual ,
                :Event ;
       <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
       <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
       rdfs:comment "Click event"@en ;
       rdfs:label "Click"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code200
:code200 rdf:type owl:NamedIndividual ,
                  <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode> ;
         <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId> 200 ;
         rdfs:comment "The request succeeded. The result meaning of \"success\" depends on the HTTP method: GET, POST"@en ;
         rdfs:label "OK"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code400
:code400 rdf:type owl:NamedIndividual ,
                  <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode> ;
         <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId> 400 ;
         rdfs:comment "The server cannot or will not process the request due to something that is perceived to be a client error (e.g., malformed request syntax, invalid request message framing, or deceptive request routing)."@en ;
         rdfs:label "Bad Request"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code401
:code401 rdf:type owl:NamedIndividual ,
                  <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode> ;
         <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId> 401 ;
         rdfs:comment "Although the HTTP standard specifies \"unauthorized\", semantically this response means \"unauthenticated\". That is, the client must authenticate itself to get the requested response."@en ;
         rdfs:label "Unauthorized"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code500
:code500 rdf:type owl:NamedIndividual ,
                  <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode> ;
         <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId> 500 ;
         rdfs:comment "The server has encountered a situation it does not know how to handle."@en ;
         rdfs:label "Internal Server Error"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#controlAccessEvent
:controlAccessEvent rdf:type owl:NamedIndividual ,
                             :EntityAccessEvent ;
                    <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                    <http://purl.org/dc/terms/modified> "2024-05-17"^^xsd:date ;
                    rdfs:comment "User accesses arkc:Control"@en ;
                    rdfs:label "Access arkc:Control event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#dataEntityEditEvent
:dataEntityEditEvent rdf:type owl:NamedIndividual ,
                              :EntityAccessEvent ;
                     <http://purl.org/dc/terms/created> "2024-05-17"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2024-05-17"^^xsd:date ;
                     rdfs:comment "User edits data entity"@en ;
                     rdfs:label "Edit arkc:DataEntity event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#debug
:debug rdf:type owl:NamedIndividual ,
                :Level ;
       :hexCode "#6C757D" ;
       :levelCode 5 ;
       rdfs:comment "intended for logging detailed information about the system for debugging purposes."@en ;
       rdfs:label "DEBUG"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#error
:error rdf:type owl:NamedIndividual ,
                :Level ;
       :hexCode "#DC3545" ;
       :levelCode 1 ;
       rdfs:comment "indicates error conditions that impair some operation but are less severe than critical situations."@en ;
       rdfs:label "ERROR"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#evidenceAccessEvent
:evidenceAccessEvent rdf:type owl:NamedIndividual ,
                              :EntityAccessEvent ;
                     <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2024-05-17"^^xsd:date ;
                     rdfs:comment "User accesses evidence"@en ;
                     rdfs:label "Access arkc:Evidence event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#filter
:filter rdf:type owl:NamedIndividual ,
                 :Event ;
        <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
        <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
        rdfs:comment "Filter event"@en ;
        rdfs:label "Filter"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#info
:info rdf:type owl:NamedIndividual ,
               :Level ;
      :hexCode "#17A2B8" ;
      :levelCode 3 ;
      rdfs:comment "includes messages that provide a record of the normal operation of the system."@en ;
      rdfs:label "INFO"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#log
:log rdf:type owl:NamedIndividual ,
              :Event ;
     <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
     <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
     rdfs:comment "General log event"@en ;
     rdfs:label "General Log"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#login
:login rdf:type owl:NamedIndividual ,
                :Event ;
       <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
       <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
       rdfs:comment "SUCCESS: Valid email and password entered in sign-in page → successful login. FAILURE: Invalid email or password entered in sign-in page → failed login."@en ;
       rdfs:label "Login"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#logout
:logout rdf:type owl:NamedIndividual ,
                 :Event ;
        <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
        <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
        rdfs:comment "Sign out selected in user menu → successful logout"@en ;
        rdfs:label "Logout"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#newUserSignup
:newUserSignup rdf:type owl:NamedIndividual ,
                        :Event ;
               <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
               rdfs:comment "New user registration submitted through page linked in user invite email"@en ;
               rdfs:label "New User Signup"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#nodeServer
:nodeServer rdf:type owl:NamedIndividual ,
                     <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Resource> ;
            rdfs:comment "ARK Backend server"@en ;
            rdfs:label "ARK Backend server"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#passwordReset
:passwordReset rdf:type owl:NamedIndividual ,
                        :Event ;
               <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
               rdfs:comment "Successful password reset request using Forgot Password feature in sign-in page"@en ;
               rdfs:label "Password Reset"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#passwordUpdate
:passwordUpdate rdf:type owl:NamedIndividual ,
                         :Event ;
                <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
                rdfs:comment "New password submitted through Change Password modal in Your Profile > Details page"@en ;
                rdfs:label "Password Update"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#platform
:platform rdf:type owl:NamedIndividual ,
                   <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Resource> ;
          rdfs:comment "ARK Platform client"@en ;
          rdfs:label "ARK Platform client"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#projectAccessEvent
:projectAccessEvent rdf:type owl:NamedIndividual ,
                             :EntityAccessEvent ;
                    <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                    <http://purl.org/dc/terms/modified> "2024-05-17"^^xsd:date ;
                    rdfs:comment "User accesses a project"@en ;
                    rdfs:label "Access arkc:Project event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#riskRegisterAccessEvent
:riskRegisterAccessEvent rdf:type owl:NamedIndividual ,
                                  :EntityAccessEvent ;
                         <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                         <http://purl.org/dc/terms/modified> "2024-05-17"^^xsd:date ;
                         rdfs:comment "User accesses risk register"@en ;
                         rdfs:label "Access arkc:RiskRegister event"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#search
:search rdf:type owl:NamedIndividual ,
                 :Event ;
        <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
        <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
        rdfs:comment "Search event"@en ;
        rdfs:label "Search"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#success
:success rdf:type owl:NamedIndividual ,
                  :Level ;
         :hexCode "#28A745" ;
         :levelCode 4 ;
         rdfs:comment "indicates that the operation completed successfully."@en ;
         rdfs:label "SUCCESS"@en .


###  https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#userOrgChangeToApproved
:userOrgChangeToApproved rdf:type owl:NamedIndividual ,
