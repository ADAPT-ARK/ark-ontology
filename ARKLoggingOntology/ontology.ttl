:userPlatformRoleChange rdf:type owl:NamedIndividual ,
                                 :Event ;
                        <http://purl.org/dc/terms/created> "2024-05-14"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2024-05-14"^^xsd:date ;
