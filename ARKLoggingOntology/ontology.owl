<?xml version="1.0"?>
<rdf:RDF xmlns="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#"
     xml:base="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ARKLoggingOntology="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:description xml:lang="en">ARK Logging Ontology that is used to generate network/audit logs</terms:description>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:modified>
        <terms:publisher>https://www.openark.adaptcentre.ie/</terms:publisher>
        <terms:rights rdf:resource="https://creativecommons.org/licenses/by/3.0/at/deed.en"/>
        <terms:rights>https://creativecommons.org/licenses/by-nc/4.0/</terms:rights>
        <terms:title xml:lang="en">ARK Logging Ontology</terms:title>
        <vann:preferredNamespacePrefix>arkLog</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#</vann:preferredNamespaceUri>
        <owl:versionInfo>0.1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/rights -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasColourCode -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasColourCode">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ColourCode"/>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEvent -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEvent">
        <rdfs:domain rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">links a log entry to a log event.</rdfs:comment>
        <rdfs:label xml:lang="en">has event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasColourCode -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasColourCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEndpoint -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEndpoint">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the endpoint of the request that is going to send to.</rdfs:comment>
        <rdfs:label xml:lang="en">has endpoint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ip4Address -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ip4Address">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the IP4 address of a client who performed the event. The IP4 address should be encrypted.</rdfs:comment>
        <rdfs:label xml:lang="en">IP4 address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#levelCode -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#levelCode">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the level code of the log. Useful in filtering, sorting</rdfs:comment>
        <rdfs:label xml:lang="en">level code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#resourceId -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#resourceId">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:modified>
        <rdfs:comment xml:lang="en">record the ID of the resource that is accessed.</rdfs:comment>
        <rdfs:label xml:lang="en">resource ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#userId -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#userId">
        <rdfs:domain rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the user ID of the user who performed the event.</rdfs:comment>
        <rdfs:label xml:lang="en">user ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level -->


    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level"/>
    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry -->


    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessControlEvent -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessControlEvent">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessEvidence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessEvidence">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessProjectEvent -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessProjectEvent">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessRiskRegisterEvent -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessRiskRegisterEvent">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ColourCode -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ColourCode">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">HTML Colour code to represent level of a log</rdfs:comment>
        <rdfs:label xml:lang="en">Colour Code</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">An event that is logged.</rdfs:comment>
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level">
        <rdfs:subClassOf rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">A level of the log.</rdfs:comment>
        <rdfs:label xml:lang="en">Level</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:modified>
        <rdfs:comment xml:lang="en">An event that is related to accessing a resource i.e. arkc:Project, arkc:Evidence.</rdfs:comment>
        <rdfs:label xml:lang="en">Resource Access Event</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessControlEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessControlEvent">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessEvidence -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessEvidence">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessProjectEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessProjectEvent">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessRiskRegisterEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#AccessRiskRegisterEvent">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#click -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#click">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">Click event</rdfs:comment>
        <rdfs:label xml:lang="en">Click</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#debug -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#debug">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <hasColourCode rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#lightGrey"/>
        <levelCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</levelCode>
        <rdfs:comment xml:lang="en">intended for logging detailed information about the system for debugging purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">DEBUG</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#error -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#error">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <hasColourCode rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#red"/>
        <levelCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</levelCode>
        <rdfs:comment xml:lang="en">indicates error conditions that impair some operation but are less severe than critical situations.</rdfs:comment>
        <rdfs:label xml:lang="en">ERROR</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#filter -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#filter">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">Filter event</rdfs:comment>
        <rdfs:label xml:lang="en">Filter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#green -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#green">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ColourCode"/>
        <hasColourCode>#28A745</hasColourCode>
        <rdfs:comment xml:lang="en">Represents the success level.</rdfs:comment>
        <rdfs:label xml:lang="en">Success colour (green)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#info -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#info">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <hasColourCode rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#lightBlue"/>
        <levelCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</levelCode>
        <rdfs:comment xml:lang="en">includes messages that provide a record of the normal operation of the system.</rdfs:comment>
        <rdfs:label xml:lang="en">INFO</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#lightBlue -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#lightBlue">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ColourCode"/>
        <hasColourCode>#17A2B8</hasColourCode>
        <rdfs:comment xml:lang="en">Represents the info level.</rdfs:comment>
        <rdfs:label xml:lang="en">Info colour (light blue)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#lightGrey -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#lightGrey">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ColourCode"/>
        <hasColourCode>#6C757D</hasColourCode>
        <rdfs:comment xml:lang="en">Represents the debug level.</rdfs:comment>
        <rdfs:label xml:lang="en">Debug colour (light grey)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#log -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#log">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">General log event</rdfs:comment>
        <rdfs:label xml:lang="en">General Log</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#login -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#login">
