<?xml version="1.0"?>
<rdf:RDF xmlns="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#"
     xml:base="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rlog="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ARKLoggingOntology="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:description xml:lang="en">ARK Logging Ontology that is used to generate network/audit logs</terms:description>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-20</terms:modified>
        <terms:publisher>https://www.openark.adaptcentre.ie/</terms:publisher>
        <terms:rights rdf:resource="https://creativecommons.org/licenses/by/3.0/at/deed.en"/>
        <terms:rights>https://creativecommons.org/licenses/by-nc/4.0/</terms:rights>
        <terms:title xml:lang="en">ARK Logging Ontology</terms:title>
        <vann:preferredNamespacePrefix>arkLog</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#</vann:preferredNamespaceUri>
        <owl:versionInfo>0.1</owl:versionInfo>
    </owl:Ontology>
    


