    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId -->


    <owl:AnnotationProperty rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#codeId"/>
    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/rights -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEvent -->


    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEvent">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">links a log entry to a log event.</rdfs:comment>
        <rdfs:label xml:lang="en">has event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#message -->


    <owl:DatatypeProperty rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#message"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#entityId -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#entityId">
        <rdfs:subPropertyOf rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#message"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessLogEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:modified>
        <rdfs:comment xml:lang="en">record the ID of the entity that is accessed.</rdfs:comment>
        <rdfs:label xml:lang="en">Entity ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEndpoint -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hasEndpoint">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the endpoint of the request that is going to send to.</rdfs:comment>
        <rdfs:label xml:lang="en">has endpoint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hexCode -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#hexCode">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:modified>
        <rdfs:comment xml:lang="en">record the hex code of the log level.</rdfs:comment>
        <rdfs:label xml:lang="en">hex code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ip4Address -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ip4Address">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the IP4 address of a client who performed the event. The IP4 address should be encrypted.</rdfs:comment>
        <rdfs:label xml:lang="en">IP4 address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#levelCode -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#levelCode">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the level code of the log. Useful in filtering, sorting</rdfs:comment>
        <rdfs:label xml:lang="en">level code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#userId -->


    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#userId">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">record the user ID of the user who performed the event.</rdfs:comment>
        <rdfs:label xml:lang="en">user ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level -->


    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level"/>
    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry -->


    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry"/>
    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Resource -->


    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Resource"/>
    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode -->


    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">An event that is logged.</rdfs:comment>
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level">
        <rdfs:subClassOf rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">A level of the log.</rdfs:comment>
        <rdfs:label xml:lang="en">Level</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry">
        <rdfs:subClassOf rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#LogEntry"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">A log entry in ARK.</rdfs:comment>
        <rdfs:label xml:lang="en">Log Entry</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:creator>Junli Liang</terms:creator>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:modified>
        <rdfs:comment xml:lang="en">An event that is related to accessing a resource i.e. arkc:Project, arkc:Evidence. The resource Id should be linked to a log via rlog:message</rdfs:comment>
        <rdfs:label xml:lang="en">Resource Access Event</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessLogEntry -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessLogEntry">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#LogEntry"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:modified>
        <rdfs:comment xml:lang="en">Log entry for resource access events. the message associated should be in the JSON format: {field, stage, }</rdfs:comment>
        <rdfs:label xml:lang="en">Resource Access Log</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#click -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#click">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Event"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</terms:modified>
        <rdfs:comment xml:lang="en">Click event</rdfs:comment>
        <rdfs:label xml:lang="en">Click</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code200 -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code200">
        <rdf:type rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode"/>
        <rlog:codeId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</rlog:codeId>
        <rdfs:comment xml:lang="en">The request succeeded. The result meaning of &quot;success&quot; depends on the HTTP method: GET, POST</rdfs:comment>
        <rdfs:label xml:lang="en">OK</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code400 -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code400">
        <rdf:type rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode"/>
        <rlog:codeId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400</rlog:codeId>
        <rdfs:comment xml:lang="en">The server cannot or will not process the request due to something that is perceived to be a client error (e.g., malformed request syntax, invalid request message framing, or deceptive request routing).</rdfs:comment>
        <rdfs:label xml:lang="en">Bad Request</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code401 -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code401">
        <rdf:type rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode"/>
        <rlog:codeId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">401</rlog:codeId>
        <rdfs:comment xml:lang="en">Although the HTTP standard specifies &quot;unauthorized&quot;, semantically this response means &quot;unauthenticated&quot;. That is, the client must authenticate itself to get the requested response.</rdfs:comment>
        <rdfs:label xml:lang="en">Unauthorized</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code500 -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#code500">
        <rdf:type rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#StatusCode"/>
        <rlog:codeId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</rlog:codeId>
        <rdfs:comment xml:lang="en">The server has encountered a situation it does not know how to handle.</rdfs:comment>
        <rdfs:label xml:lang="en">Internal Server Error</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#controlAccessEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#controlAccessEvent">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:modified>
        <rdfs:comment xml:lang="en">User accesses arkc:Control</rdfs:comment>
        <rdfs:label xml:lang="en">Access arkc:Control event</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#dataEntityEditEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#dataEntityEditEvent">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:modified>
        <rdfs:comment xml:lang="en">User edits data entity</rdfs:comment>
        <rdfs:label xml:lang="en">Edit arkc:DataEntity event</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#debug -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#debug">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <hexCode>#6C757D</hexCode>
        <levelCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</levelCode>
        <rdfs:comment xml:lang="en">intended for logging detailed information about the system for debugging purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">DEBUG</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#error -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#error">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#Level"/>
        <hexCode>#DC3545</hexCode>
        <levelCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</levelCode>
        <rdfs:comment xml:lang="en">indicates error conditions that impair some operation but are less severe than critical situations.</rdfs:comment>
        <rdfs:label xml:lang="en">ERROR</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#evidenceAccessEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#evidenceAccessEvent">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKLoggingOntology#ResourceAccessEvent"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</terms:modified>
        <rdfs:comment xml:lang="en">User accesses evidence</rdfs:comment>
