<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AntimicrobialStewardshipSubcommittee>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A multidisciplinary group of people from within and outside a hospital or groups of hospitals, which reports to senior management. The subcommittee is responsible for the review and oversight of antimicrobial stewardship activities in the hospital or hospitals in question." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Antimicrobial Stewardship Subcommittee" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ServiceUserDesignatedSupportPerson>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "This person is a contact point for the service user/relevant person(s) impacted by an incident." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework 2020" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Service User Designated Support Person" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#MicroOrganism>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
