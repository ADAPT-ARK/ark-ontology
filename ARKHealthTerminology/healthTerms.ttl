<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskAvoidance>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "7/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Informed decision not to be involved in, or to withdraw from, an activity in order not to be exposed to a particular risk. Risk avoidance may increase the significance of other risks or may lead to the loss of opportunities for gain." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
