<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#MedicalDeviceEquipmentDecontaminationCommittee>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A multidisciplinary group of people from within and outside a hospital or groups of hospitals, which reports to senior management. The committee is responsible for the review and oversight of decontamination of medical devices and equipment in the hospital or hospitals in question" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Medical Device Equipment Decontamination Committee" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ProphylacticAntimicrobialTherapy>
