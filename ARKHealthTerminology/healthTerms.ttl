        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Teaching" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Microbiology>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
