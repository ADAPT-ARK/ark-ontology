                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Review> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Monitoring> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#MonitorAndReviewProcess> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#MonitorStatus> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PerformanceMonitoring> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009 / HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Monitor" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#InternalInvestigation>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
