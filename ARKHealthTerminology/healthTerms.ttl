                "HSE Integrated Risk Management Policy - Part 2" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Standards" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SeniorManagementTeam>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Usually includes chief executive officer, clinical director, director of nursing and board of the service" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Senior Management Team" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ServiceContext>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "8/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 2" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#LegalAndRegulatoryContext> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Stakeholders> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 2" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Service Context" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SafetyCulture>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "An integrated pattern of individual and organisational behaviour, based upon shared beliefs and values, which continuously seeks to minimise service user harm which may result from the processes of care delivery." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Safety Culture" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#InfectionPreventionAndControlNurse>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A nurse with specialist postgraduate qualifications and expert knowledge in infection prevention and control. The IPCN acts as an advocate for the patient in quality improvement, safety and risk. IPCNs lead and implement the hospital or service infection prevention and control annual plan. The IPCN engages in activities such as:act as an advisor in management of outbreaks;development of healthcare facilities;surveillance;audit;decontamination and the education of all healthcare workers and outside contractors" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Infection Prevention and Control Nurse (IPCN)" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskManager>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "7/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 1" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 1" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Risk Manager" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AntimicrobialStewardshipProgramme>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Structures, systems and processes that a service has in place for safe and effective antimicrobial use" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Antimicrobial Stewardship Programme" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#TransmissionBasedPrecautions>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "These are additional precautions that staff need to take when standard precautions may be insufficient to prevent cross transmission of specific infectious agents. Transmission-based precautions are categorised by the route of transmission of infectious agents (some infectious agents can be transmitted by more than one route) including contact, droplet and airborne precautions" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Transmission-Based Precautions" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SeniorAccountableOfficer>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "n the context of the management of an incident, the Senior Accountable Officer is the person who has ultimate accountability and responsibility for the services within the area where the incident occurred. In a hospital group it would be a person with delegated responsibility for a service and reporting directly to the Hospital Group CEO, e.g. a hospital manager or the person delegated with overall responsibility for the management of a clinical directorate or service, in a CHO it could be the Head of Service and in the case of the NAS, it could be the NAS corporate area manager" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Senior Accountable Officer" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HealthcareAssociatedInfection>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Infections that are acquired after contact with a healthcare service" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HIQANationalStandardsForThePreventionAndControlOfHealthcareAssociatedInfections> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HealthcareAssociatedInfectionIncident> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Healthcare-Associated Infection" .

