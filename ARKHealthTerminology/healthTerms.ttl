<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Notification>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "All medical practitioners, including clinical directors of diagnostic laboratories are required to notify the medical officer of health in the local Departments of Public Health of certain infectious diseases. The list of diseases (and the respective causative micro-organisms) that are notifiable is contained in the Infectious Diseases Regulations 1981 and subsequent amendments.This information is used to investigate cases, facilitate the early identification of outbreaks, and monitor the burden and changing levels of diseases" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Notification" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PointOfCareTesting>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Tests designed to be used at or near the site where the patient is located, which do not require permanent dedicated space and which are performed outside the physical facilities of the clinical laboratories" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
