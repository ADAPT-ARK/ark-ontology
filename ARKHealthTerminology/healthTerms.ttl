                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Lack of an immune response to vaccines" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Vaccine Non-Responder" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Hygiene>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The practice that serves to keep people and the environment clean. In a healthcare setting it incorporates the following key areas: environment and facilities, hand hygiene, management of laundry, waste and sharps, and equipment, specifically in the context of preventing and controlling infection" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HandHygiene> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Hygiene" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Outbreak>
