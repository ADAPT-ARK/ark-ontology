<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SeriousIncidents>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The Health Service Executive (HSE)list of serious reportable events as it relates to infection prevention and control includes ‘patient death or serious disability associated with the use of contaminated medications, medical devices or biologics provided by the healthcare service provider’. The national incident management system list of reportable incidents includes biological hazards from injury including exposure to needle-stick, bite, ingestion, skin contact, bodily fluids and sharps" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Serious Incidents" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskAppetite>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "7/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Amount and type of risk that an organisation is willing to pursue or retain." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Risk Appetite" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#CommunicableDisease>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Infectious disease that can be passed from one person to another" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Communicable Disease" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AntimicrobialStewardship>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A systematic approach to promoting and monitoring the judicious use of antimicrobials to preserve their future effectiveness" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Antimicrobial Stewardship" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#LineManager>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "7/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A person with responsibility for directly managing individual employees or teams. In turn, they report to a higher level of management on the performance and well-being of the employees or teams they manage." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Line Manager" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ReviewCommissioner>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The person who commissions an incident review. For Category 1 incidents it is the Senior Accountable Officer (SAO) or person who has a direct reporting relationship to the SAO. For Category 2 incidents it is the Local Accountable Officer." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Review Commissioner" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PointOfCare>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The place where the following three elements come together: the patient, the healthcare worker and the care or treatment involving contact with the patient or the patient’s surroundings" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PointOfCareTesting> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Point of Care" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ClinicalGovernance>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework - Guidance 2020 / HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A system through which service providers are accountable for continuously improving the quality of their clinical practice and safeguarding high standards of care by creating an environment in which excellence in clinical care will flourish. This includes mechanisms for monitoring clinical quality and safety through structured programmes, for example, clinical audit." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework - Guidance 2020 / HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Clinical Governance" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskCategories>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "7/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The categories used by the organisation to group similar opportunities or risks for the purposes of reporting and assigning responsibility." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ServiceUserExperienceImpact> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#EnvironmentImpact> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HarmToAThing> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AdversePublicityOrReputation> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ImpactArea> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ComplianceImpact> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#FinancialLoss> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ObjectivesAndProjectsImpact> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#BusinessContinuity> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HarmToAPerson> ;
        <http://www.w3.org/2004/02/skos/core#note>
