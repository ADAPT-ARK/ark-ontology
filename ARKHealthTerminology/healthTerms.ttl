<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HealthServiceProvider>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "(a) a person, other than a health practitioner, who provides one or more health services (b) a health practitioner who, or a partnership which, provides a health service and does not provide that health service for, or on behalf of, or through or in connection with (whether by reason of employment or otherwise), a person referred to in paragraph (a)" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
