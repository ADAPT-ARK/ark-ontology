<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Controls>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "7/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A mechanism, process, procedure or action which can be verified, which seeks to reduce the likelihood and/or consequence of a risk. Controls include any process, policy, device, practice, or other  actions which modify risk. They can exist or be required as additional in order to further mitigate the risk." ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ExistingControlsWhoseStatusHasChanged> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#EquipmentAndResources> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Legislation> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Transference> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Avoidance> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ReductionAtSource> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ExistingControlMeasures> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#CommitteeOversight> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Treatment> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#EducationAndTraining> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Standard> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PolicyProcedureProtocolGuidelines> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ControlStatus> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ProcessesAndSystems> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Elimination> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ReductionViaAdministrativeControls> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AdditionalControls> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#MeasureControlAndMonitor> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 1/ISO 31000:2009" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Controls" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ImmunosuppressiveTreatment>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Treatment which lowers the body’s immune response, therefore increasing the risk for infection. Examples include medications (such as steroids, biologics), procedures (chemotherapy/ haematopoietic stem cell transplantation) and surgeries (solid organ transplants)" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Immunosuppressive Treatment" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#EnhancedSurveillanceData>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "Refers to additional information that is sought, following the notification of an infection, including relevant clinical, microbiological and epidemiological information, which is used to guide prevention and control efforts" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Enhanced (Surveillance) Data" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Workforce>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The people who work in, for or with the service provider. This includes individuals that are employed, self-employed, temporary, volunteers, contracted or anyone who is responsible or accountable to the organisation when providing a service to the patient" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SkillMix> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Staff> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Workforce" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafetyIncident>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "A patient safety incident, in relation to the provision of a health service to a patient by a health services provider, means “an incident which occurs during the course of the provision of a health service”" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
