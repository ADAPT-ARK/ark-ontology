        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The arrangements that service providers have in place to manage information to support their immediate and future regulatory, legal, risk, environmental and operational requirements" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Information Governance" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#OperationalObjectives>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "8/9/20" ;
        <http://purl.org/dc/terms/creator>
                "Rob" ;
        <http://purl.org/dc/terms/source>
                "HSE Integrated Risk Management Policy - Part 2" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Integrated Risk Management Policy - Part 2" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Operational Objectives" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#QPSAdvisor>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "This term is used to refer to the person whose role it is to advise and support a service in relation to their Quality and Patient Safety processes and response. It is noted that the title given to this role can vary between services e.g. Quality & Safety Manager, Quality, Risk and Safety Manager etc" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "QPS Advisor" .

