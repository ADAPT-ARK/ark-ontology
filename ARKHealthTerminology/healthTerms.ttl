<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AlertOrganism>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
