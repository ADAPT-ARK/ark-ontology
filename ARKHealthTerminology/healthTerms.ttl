                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Outbreak> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#CommunicableDisease> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Notification> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#InfectiousDiseasesConsultant> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#CohortArea> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#CaseDefinition> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Infectious Disease" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#InformedConsent>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
