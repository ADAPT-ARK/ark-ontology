<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Equipment>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "This consists of a large group of equipment, typically divided into four broad groups including single-use items, singlepatient-use items, reusable non-invasive communal patient care equipment and reusable invasive medical devices. The list of equipment includes, but is not limited to, commodes, beds and mattresses, portable patient monitoring equipment and intravenous stands" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Equipment" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafety>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "18/12/2020" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The term used nationally and internationally to describe the freedom from unnecessary harm or potential harm associated with healthcare services and the reduction of risk of unnecessary harm to an acceptable minimum (World Health Organisation, 2009). Where the term patient is used to describe ‘patient safety incident’, ‘quality and patient safety committees’ or ‘patient safety data’, it is intended to encompass all definitions of people who use health (including mental health) care services e.g. service users in both acute and community health care settings" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafetyData> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#QualityPatientSafetyRiskManagerAdvisors> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#QPSAdvisor> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafetyIncident> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Patient Safety" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Surveillance>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#definition>
                "The ongoing systematic collection, collation, analysis and interpretation of data; and the sharing of information to those who need to know in order that action may be taken" ;
        <http://www.w3.org/2004/02/skos/core#inScheme>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#narrower>
                <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SurveillanceScientist> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#EnhancedSurveillanceData> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SentinelSurveillanceData> , <https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HealthProtectionSurveillanceCentre> ;
        <http://www.w3.org/2004/02/skos/core#note>
                "HIQA National Standards for the Prevention and Control of Healthcare-Associated Infections 2017" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel>
                "Surveillance" .

<https://openark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Handover>
        a       <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created>
                "19/05/21" ;
        <http://purl.org/dc/terms/creator>
                "Lucy" ;
        <http://purl.org/dc/terms/source>
