###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#LineManager
:LineManager rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos#Concept> ;
             <http://purl.org/dc/terms/created> "07/09/2020" ;
             <http://purl.org/dc/terms/creator> "Rob" ;
             <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009" ;
             rdfs:comment "A person with responsibility for directly managing individual employees or teams. In turn, they report to a higher level of management on the performance and well-being of the employees or teams they manage." ;
             rdfs:label "Line Manager" ;
             <http://www.w3.org/2004/02/skos#definition> "A person with responsibility for directly managing individual employees or teams. In turn, they report to a higher level of management on the performance and well-being of the employees or teams they manage." ;
             <http://www.w3.org/2004/02/skos#prefLabel> "Line Manager" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#LocalAccountableOfficer
:LocalAccountableOfficer rdf:type owl:NamedIndividual ,
                                  <http://www.w3.org/2004/02/skos#Concept> ;
                         <http://purl.org/dc/terms/created> "18/12/2020" ;
                         <http://purl.org/dc/terms/creator> "Lucy" ;
                         <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                         rdfs:comment "This is the local manager who is responsible for the service in which the incident occurred e.g. ADON, Person in Charge, Business Manager, Clinical Lead" ;
                         rdfs:label "Local Accountable Officer" ;
                         <http://www.w3.org/2004/02/skos#definition> "This is the local manager who is responsible for the service in which the incident occurred e.g. ADON, Person in Charge, Business Manager, Clinical Lead" ;
                         <http://www.w3.org/2004/02/skos#prefLabel> "Local Accountable Officer" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#LookBackReview
:LookBackReview rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "18/12/2020" ;
                <http://purl.org/dc/terms/creator> "Lucy" ;
                <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                rdfs:comment "Review where a number of people may have been exposed to a specific hazard in order to identify if any of those exposed have been harmed and how to take care of them" ;
                rdfs:label "Look Back Review" ;
                <http://www.w3.org/2004/02/skos#definition> "Review where a number of people may have been exposed to a specific hazard in order to identify if any of those exposed have been harmed and how to take care of them" ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Look Back Review" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ManagementPlan
:ManagementPlan rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "08/09/2020" ;
                <http://purl.org/dc/terms/creator> "Rob" ;
                <http://purl.org/dc/terms/source> "HSE Part 2" ;
                rdfs:comment "For example where the management of a risk requires the supervision of staff, or assurance in relation to the systems already in place" ;
                rdfs:label "Management Plan" ;
                <http://www.w3.org/2004/02/skos#definition> "For example where the management of a risk requires the supervision of staff, or assurance in relation to the systems already in place" ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Management Plan" .


