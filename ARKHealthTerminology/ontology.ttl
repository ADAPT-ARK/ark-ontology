###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskMatrix
:RiskMatrix rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "07/09/2020" ;
            <http://purl.org/dc/terms/creator> "Rob" ;
            <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009" ;
            rdfs:comment "Tool for ranking and displaying risks by defining ranges for consequence and likelihood." ;
            rdfs:label "Risk Matrix" ;
            <http://www.w3.org/2004/02/skos#definition> "Tool for ranking and displaying risks by defining ranges for consequence and likelihood." ;
            <http://www.w3.org/2004/02/skos#prefLabel> "Risk Matrix" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskNotification
:RiskNotification rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos#Concept> ;
                  <http://purl.org/dc/terms/created> "12/09/2020" ;
                  <http://purl.org/dc/terms/creator> "Rob" ;
                  <http://purl.org/dc/terms/source> "HSE Part 3" ;
                  rdfs:comment "Communication and notification of risk from one level of the organisation to another." ;
                  rdfs:label "Risk Notification" ;
                  <http://www.w3.org/2004/02/skos#definition> "Communication and notification of risk from one level of the organisation to another." ;
                  <http://www.w3.org/2004/02/skos#prefLabel> "Risk Notification" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskProfile
:RiskProfile rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos#Concept> ;
             <http://purl.org/dc/terms/created> "07/09/2020" ;
             <http://purl.org/dc/terms/creator> "Rob" ;
             <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009" ;
             rdfs:comment "A risk profile is a written description of a set of risks. A risk profile can include the risks that the entire organisation must manage or only those that a particular function or part of the organisation must address. (In the HSE, a services risk profile is set out in their risk register)." ;
             rdfs:label "Risk Profile" ;
             <http://www.w3.org/2004/02/skos#definition> "A risk profile is a written description of a set of risks. A risk profile can include the risks that the entire organisation must manage or only those that a particular function or part of the organisation must address. (In the HSE, a services risk profile is set out in their risk register)." ;
             <http://www.w3.org/2004/02/skos#prefLabel> "Risk Profile" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskRe-Rating
:RiskRe-Rating rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos#Concept> ;
               <http://purl.org/dc/terms/created> "12/09/2020" ;
               <http://purl.org/dc/terms/creator> "Rob" ;
               <http://purl.org/dc/terms/source> "HSE Part 3" ;
               rdfs:comment "With the completion of some or all of the actions the level of risk (the rating) may be reassessed in order to consider whether its likelihood or impact score has reduced." ;
               rdfs:label "Risk Re-Rating" ;
               <http://www.w3.org/2004/02/skos#definition> "With the completion of some or all of the actions the level of risk (the rating) may be reassessed in order to consider whether its likelihood or impact score has reduced." ;
               <http://www.w3.org/2004/02/skos#prefLabel> "Risk Re-Rating" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskRegister
:RiskRegister rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "07/09/2020" ;
              <http://purl.org/dc/terms/creator> "Rob" ;
              <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009" ;
              rdfs:comment "A risk register is a database of assessed risks that face any organisation at any one time. Always changing to reflect the dynamic nature of risks and the organisation’s management of them, its purpose is to help managers prioritise available resources to minimise risk and target improvements to best effect." ;
              rdfs:label "Risk Register" ;
              <http://www.w3.org/2004/02/skos#definition> "A risk register is a database of assessed risks that face any organisation at any one time. Always changing to reflect the dynamic nature of risks and the organisation’s management of them, its purpose is to help managers prioritise available resources to minimise risk and target improvements to best effect." ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Risk Register" .


