###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Accountability
:Accountability rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "18/12/202" ;
                <http://purl.org/dc/terms/creator> "Lucy" ;
                <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                rdfs:comment "Being answerable to another person or organisation for decisions, behaviour and any consequences" ;
                rdfs:label "Accountability" ;
                <http://www.w3.org/2004/02/skos#definition> "Being answerable to another person or organisation for decisions, behaviour and any consequences" ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Accountability" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ActionOwners
:ActionOwners rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "07/09/2020" ;
