:RiskRegisterReview rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "12/09/2020" ;
                    <http://purl.org/dc/terms/creator> "Rob" ;
                    <http://purl.org/dc/terms/source> "HSE Part 3" ;
                    rdfs:label "Reviewing the Entirety of the Risk Register" ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Reviewing the Entirety of the Risk Register" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskStatusChange
:RiskStatusChange rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos#Concept> ;
