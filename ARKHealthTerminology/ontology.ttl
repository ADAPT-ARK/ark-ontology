              <http://purl.org/dc/terms/source> "HSE Part 1" ;
              rdfs:comment "Assigned to tasks as part of risk assessment process (p8)" ;
              rdfs:label "Action Owners" ;
              <http://www.w3.org/2004/02/skos#definition> "Assigned to tasks as part of risk assessment process (p8)" ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Action Owners" .


