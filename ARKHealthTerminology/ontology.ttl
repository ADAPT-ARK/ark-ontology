###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Competence
:Competence rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "18/12/2020" ;
            <http://purl.org/dc/terms/creator> "Lucy" ;
            <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
            rdfs:comment "The knowledge, skills, abilities, behaviours, experience and expertise to be able to perform a particular task and activity." ;
            rdfs:label "Competence" ;
            <http://www.w3.org/2004/02/skos#definition> "The knowledge, skills, abilities, behaviours, experience and expertise to be able to perform a particular task and activity." ;
            <http://www.w3.org/2004/02/skos#prefLabel> "Competence" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Complaint
:Complaint rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos#Concept> ;
           <http://purl.org/dc/terms/created> "07/09/2020" ;
           <http://purl.org/dc/terms/creator> "Rob" ;
           <http://purl.org/dc/terms/source> "HSE Part 1" ;
           rdfs:comment "The Health Act 2004 defines a complaint as:A complaint means a complaint made about any action of the Executive, or a Service Provider (see definition below) that, is claimed does not accord with fair or sound administration practice, adversely affects the person by whom, or on whose behalf, the complaint is made" ;
           rdfs:label "Complaint" ;
           <http://www.w3.org/2004/02/skos#definition> "The Health Act 2004 defines a complaint as:A complaint means a complaint made about any action of the Executive, or a Service Provider (see definition below) that, is claimed does not accord with fair or sound administration practice, adversely affects the person by whom, or on whose behalf, the complaint is made" ;
           <http://www.w3.org/2004/02/skos#prefLabel> "Complaint" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ComplaintManager
:ComplaintManager rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos#Concept> ;
                  <http://purl.org/dc/terms/created> "18/12/2020" ;
                  <http://purl.org/dc/terms/creator> "Lucy" ;
                  <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                  rdfs:comment "A person delegated by their organisation for the purpose of championing the feedback management process, including the routine monitoring and review of same" ;
                  rdfs:label "Complaint Manager" ;
                  <http://www.w3.org/2004/02/skos#definition> "A person delegated by their organisation for the purpose of championing the feedback management process, including the routine monitoring and review of same" ;
                  <http://www.w3.org/2004/02/skos#prefLabel> "Complaint Manager" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ComplaintsOfficer
:ComplaintsOfficer rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "A person designated by the HSE for the purpose of dealing with complaints made to it in accordance with procedures established under section 49 (1) of the Health Act 2004 or a person designated by a service provider with whom the HSE has an arrangement under section 38 of the Health Act 2004 or given assistance under section 39 of the Health Act 2004." ;
                   rdfs:label "Complaints Officer" ;
                   <http://www.w3.org/2004/02/skos#definition> "A person designated by the HSE for the purpose of dealing with complaints made to it in accordance with procedures established under section 49 (1) of the Health Act 2004 or a person designated by a service provider with whom the HSE has an arrangement under section 38 of the Health Act 2004 or given assistance under section 39 of the Health Act 2004." ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "Complaints Officer" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Compliance
:Compliance rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "08/09/2020" ;
            <http://purl.org/dc/terms/creator> "Rob" ;
            <http://purl.org/dc/terms/source> "HSE Part 2" ;
            rdfs:comment "Failure to comply with HIQA/MHC standards, Codes of Practice or Conduct set by professional regulators, relevant legislation e.g. Safety, Health and Welfare at Work Act, Financial Regulations etc." ;
            rdfs:label "Compliance" ;
            <http://www.w3.org/2004/02/skos#definition> "Failure to comply with HIQA/MHC standards, Codes of Practice or Conduct set by professional regulators, relevant legislation e.g. Safety, Health and Welfare at Work Act, Financial Regulations etc." ;
            <http://www.w3.org/2004/02/skos#prefLabel> "Compliance" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ConcernsAndEnquiries
:ConcernsAndEnquiries rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos#Concept> ;
                      <http://purl.org/dc/terms/created> "18/12/2020" ;
                      <http://purl.org/dc/terms/creator> "Lucy" ;
                      <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                      rdfs:comment "A concern or enquiry is a problem raised that can be resolved/responded to straight away, (by the end of the next working day). These are not reported as complaints and fall outside the complaints management arrangements" ;
                      rdfs:label "Concerns and Enquiries" ;
                      <http://www.w3.org/2004/02/skos#definition> "A concern or enquiry is a problem raised that can be resolved/responded to straight away, (by the end of the next working day). These are not reported as complaints and fall outside the complaints management arrangements" ;
                      <http://www.w3.org/2004/02/skos#prefLabel> "Concerns and Enquiries" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ConfidentialRecipient
:ConfidentialRecipient rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "18/12/2020" ;
                       <http://purl.org/dc/terms/creator> "Lucy" ;
                       <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                       rdfs:comment "The Confidential Recipient is an independent person appointed by the HSE to receive concerns and allegations of abuse, negligence, mistreatment or poor care practices in HSE or HSE funded residential care facilities from patients, service users, relevant person(s), other concerned individuals and staff members" ;
                       rdfs:label "Confidential Recipient" ;
                       <http://www.w3.org/2004/02/skos#definition> "The Confidential Recipient is an independent person appointed by the HSE to receive concerns and allegations of abuse, negligence, mistreatment or poor care practices in HSE or HSE funded residential care facilities from patients, service users, relevant person(s), other concerned individuals and staff members" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Confidential Recipient" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ContributoryFactor
:ContributoryFactor rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "18/12/2020" ;
                    <http://purl.org/dc/terms/creator> "Lucy" ;
                    <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                    rdfs:comment "A circumstance, action or influence which is thought to have played a part in the origin or development of an incident or to increase the risk of an incident." ;
                    rdfs:label "Contributory Factor" ;
                    <http://www.w3.org/2004/02/skos#definition> "A circumstance, action or influence which is thought to have played a part in the origin or development of an incident or to increase the risk of an incident." ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Contributory Factor" .


