                                           <http://purl.org/dc/terms/source> "HSE Part 3" ;
                                           rdfs:label "Risks Notified From Another Organisation Level" ;
                                           <http://www.w3.org/2004/02/skos#prefLabel> "Risks Notified From Another Organisation Level" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SafetyAlert
:SafetyAlert rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos#Concept> ;
             <http://purl.org/dc/terms/created> "08/09/2020" ;
             <http://purl.org/dc/terms/creator> "Rob" ;
             <http://purl.org/dc/terms/source> "HSE Part 2" ;
             rdfs:label "Safety Alert" ;
             <http://www.w3.org/2004/02/skos#prefLabel> "Safety Alert" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#SafetyCulture
:SafetyCulture rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos#Concept> ;
               <http://purl.org/dc/terms/created> "18/12/2020" ;
               <http://purl.org/dc/terms/creator> "Lucy" ;
               <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
               rdfs:comment "An integrated pattern of individual and organisational behaviour, based upon shared beliefs and values, which continuously seeks to minimise service user harm which may result from the processes of care delivery." ;
               rdfs:label "Safety culture" ;
               <http://www.w3.org/2004/02/skos#definition> "An integrated pattern of individual and organisational behaviour, based upon shared beliefs and values, which continuously seeks to minimise service user harm which may result from the processes of care delivery." ;
               <http://www.w3.org/2004/02/skos#prefLabel> "Safety culture" .


