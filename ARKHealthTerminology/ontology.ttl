###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ServiceProvider
:ServiceProvider rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos#Concept> ;
                 <http://purl.org/dc/terms/created> "18/12/2020" ;
                 <http://purl.org/dc/terms/creator> "Lucy" ;
                 <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                 rdfs:comment "(External to HSE) Part 7, Section 38 of the Health Act 2004 defines a Service Provider as a person with whom the Executive enters into an arrangement for the provision of a health or personal social service on behalf of the Executive, e.g. Nursing Homes, non-statutory Residential/Respite Homes/Centres etc." ;
                 rdfs:label "Service Provider" ;
                 <http://www.w3.org/2004/02/skos#definition> "(External to HSE) Part 7, Section 38 of the Health Act 2004 defines a Service Provider as a person with whom the Executive enters into an arrangement for the provision of a health or personal social service on behalf of the Executive, e.g. Nursing Homes, non-statutory Residential/Respite Homes/Centres etc." ;
                 <http://www.w3.org/2004/02/skos#prefLabel> "Service Provider" .


