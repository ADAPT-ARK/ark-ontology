###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RelevantPerson
:RelevantPerson rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "18/12/2020" ;
                <http://purl.org/dc/terms/creator> "Lucy" ;
                <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020" ;
                rdfs:comment "“Relevant person”, in relation to a patient, means a person;(a) who is;(i) a parent, guardian, son or daughter,(ii) a spouse, or(iii) a civil partner of the patient,(b) who is cohabiting with the patientor(c) whom the patient has nominated in writing to the health services provider as a person to whom clinical information in relation to the patient may be disclosed(Civil Liability (Amendment) Act 2017)" ;
                rdfs:label "Relevant Person" ;
                <http://www.w3.org/2004/02/skos#definition> "“Relevant person”, in relation to a patient, means a person;(a) who is;(i) a parent, guardian, son or daughter,(ii) a spouse, or(iii) a civil partner of the patient,(b) who is cohabiting with the patientor(c) whom the patient has nominated in writing to the health services provider as a person to whom clinical information in relation to the patient may be disclosed(Civil Liability (Amendment) Act 2017)" ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Relevant Person" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ReportableCircumstance
:ReportableCircumstance rdf:type owl:NamedIndividual ,
                                 <http://www.w3.org/2004/02/skos#Concept> ;
                        <http://purl.org/dc/terms/created> "18/12/2020" ;
                        <http://purl.org/dc/terms/creator> "Lucy" ;
                        <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                        rdfs:comment "A situation in which there was significant potential for harm, but no incident occurred. (WHO Conceptual Framework for the International Classification for Patient Safety 2009)." ;
                        rdfs:label "Reportable Circumstance" ;
                        <http://www.w3.org/2004/02/skos#definition> "A situation in which there was significant potential for harm, but no incident occurred. (WHO Conceptual Framework for the International Classification for Patient Safety 2009)." ;
                        <http://www.w3.org/2004/02/skos#prefLabel> "Reportable Circumstance" .


