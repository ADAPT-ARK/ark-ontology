          rdfs:label "Risk Lead" ;
          <http://www.w3.org/2004/02/skos#prefLabel> "Risk Lead" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskManagement
:RiskManagement rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "07/09/2020" ;
                <http://purl.org/dc/terms/creator> "Rob" ;
                <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009" ;
                rdfs:comment "Coordinated activities to direct and control an organisation with regard to risk." ;
                rdfs:label "Risk Management" ;
                <http://www.w3.org/2004/02/skos#definition> "Coordinated activities to direct and control an organisation with regard to risk." ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Risk Management" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskManagementMeeting
:RiskManagementMeeting rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "12/09/2020" ;
                       <http://purl.org/dc/terms/creator> "Rob" ;
                       <http://purl.org/dc/terms/source> "HSE Part 3" ;
                       rdfs:label "Risk Management Meeting" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Risk Management Meeting" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#RiskManagementProcess
:RiskManagementProcess rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "07/09/2020" ;
                       <http://purl.org/dc/terms/creator> "Rob" ;
                       <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009, HSE Incident Management Framework - Guidance 2020" ;
                       rdfs:comment "The systematic application of management policies, policies and practices to the activities of communicating, consulting, establishing the context, and identifying, analysing, evaluating, treating, monitoring and reviewing risk" ;
                       rdfs:label "Risk Management Process" ;
                       <http://www.w3.org/2004/02/skos#definition> "The systematic application of management policies, policies and practices to the activities of communicating, consulting, establishing the context, and identifying, analysing, evaluating, treating, monitoring and reviewing risk" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Risk Management Process" .


