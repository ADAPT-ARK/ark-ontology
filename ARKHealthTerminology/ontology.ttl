###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AdverseEvent
:AdverseEvent rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "18/12/2020" ;
              <http://purl.org/dc/terms/creator> "Lucy" ;
              <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
              rdfs:comment "An incident which results in harm, which may or may not be the result of an error." ;
              rdfs:label "Adverse event" ;
              <http://www.w3.org/2004/02/skos#definition> "An incident which results in harm, which may or may not be the result of an error." ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Adverse event" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AdversePublicityOrReputation
:AdversePublicityOrReputation rdf:type owl:NamedIndividual ,
                                       <http://www.w3.org/2004/02/skos#Concept> ;
                              <http://purl.org/dc/terms/created> "08/09/2020" ;
                              <http://purl.org/dc/terms/creator> "Rob" ;
                              <http://purl.org/dc/terms/source> "HSE Part 2" ;
                              rdfs:comment "Adverse publicity in the media, loss of public confidence in a service or the organisation e.g. poor service performance." ;
                              rdfs:label "Adverse Publicity/Reputation" ;
                              <http://www.w3.org/2004/02/skos#definition> "Adverse publicity in the media, loss of public confidence in a service or the organisation e.g. poor service performance." ;
                              <http://www.w3.org/2004/02/skos#prefLabel> "Adverse Publicity/Reputation" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#AfterActionReview
:AfterActionReview rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "An After Action Review (AAR) is a structured facilitated discussion of an event, the outcome of which enables the individuals involved in the event to understand why the outcome differed from that which was expected and what learning can be identified to assist improvement" ;
                   rdfs:label "After Action Review" ;
                   <http://www.w3.org/2004/02/skos#definition> "An After Action Review (AAR) is a structured facilitated discussion of an event, the outcome of which enables the individuals involved in the event to understand why the outcome differed from that which was expected and what learning can be identified to assist improvement" ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "After Action Review" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Anticipate
:Anticipate rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "07/09/2020" ;
            <http://purl.org/dc/terms/creator> "Rob" ;
            <http://purl.org/dc/terms/source> "HSE Part 1" ;
            rdfs:comment "Anticipation involves thinking ahead and envisioning the things that are most likely to contribute to risk or safety failures. Safety from this perspective therefore involves looking ahead and identifying the hazards and risks that may cause harm if left unmanaged." ;
            rdfs:label "Anticipate" ;
            <http://www.w3.org/2004/02/skos#definition> "Anticipation involves thinking ahead and envisioning the things that are most likely to contribute to risk or safety failures. Safety from this perspective therefore involves looking ahead and identifying the hazards and risks that may cause harm if left unmanaged." ;
            <http://www.w3.org/2004/02/skos#prefLabel> "Anticipate" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Apology
:Apology rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos#Concept> ;
         <http://purl.org/dc/terms/created> "18/12/2020" ;
         <http://purl.org/dc/terms/creator> "Lucy" ;
         <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
         rdfs:comment "“Apology”, in relation to an open disclosure of a patient safety incident, means an expression of sympathy or regret.(Civil Liability (Amendment) Act 2017)It is a genuine expression of being sorry for what has happened." ;
         rdfs:label "Apology" ;
         <http://www.w3.org/2004/02/skos#definition> "“Apology”, in relation to an open disclosure of a patient safety incident, means an expression of sympathy or regret.(Civil Liability (Amendment) Act 2017)It is a genuine expression of being sorry for what has happened." ;
         <http://www.w3.org/2004/02/skos#prefLabel> "Apology" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Audit
:Audit rdf:type owl:NamedIndividual ,
                <http://www.w3.org/2004/02/skos#Concept> ;
       <http://purl.org/dc/terms/created> "07/09/2020" ,
                                          "08/09/2020" ,
                                          "18/12/2020" ;
       <http://purl.org/dc/terms/creator> "Lucy" ,
                                          "Rob" ;
       <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ,
                                         "HSE Part 1" ,
                                         "HSE Part 2" ;
       rdfs:comment "The assessment of performance against any standards and criteria (clinical and non-clinical) in a health, mental health or social care service" ;
       rdfs:label "Audit" ;
       <http://www.w3.org/2004/02/skos#definition> "The assessment of performance against any standards and criteria (clinical and non-clinical) in a health, mental health or social care service" ;
       <http://www.w3.org/2004/02/skos#prefLabel> "Audit" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Avoidance
:Avoidance rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos#Concept> ;
           <http://purl.org/dc/terms/created> "09/09/2020" ;
           <http://purl.org/dc/terms/creator> "Rob" ;
           <http://purl.org/dc/terms/source> "HSE Part 2" ;
           rdfs:label "Avoidance" ;
           <http://www.w3.org/2004/02/skos#prefLabel> "Avoidance" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#BestPractices
:BestPractices rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos#Concept> ;
               <http://purl.org/dc/terms/created> "18/12/2020" ;
               <http://purl.org/dc/terms/creator> "Lucy" ;
               <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
               rdfs:comment "Clinical, scientific or professional practices that are recognised by a majority of professionals in a particular field. These practices are typically evidence based and consensus-driven" ;
               rdfs:label "Best Practices" ;
               <http://www.w3.org/2004/02/skos#definition> "Clinical, scientific or professional practices that are recognised by a majority of professionals in a particular field. These practices are typically evidence based and consensus-driven" ;
               <http://www.w3.org/2004/02/skos#prefLabel> "Best Practices" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#BusinessContinuity
:BusinessContinuity rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "08/09/2020" ;
                    <http://purl.org/dc/terms/creator> "Rob" ;
                    <http://purl.org/dc/terms/source> "HSE Part 2" ;
                    rdfs:comment "Issues that would affect an organisations ability to provide service e.g. deregistration, fire, flood, ICT or electric outage, industrial strikes." ;
                    rdfs:label "Business Continuity" ;
                    <http://www.w3.org/2004/02/skos#definition> "Issues that would affect an organisations ability to provide service e.g. deregistration, fire, flood, ICT or electric outage, industrial strikes." ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Business Continuity" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#BusinessPlan
:BusinessPlan rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "07/09/2020" ;
              <http://purl.org/dc/terms/creator> "Rob" ;
              <http://purl.org/dc/terms/source> "HSE Part 1" ;
              rdfs:label "Business Plan" ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Business Plan" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Care
:Care rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos#Concept> ;
      <http://purl.org/dc/terms/created> "08/09/2020" ;
