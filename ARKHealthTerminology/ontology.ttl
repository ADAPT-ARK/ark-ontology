###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Category1Incident
:Category1Incident rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "Clinical and non-clinical incidents rated as Major or Extreme as per the HSE’s Risk Impact Table" ;
                   rdfs:label "Category 1 Incident" ;
                   <http://www.w3.org/2004/02/skos#definition> "Clinical and non-clinical incidents rated as Major or Extreme as per the HSE’s Risk Impact Table" ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "Category 1 Incident" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Category2Incident
:Category2Incident rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "Clinical and non-clinical incidents rated as Moderate as per the HSE’s Risk Impact Table" ;
                   rdfs:label "Category 2 Incident" ;
                   <http://www.w3.org/2004/02/skos#definition> "Clinical and non-clinical incidents rated as Moderate as per the HSE’s Risk Impact Table" ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "Category 2 Incident" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Category3Incident
:Category3Incident rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "Clinical and non-clinical incidents rated as Minor or Negligible as per the HSE’s Risk Impact Table" ;
                   rdfs:label "Category 3 Incident" ;
                   <http://www.w3.org/2004/02/skos#definition> "Clinical and non-clinical incidents rated as Minor or Negligible as per the HSE’s Risk Impact Table" ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "Category 3 Incident" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Claim
:Claim rdf:type owl:NamedIndividual ,
                <http://www.w3.org/2004/02/skos#Concept> ;
       <http://purl.org/dc/terms/created> "08/09/2020" ;
       <http://purl.org/dc/terms/creator> "Rob" ;
       <http://purl.org/dc/terms/source> "HSE Part 2" ;
       rdfs:label "Claim" ;
       <http://www.w3.org/2004/02/skos#prefLabel> "Claim" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ClinicalAudit
:ClinicalAudit rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos#Concept> ;
               <http://purl.org/dc/terms/created> "18/12/2020" ;
               <http://purl.org/dc/terms/creator> "Lucy" ;
               <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
               rdfs:comment "A quality improvement process that seeks to improve care and outcomes through systematic review of care against explicit criteria and the implementation of change" ;
               rdfs:label "Clinical audit" ;
               <http://www.w3.org/2004/02/skos#definition> "A quality improvement process that seeks to improve care and outcomes through systematic review of care against explicit criteria and the implementation of change" ;
               <http://www.w3.org/2004/02/skos#prefLabel> "Clinical audit" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ClinicalGovernance
:ClinicalGovernance rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "18/12/2020" ;
                    <http://purl.org/dc/terms/creator> "Lucy" ;
                    <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                    rdfs:comment "A system through which service providers are accountable for continuously improving the quality of their clinical practice and safeguarding high standards of care by creating an environment in which excellence in clinical care will flourish. This includes mechanisms for monitoring clinical quality and safety through structured programmes, for example, clinical audit." ;
                    rdfs:label "Clinical Governance" ;
                    <http://www.w3.org/2004/02/skos#definition> "A system through which service providers are accountable for continuously improving the quality of their clinical practice and safeguarding high standards of care by creating an environment in which excellence in clinical care will flourish. This includes mechanisms for monitoring clinical quality and safety through structured programmes, for example, clinical audit." ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Clinical Governance" .


