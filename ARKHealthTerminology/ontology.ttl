:OpenStatus rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "09/09/2020" ;
            <http://purl.org/dc/terms/creator> "Rob" ;
            <http://purl.org/dc/terms/source> "HSE Part 2" ;
            rdfs:label "Open" ;
            <http://www.w3.org/2004/02/skos#prefLabel> "Open" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#OperationalObjectives
:OperationalObjectives rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "08/09/2020" ;
                       <http://purl.org/dc/terms/creator> "Rob" ;
                       <http://purl.org/dc/terms/source> "HSE Part 2" ;
                       rdfs:label "Operational Objectives" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Operational Objectives" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#OperationalRisk
:OperationalRisk rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos#Concept> ;
                 <http://purl.org/dc/terms/created> "07/09/2020" ;
                 <http://purl.org/dc/terms/creator> "Rob" ;
                 <http://purl.org/dc/terms/source> "HSE Part 1/ISO 31000:2009" ;
                 rdfs:comment "Operational risks relate to the day-to-day delivery of activities, operational business plans and objectives. Operational risks typically have a short-term focus. Whilst they may impact a number of areas of the service, this does not necessarily make them a strategic risk. Operational risks may have the ability to impact strategic and other operational risks." ;
                 rdfs:label "Operational Risk" ;
                 <http://www.w3.org/2004/02/skos#definition> "Operational risks relate to the day-to-day delivery of activities, operational business plans and objectives. Operational risks typically have a short-term focus. Whilst they may impact a number of areas of the service, this does not necessarily make them a strategic risk. Operational risks may have the ability to impact strategic and other operational risks." ;
                 <http://www.w3.org/2004/02/skos#prefLabel> "Operational Risk" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#OrganisationalContext
:OrganisationalContext rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "08/09/2020" ;
                       <http://purl.org/dc/terms/creator> "Rob" ;
                       <http://purl.org/dc/terms/source> "HSE Part 2" ;
                       rdfs:label "Organisational Context" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Organisational Context" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafety
:PatientSafety rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos#Concept> ;
               <http://purl.org/dc/terms/created> "18/12/2020" ;
               <http://purl.org/dc/terms/creator> "Lucy" ;
               <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
               rdfs:comment "The term used nationally and internationally to describe the freedom from unnecessary harm or potential harm associated with healthcare services and the reduction of risk of unnecessary harm to an acceptable minimum (World Health Organisation, 2009). Where the term patient is used to describe ‘patient safety incident’, ‘quality and patient safety committees’ or ‘patient safety data’, it is intended to encompass all definitions of people who use health (including mental health) care services e.g. service users in both acute and community health care settings" ;
               rdfs:label "Patient Safety" ;
               <http://www.w3.org/2004/02/skos#definition> "The term used nationally and internationally to describe the freedom from unnecessary harm or potential harm associated with healthcare services and the reduction of risk of unnecessary harm to an acceptable minimum (World Health Organisation, 2009). Where the term patient is used to describe ‘patient safety incident’, ‘quality and patient safety committees’ or ‘patient safety data’, it is intended to encompass all definitions of people who use health (including mental health) care services e.g. service users in both acute and community health care settings" ;
               <http://www.w3.org/2004/02/skos#prefLabel> "Patient Safety" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafetyData
:PatientSafetyData rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "The broad and heterogeneous information that includes, but is not limited to, the description of incidents with medical errors or near misses, their causes, the follow-up corrective actions, interventions that reduce future risk, and patient safety hazards." ;
                   rdfs:label "Patient safety data" ;
                   <http://www.w3.org/2004/02/skos#definition> "The broad and heterogeneous information that includes, but is not limited to, the description of incidents with medical errors or near misses, their causes, the follow-up corrective actions, interventions that reduce future risk, and patient safety hazards." ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "Patient safety data" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PatientSafetyIncident
:PatientSafetyIncident rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "18/12/2020" ;
                       <http://purl.org/dc/terms/creator> "Lucy" ;
                       <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020" ;
                       rdfs:comment "A patient safety incident, in relation to the provision of a health service to a patient by a health services provider, means “an incident which occurs during the course of the provision of a health service”" ;
                       rdfs:label "Patient Safety Incident" ;
                       <http://www.w3.org/2004/02/skos#definition> "A patient safety incident, in relation to the provision of a health service to a patient by a health services provider, means “an incident which occurs during the course of the provision of a health service”" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Patient Safety Incident" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PerformanceMonitoring
:PerformanceMonitoring rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "08/09/2020" ;
                       <http://purl.org/dc/terms/creator> "Rob" ;
                       <http://purl.org/dc/terms/source> "HSE Part 2" ;
                       rdfs:label "Performance Monitoring" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Performance Monitoring" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Person
:Person rdf:type owl:NamedIndividual ,
                 <http://www.w3.org/2004/02/skos#Concept> ;
        <http://purl.org/dc/terms/created> "18/12/2020" ;
        <http://purl.org/dc/terms/creator> "Lucy" ;
        <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
        rdfs:comment "This refers to individual people e.g. service users, patients, members of staff, carers, relevant person(s) and visitors" ;
        rdfs:label "Person" ;
        <http://www.w3.org/2004/02/skos#definition> "This refers to individual people e.g. service users, patients, members of staff, carers, relevant person(s) and visitors" ;
        <http://www.w3.org/2004/02/skos#prefLabel> "Person" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PersonAffected
:PersonAffected rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "18/12/2020" ;
                <http://purl.org/dc/terms/creator> "Lucy" ;
                <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                rdfs:comment "This refers to individual people e.g. service users, patients, employees, carers, relevant persons and visitors that may be affected as a consequence of an incident occurring. Persons can be affected either directly or indirectly." ;
                rdfs:label "Person Affected" ;
                <http://www.w3.org/2004/02/skos#definition> "This refers to individual people e.g. service users, patients, employees, carers, relevant persons and visitors that may be affected as a consequence of an incident occurring. Persons can be affected either directly or indirectly." ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Person Affected" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PhysicalEnvironment
:PhysicalEnvironment rdf:type owl:NamedIndividual ,
                              <http://www.w3.org/2004/02/skos#Concept> ;
                     <http://purl.org/dc/terms/created> "08/09/2020" ;
                     <http://purl.org/dc/terms/creator> "Rob" ;
                     <http://purl.org/dc/terms/source> "HSE Part 2" ;
                     rdfs:label "Physical Environment" ;
                     <http://www.w3.org/2004/02/skos#prefLabel> "Physical Environment" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#PlanAction
:PlanAction rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "12/09/2020" ;
