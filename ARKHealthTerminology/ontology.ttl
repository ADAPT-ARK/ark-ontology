###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HarmToAPerson
:HarmToAPerson rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos#Concept> ;
               <http://purl.org/dc/terms/created> "07/09/2020" ,
                                                  "08/09/2020" ;
               <http://purl.org/dc/terms/creator> "Rob" ;
               <http://purl.org/dc/terms/source> "HSE Part 1" ,
                                                 "HSE Part 2" ;
               rdfs:comment "Any physical or psychological injury or damage to the health of a person, including both temporary and permanent injury" ,
                            "Physical or psychological injury related to a person i.e. service user, staff member or member of the public." ;
               rdfs:label "Harm to a Person" ,
                          "Harm to a person" ;
               <http://www.w3.org/2004/02/skos#definition> "Any physical or psychological injury or damage to the health of a person, including both temporary and permanent injury" ,
                                                           "Physical or psychological injury related to a person i.e. service user, staff member or member of the public." ;
               <http://www.w3.org/2004/02/skos#prefLabel> "Harm to a Person" ,
                                                          "Harm to a person" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HarmToAThing
:HarmToAThing rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "07/09/2020" ;
              <http://purl.org/dc/terms/creator> "Rob" ;
              <http://purl.org/dc/terms/source> "HSE Part 1" ;
              rdfs:comment "Damage to a thing may include damage to facilities or systems; for example environmental, financial, data protection breach, etc." ;
              rdfs:label "Harm to a thing" ;
              <http://www.w3.org/2004/02/skos#definition> "Damage to a thing may include damage to facilities or systems; for example environmental, financial, data protection breach, etc." ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Harm to a thing" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Hazard
