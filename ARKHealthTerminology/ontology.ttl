###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Monitoring
:Monitoring rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos#Concept> ;
            <http://purl.org/dc/terms/created> "18/12/2020" ;
            <http://purl.org/dc/terms/creator> "Lucy" ;
            <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
            rdfs:comment "Systematic process of gathering information and tracking change over time. Monitoring provides a verification of progress towards achievement of objectives and goals" ;
            rdfs:label "Monitoring" ;
            <http://www.w3.org/2004/02/skos#definition> "Systematic process of gathering information and tracking change over time. Monitoring provides a verification of progress towards achievement of objectives and goals" ;
            <http://www.w3.org/2004/02/skos#prefLabel> "Monitoring" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#NationalIncidentReportingForm
:NationalIncidentReportingForm rdf:type owl:NamedIndividual ,
                                        <http://www.w3.org/2004/02/skos#Concept> ;
                               <http://purl.org/dc/terms/created> "18/12/2020" ;
                               <http://purl.org/dc/terms/creator> "Lucy" ;
                               <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                               rdfs:comment "The National Incident Report Form (NIRF) was developed by the State Claims Agency in conjunction with all stakeholders including the HSE and voluntary hospitals. Use of a NIRF assures the accuracy of data and clarity of information being reported. There are four forms in total; Person, Property, Crash/Collision and Dangerous Occurrences/Reportable Circumstance i.e. Dangerous Occurrences/Reportable Circumstances." ;
                               rdfs:label "National Incident Reporting Form" ;
                               <http://www.w3.org/2004/02/skos#definition> "The National Incident Report Form (NIRF) was developed by the State Claims Agency in conjunction with all stakeholders including the HSE and voluntary hospitals. Use of a NIRF assures the accuracy of data and clarity of information being reported. There are four forms in total; Person, Property, Crash/Collision and Dangerous Occurrences/Reportable Circumstance i.e. Dangerous Occurrences/Reportable Circumstances." ;
                               <http://www.w3.org/2004/02/skos#prefLabel> "National Incident Reporting Form" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#NationalSurvey
:NationalSurvey rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "08/09/2020" ;
                <http://purl.org/dc/terms/creator> "Rob" ;
                <http://purl.org/dc/terms/source> "HSE Part 2" ;
                rdfs:label "National Survey" ;
                <http://www.w3.org/2004/02/skos#prefLabel> "National Survey" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#NearMiss
:NearMiss rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos#Concept> ;
          <http://purl.org/dc/terms/created> "18/12/2020" ;
          <http://purl.org/dc/terms/creator> "Lucy" ;
          <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
          rdfs:comment "An incident that was prevented from occurring due to timely intervention or chance and which there are reasonable grounds for believing could have resulted, if it had not been so prevented, in unintended or unanticipated injury or harm to a service user during the provision of a health service to that service user.(National Standards for the Conduct of Reviews of Patient Safety Incidents)" ;
          rdfs:label "Near Miss" ;
          <http://www.w3.org/2004/02/skos#definition> "An incident that was prevented from occurring due to timely intervention or chance and which there are reasonable grounds for believing could have resulted, if it had not been so prevented, in unintended or unanticipated injury or harm to a service user during the provision of a health service to that service user.(National Standards for the Conduct of Reviews of Patient Safety Incidents)" ;
          <http://www.w3.org/2004/02/skos#prefLabel> "Near Miss" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#NoHarmIncident
:NoHarmIncident rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "18/12/2020" ;
                <http://purl.org/dc/terms/creator> "Lucy" ;
                <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                rdfs:comment "An incident occurs which reaches the service user but results in no injury to the service user. Harm is avoided by chance or because of mitigating circumstances." ;
                rdfs:label "No Harm Incident" ;
                <http://www.w3.org/2004/02/skos#definition> "An incident occurs which reaches the service user but results in no injury to the service user. Harm is avoided by chance or because of mitigating circumstances." ;
                <http://www.w3.org/2004/02/skos#prefLabel> "No Harm Incident" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ObjectivesAndProjects
:ObjectivesAndProjects rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "08/09/2020" ;
                       <http://purl.org/dc/terms/creator> "Rob" ;
                       <http://purl.org/dc/terms/source> "HSE Part 2" ;
                       rdfs:comment "Project slippage and failure to meet objectives of projects." ;
                       rdfs:label "Objectives and Projects" ;
                       <http://www.w3.org/2004/02/skos#definition> "Project slippage and failure to meet objectives of projects." ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Objectives and Projects" .


