###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HealthInformation
:HealthInformation rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos#Concept> ;
                   <http://purl.org/dc/terms/created> "18/12/2020" ;
                   <http://purl.org/dc/terms/creator> "Lucy" ;
                   <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                   rdfs:comment "Information, recorded in any form, which is created or communicated by an organisation or individual relating to the past, present or future, physical or mental health or social care of an individual (also referred to as a cohort). Health information also includes information relating to the management of the health care system." ;
                   rdfs:label "Health Information" ;
                   <http://www.w3.org/2004/02/skos#definition> "Information, recorded in any form, which is created or communicated by an organisation or individual relating to the past, present or future, physical or mental health or social care of an individual (also referred to as a cohort). Health information also includes information relating to the management of the health care system." ;
                   <http://www.w3.org/2004/02/skos#prefLabel> "Health Information" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HealthServiceProvider
:HealthServiceProvider rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos#Concept> ;
                       <http://purl.org/dc/terms/created> "18/12/2020" ;
                       <http://purl.org/dc/terms/creator> "Lucy" ;
                       <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
                       rdfs:comment "(a) a person, other than a health practitioner, who provides one or more health services (b) a health practitioner who, or a partnership which, provides a health service and does not provide that health service for, or on behalf of, or through or in connection with (whether by reason of employment or otherwise), a person referred to in paragraph (a)" ;
                       rdfs:label "Health Service Provider" ;
                       <http://www.w3.org/2004/02/skos#definition> "(a) a person, other than a health practitioner, who provides one or more health services (b) a health practitioner who, or a partnership which, provides a health service and does not provide that health service for, or on behalf of, or through or in connection with (whether by reason of employment or otherwise), a person referred to in paragraph (a)" ;
                       <http://www.w3.org/2004/02/skos#prefLabel> "Health Service Provider" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#HumanFactors
:HumanFactors rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "18/12/2020" ;
              <http://purl.org/dc/terms/creator> "Lucy" ;
              <http://purl.org/dc/terms/source> "HSE Incident Management Framework - Guidance 2020" ;
              rdfs:comment "An understanding of human limitations, designing the workplace and the equipment healthcare providers use to allow for variability in humans and human performance." ;
              rdfs:label "Human Factors" ;
              <http://www.w3.org/2004/02/skos#definition> "An understanding of human limitations, designing the workplace and the equipment healthcare providers use to allow for variability in humans and human performance." ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Human Factors" .


