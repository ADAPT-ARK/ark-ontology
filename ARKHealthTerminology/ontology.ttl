        rdfs:label "Review" ;
        <http://www.w3.org/2004/02/skos#prefLabel> "Review" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#ReviewCommissioner
:ReviewCommissioner rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "18/12/2020" ;
                    <http://purl.org/dc/terms/creator> "Lucy" ;
                    <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                    rdfs:comment "The person who commissions an incident review. For Category 1 incidents it is the Senior Accountable Officer (SAO) or person who has a direct reporting relationship to the SAO. For Category 2 incidents it is the Local Accountable Officer." ;
                    rdfs:label "Review Commissioner" ;
                    <http://www.w3.org/2004/02/skos#definition> "The person who commissions an incident review. For Category 1 incidents it is the Senior Accountable Officer (SAO) or person who has a direct reporting relationship to the SAO. For Category 2 incidents it is the Local Accountable Officer." ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Review Commissioner" .


