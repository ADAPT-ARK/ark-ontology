<https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#> rdf:type owl:Ontology ;
                                                               <http://purl.org/dc/terms/abstract> "Health terminologies used in ARK" ;
                                                               <http://purl.org/dc/terms/contributor> "Rob Brennan" ;
                                                               <http://purl.org/dc/terms/description> "This ontology defines the health terminologies, taken from the HSE Integrated Risk Management Policy and the HSE Integrated Risk Management Framework, used in the ARK system" ;
                                                               <http://purl.org/dc/terms/title> "ARK Health terminologies" ;
                                                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "ARKHealthTerms" ;
                                                               <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#" ;
                                                               rdfs:comment "Health terminologies used in ARK" ,
                                                                            "This ontology defines the health terminologies, taken from the HSE Integrated Risk Management Policy and the HSE Integrated Risk Management Framework, used in the ARK system" ;
                                                               owl:versionInfo "0.1" .

