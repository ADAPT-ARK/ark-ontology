###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#Incident
:Incident rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos#Concept> ;
          <http://purl.org/dc/terms/created> "08/09/2020" ;
          <http://purl.org/dc/terms/creator> "Rob" ;
          <http://purl.org/dc/terms/source> "HSE Part 2/HSE Incident Management Framework/HSE Incident Management Framework - Guidance 2020" ;
          rdfs:comment "An event or circumstance which could have, or did, lead to unintended and/or unnecessary harm. Incidents include adverse events which result in harm; near-misses which could have resulted in harm, but did not cause harm, either by chance or timely intervention; and staff or service user complaints which are associated with harm." ;
          rdfs:label "Incident" ;
          <http://www.w3.org/2004/02/skos#definition> "An event or circumstance which could have, or did, lead to unintended and/or unnecessary harm. Incidents include adverse events which result in harm; near-misses which could have resulted in harm, but did not cause harm, either by chance or timely intervention; and staff or service user complaints which are associated with harm." ;
          <http://www.w3.org/2004/02/skos#prefLabel> "Incident" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#IncidentManagement
:IncidentManagement rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "07/09/2020" ;
                    <http://purl.org/dc/terms/creator> "Rob" ;
                    <http://purl.org/dc/terms/source> "HSE Part 1" ;
                    rdfs:label "Incident Management" ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Incident Management" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#IncidentReview
:IncidentReview rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos#Concept> ;
                <http://purl.org/dc/terms/created> "18/12/2020" ;
                <http://purl.org/dc/terms/creator> "Lucy" ;
                <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                rdfs:comment "Incident review involves a structured analysis and is conducted using best practice methods, to determine what happened, how it happened, why it happened, and whether there are learning points for the service, wider organisation, or nationally" ;
                rdfs:label "Incident Review" ;
                <http://www.w3.org/2004/02/skos#definition> "Incident review involves a structured analysis and is conducted using best practice methods, to determine what happened, how it happened, why it happened, and whether there are learning points for the service, wider organisation, or nationally" ;
                <http://www.w3.org/2004/02/skos#prefLabel> "Incident Review" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#IncidentType
:IncidentType rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos#Concept> ;
              <http://purl.org/dc/terms/created> "18/12/2020" ;
              <http://purl.org/dc/terms/creator> "Lucy" ;
              <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
              rdfs:comment "A descriptive term for a category made up of incidents of a common nature grouped because of shared, agreed features" ;
              rdfs:label "Incident type" ;
              <http://www.w3.org/2004/02/skos#definition> "A descriptive term for a category made up of incidents of a common nature grouped because of shared, agreed features" ;
              <http://www.w3.org/2004/02/skos#prefLabel> "Incident type" .


###  https://ark.adaptcentre.ie/Ontologies/ARKHealthTerminology#IncidentalFindings
:IncidentalFindings rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos#Concept> ;
                    <http://purl.org/dc/terms/created> "18/12/2020" ;
                    <http://purl.org/dc/terms/creator> "Lucy" ;
                    <http://purl.org/dc/terms/source> "HSE Incident Management Framework 2020 / HSE Incident Management Framework - Guidance 2020" ;
                    rdfs:comment "Issue(s) that arose in the process of delivering and managing health services identified during the course of a review which the reviewers consider did not impact on the outcomes but which serve to identify issues for system improvement e.g. issues relating to documentation, communications etc" ;
                    rdfs:label "Incidental Findings" ;
                    <http://www.w3.org/2004/02/skos#definition> "Issue(s) that arose in the process of delivering and managing health services identified during the course of a review which the reviewers consider did not impact on the outcomes but which serve to identify issues for system improvement e.g. issues relating to documentation, communications etc" ;
                    <http://www.w3.org/2004/02/skos#prefLabel> "Incidental Findings" .


