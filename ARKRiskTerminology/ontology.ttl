                <http://www.w3.org/2004/02/skos/core#prefLabel> "Recommendation" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Recovery
:Recovery rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ;
          <http://purl.org/dc/terms/source> "COSO" ;
          <http://www.w3.org/2004/02/skos/core#definition> "the capacity of an entity to return to tolerance" ;
          <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Recovery" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Reporting
:Reporting rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ;
           <http://purl.org/dc/terms/created> "30/07/2019" ;
           <http://purl.org/dc/terms/creator> "Natalie" ;
           <http://purl.org/dc/terms/source> "dictionary" ;
           <http://www.w3.org/2004/02/skos/core#definition> "A written or spoken account of something that has been done/observed/investigated" ;
           <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Reporting" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#ReportingProcedures
:ReportingProcedures rdf:type owl:NamedIndividual ,
                              <http://www.w3.org/2004/02/skos/core#Concept> ;
                     <http://purl.org/dc/terms/created> "30/07/2019" ;
                     <http://purl.org/dc/terms/creator> "Natalie" ;
                     <http://purl.org/dc/terms/source> "EASA SMS/dictionary" ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A series of actions conducted in a certain manner- a system in which reports are evaluated, processed (within defined time scales), analysed and strored, with feedback about actions taken/not taken " ;
                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Reporting Procedures" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Representation
:Representation rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://purl.org/dc/terms/created> "30/07/2019" ;
                <http://purl.org/dc/terms/creator> "Natalie" ;
                <http://purl.org/dc/terms/source> "CUBE papers" ;
                <http://www.w3.org/2004/02/skos/core#definition> "The description or portrayal of data in a particular way" ;
                <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Representation" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#ReputationRisk
:ReputationRisk rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://purl.org/dc/terms/source> "COSO" ;
                <http://www.w3.org/2004/02/skos/core#definition> "unacceptable differences between how an organization wants and needs to be perceived and how it is actually perceived" ;
                <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Reputation Risk" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Resillience
:Resillience rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos/core#Concept> ;
             <http://purl.org/dc/terms/source> "COSO" ;
             <http://www.w3.org/2004/02/skos/core#definition> "the ability to ancitipate and respond to change; the ability to anticipate and respond to a complex and interconnected array of risks that threaten the strategy and objectives." ;
             <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Resillience" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#ResourceAllocation
:ResourceAllocation rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                    <http://purl.org/dc/terms/created> "30/07/2019" ;
                    <http://purl.org/dc/terms/creator> "Natalie" ;
                    <http://purl.org/dc/terms/source> "EASA SMS" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The provision and distribution of assets (personnel, equipment, financial) necessary for the implementaion of safety policy " ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Resource allocation" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#ResponsibilityAllocation
:ResponsibilityAllocation rdf:type owl:NamedIndividual ,
                                   <http://www.w3.org/2004/02/skos/core#Concept> ;
                          <http://www.w3.org/2004/02/skos/core#definition> "?" ;
                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Responsibility Allocation" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Review
:Review rdf:type owl:NamedIndividual ,
                 <http://www.w3.org/2004/02/skos/core#Concept> ;
        <http://purl.org/dc/terms/created> "30/07/2019" ;
        <http://purl.org/dc/terms/creator> "Natalie" ;
        <http://purl.org/dc/terms/source> "EASA SMS/dictionary" ;
        <http://www.w3.org/2004/02/skos/core#definition> "Critical appraisal, re-evaluation or formal assessment (of policy) with the intention of ensuring relevance and introducing change, if necessary" ;
        <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Review" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Risk
:Risk rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://purl.org/dc/terms/source> "ISO" ;
      <http://www.w3.org/2004/02/skos/core#definition> "The possibility that events will occur and affect the achievement of an objective; the effect of uncertainty on objectives of an organization, usually expressed in terms of resources, potential events and their consequences.  " ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskAcceptability
:RiskAcceptability rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                   <http://purl.org/dc/terms/created> "30/07/2019" ;
                   <http://purl.org/dc/terms/creator> "Natalie" ;
                   <http://purl.org/dc/terms/source> "EASA" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The level or risk an organization is willing to tolerate" ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Acceptability" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskAppetite
:RiskAppetite rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ;
              <http://purl.org/dc/terms/source> "ISO/COSO" ;
              <http://www.w3.org/2004/02/skos/core#definition> "amount and type of risk that the organization is willing to accept or reject in pursuit of value/ its objectives." ;
              <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Appetite" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskAssessment
:RiskAssessment rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://www.w3.org/2004/02/skos/core#definition> "Includes the identification of risks, analysis of risk in terms of likelihood and consequences, and evaluation or risks in relation to established criteria (risk appetite) to determine wgether additional action is required. " ;
                <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Assessment" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskInChange
:RiskInChange rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ;
              <http://purl.org/dc/terms/created> "30/07/2019" ;
              <http://purl.org/dc/terms/creator> "Nick/Natalie" ;
              <http://purl.org/dc/terms/source> "Nick" ;
              <http://www.w3.org/2004/02/skos/core#definition> "Risk in improvement and change activities themselves" ;
              <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk in Change" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskManagementProcess
:RiskManagementProcess rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                       <http://purl.org/dc/terms/source> "COSO" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "involves the systematic application of policies, procedures and practices to the activities of communicating and consulting, establishing the context and assessing, treating, monitoring, reviewing, recording and reporting risk" ;
                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Management Process" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskManagementProtocol
:RiskManagementProtocol rdf:type owl:NamedIndividual ,
                                 <http://www.w3.org/2004/02/skos/core#Concept> ;
                        <http://purl.org/dc/terms/source> "COSO" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "tools/techniques, risk classification, assessment procedures, responding fo incidents and events, documentation, training and communication, audit procedures" ;
                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Management Protocol" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskManagementStrategy
:RiskManagementStrategy rdf:type owl:NamedIndividual ,
                                 <http://www.w3.org/2004/02/skos/core#Concept> ;
                        <http://purl.org/dc/terms/source> "COSO" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "arrangements for embedding RM, risk appetite/attitude to risk, specific risk statements/policies, assessment techniques, risk priorities" ;
                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Management Strategy" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskMitigation
:RiskMitigation rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://www.w3.org/2004/02/skos/core#definition> "strategy to prepare for and lessen the effects of all potential risks/ threats; takes steps to reduce the negative effects of threats and disasters on business" ;
                <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Mitigation" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskMitigationPlanning
:RiskMitigationPlanning rdf:type owl:NamedIndividual ,
                                 <http://www.w3.org/2004/02/skos/core#Concept> ;
                        <http://www.w3.org/2004/02/skos/core#definition> """Risk mitigation planning is the process of developing options and actions to enhance opportunities and reduce threats to project objectives
""" ;
                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Mitigation Planning" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskProfile
:RiskProfile rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos/core#Concept> ;
             <http://purl.org/dc/terms/source> "COSO" ;
             <http://www.w3.org/2004/02/skos/core#definition> "A composite view of the risk assumed at a particular level of the entity, or aspect of the business that positions management to consider the types, severity and interdependencies of risks and how they may affect performance relative to the strategy and business objectives" ;
             <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Profile" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskSeverity
:RiskSeverity rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ;
              <http://purl.org/dc/terms/source> "COSO" ;
              <http://www.w3.org/2004/02/skos/core#definition> "A measurement of considerations such as the likelihood and impact of events or the time it takes to recover from events." ;
              <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk severity" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#RiskTolerance
:RiskTolerance rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos/core#Concept> ;
               <http://purl.org/dc/terms/source> "COSO Enterprise Risk Management | Applying enterprise risk management to environmental, social and governance-related risks • October 2018" ;
