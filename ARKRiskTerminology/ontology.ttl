###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Accountability
:Accountability rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://purl.org/dc/terms/created> "30/07/2019" ;
                <http://purl.org/dc/terms/creator> "Natalie" ;
                <http://purl.org/dc/terms/source> "CUBE/Governance papers" ;
                <http://www.w3.org/2004/02/skos/core#definition> "The obligation to be responsible for, to report or to justify something." ;
                <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Accountability" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Adaptability
:Adaptability rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ;
              <http://purl.org/dc/terms/source> "COSO" ;
              <http://www.w3.org/2004/02/skos/core#definition> "the capacity of an entity to adapt and respond to risks" ;
              <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Adaptability" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Assessment
:Assessment rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ;
            <http://purl.org/dc/terms/created> "30/07/2019" ;
            <http://purl.org/dc/terms/creator> "Natalie" ;
            <http://purl.org/dc/terms/source> "dictionary" ;
            <http://www.w3.org/2004/02/skos/core#definition> "An apparaisal/valuation of something (risk)" ;
            <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Assessment" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#Awareness
:Awareness rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ;
           <http://purl.org/dc/terms/created> "30/07/2019" ;
           <http://purl.org/dc/terms/creator> "Natalie" ;
           <http://purl.org/dc/terms/source> "dictionary" ;
           <http://www.w3.org/2004/02/skos/core#definition> "Being conscious of or knowledge of something" ;
           <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Awareness" .


###  https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#BusinessContinuity
:BusinessContinuity rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                    <http://purl.org/dc/terms/source> "COSO" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "inability to prevent, detect or correct business outages within established limits" ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://ark.adaptcentre.ie/Ontologies/ARKRiskTerminology#> ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Business Continuity" .


