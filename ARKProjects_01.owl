    <!-- https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasCollaborator -->

    <owl:ObjectProperty rdf:about="https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasCollaborator">
        <owl:inverseOf rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#isCollaboratorOf"/>
        <rdfs:domain rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <dc:description xml:lang="en">Relates the Project with its collaborating User. The collaborator has a read/write/add subproject rights but not grant rights.</dc:description>
        <rdfs:comment xml:lang="en">Relates the Project with its collaborating User. The collaborator has a read/write/add subproject rights but not grant rights.</rdfs:comment>
        <rdfs:label xml:lang="en">has collaborator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasOwner -->

    <owl:ObjectProperty rdf:about="https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasOwner">
        <owl:inverseOf rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#isOwnerOf"/>
        <rdfs:domain rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <dc:description xml:lang="en">Relates the Project with its owner User. The owner has a full read/write/grant access rights.</dc:description>
        <rdfs:comment xml:lang="en">Relates the Project with its owner User. The owner has a full read/write/grant access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">has owner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasProjectAnalysis -->

    <owl:ObjectProperty rdf:about="https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasProjectAnalysis">
