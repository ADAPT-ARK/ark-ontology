    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasCollaborator -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasCollaborator">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isCollaboratorOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <rdfs:comment xml:lang="en">Relates the Project with its collaborating User. The collaborator has a read/write/add subproject rights but not grant rights.</rdfs:comment>
        <rdfs:label xml:lang="en">has collaborator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasOwner -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasOwner">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isOwnerOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <rdfs:comment xml:lang="en">Relates the Project with its owner User. The owner has a full read/write/grant access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">has owner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasProjectAnalysis -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasProjectAnalysis">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isProjectAnalysisOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:comment xml:lang="en">Relates a Project with all the analysis done on the Project.</rdfs:comment>
        <rdfs:label xml:lang="en">has project analysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasReadOnlyUser -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasReadOnlyUser">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isReadOnlyUserOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <rdfs:comment xml:lang="en">Relates the Project with its ReadOnlyUser. The readonly user can view a specific Project but has no grant right.</rdfs:comment>
        <rdfs:label xml:lang="en">has readonly user</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasSubProject -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#hasSubProject">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isSubProjectOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:comment xml:lang="en">Relate a Project with its subproject. A Project can have one or more subprojects within it.</rdfs:comment>
        <rdfs:label xml:lang="en">has subproject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#isCollaboratorOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isCollaboratorOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:comment xml:lang="en">Relates the collaborating User with a project. </rdfs:comment>
        <rdfs:label xml:lang="en">is collaborator of</rdfs:label>
        <owl:inverseOf>hasCollaborator</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#isOwnerOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isOwnerOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:comment xml:lang="en">Relates the Owner User with a Project. The owner has a full read/write/grant access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">is owner of</rdfs:label>
        <owl:inverseOf>hasOwner</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#isProjectAnalysisOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isProjectAnalysisOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:comment xml:lang="en">Relates a Project Analysis with its Project.</rdfs:comment>
        <rdfs:label xml:lang="en">is project analysis of</rdfs:label>
        <owl:inverseOf>hasProjectAnalysis</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#isReadOnlyUserOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isReadOnlyUserOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:comment xml:lang="en">Relates the ReadOnlyUser with a Project. </rdfs:comment>
        <rdfs:label xml:lang="en">is readonlyuser of</rdfs:label>
        <owl:inverseOf>hasReadOnlyUser</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#isSubProjectOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#isSubProjectOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:comment xml:lang="en">Relates a project with its parent Project.</rdfs:comment>
        <rdfs:label xml:lang="en">is subproject of</rdfs:label>
        <owl:inverseOf>hasSubProject</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#&apos;has_data_classification&apos; -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#&apos;has_data_classification&apos;">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment>Ascribes a data classification level to an Entity.</rdfs:comment>
        <rdfs:label>has data classification</rdfs:label>
    </owl:ObjectProperty>
    


