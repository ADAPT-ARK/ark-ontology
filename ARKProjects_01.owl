    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#dataStatus -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#dataStatus">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The status of the data. Deleted  when the data is deleted by the user</rdfs:comment>
        <rdfs:label xml:lang="en">data status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#designedBy -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#designedBy">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The user who designed the project.</rdfs:comment>
        <rdfs:label xml:lang="en">designed by</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#efficacy -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#efficacy">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The efficacy of the solution.</rdfs:comment>
        <rdfs:label xml:lang="en">efficacy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#importance -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#importance">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">Importance of the problem under analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">importance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#name -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#name">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The name of a project</rdfs:comment>
        <rdfs:label xml:lang="en">project name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#organisationName -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#organisationName">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The name of the organisation </rdfs:comment>
        <rdfs:label xml:lang="en">organisation name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#potentialLoss -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#potentialLoss">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">Potential loss due to the problem.</rdfs:comment>
        <rdfs:label xml:lang="en">potential loss</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#projectedGain -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#projectedGain">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The gain achieved by the project.</rdfs:comment>
        <rdfs:label xml:lang="en">projected gain</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#projectedValue -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#projectedValue">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The projected value of the project.</rdfs:comment>
        <rdfs:label xml:lang="en">projected value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#reportTo -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#reportTo">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The person to whom the analysis is reported to.</rdfs:comment>
        <rdfs:label xml:lang="en">report to</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#status -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#status">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The current status of a project</rdfs:comment>
        <rdfs:label xml:lang="en">project Status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#value -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#value">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">An entity’s value is created, preserved, eroded or realized based on the relationship between the benefits derived from resources deployed and the cost of those resources.</rdfs:comment>
        <rdfs:label xml:lang="en">value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#viability -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#viability">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">Viability of the proposed solution.</rdfs:comment>
        <rdfs:label xml:lang="en">viablity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Person -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defines a person, for example in an organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#AdminUser -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#AdminUser">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <dc:creator>Ademar</dc:creator>
        <rdfs:comment>An admin user has access to all projects.</rdfs:comment>
        <rdfs:label>AdminUser</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#Confidential -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Confidential">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Confidential information is defined as information which is protected by Irish and/or E.U. legislation or regulations, HSE policies or legal contracts. The unauthorised or accidental disclosure of this information could adversely impact the organisation, its patients, its staff and its business partners.</rdfs:comment>
        <rdfs:label xml:lang="en">Confidential</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Use to classifiy the sensitivity of data e.g., a project, an analysis or part of an analysis.  Data classification values are adapted from the HSE Information Classification &amp; Handling Policy.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Classification</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity">
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">A data entity can be Project, a Project Analysis, a Risk, a Cube question or any other unit of data..</rdfs:comment>
        <rdfs:label xml:lang="en">Data Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#Internal -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Internal">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Internal information is defined as information that is only intended for internal distribution within an organisation. In the majority of instances there would be no significant impact on the organisation, its staff, clients or patients if this type of information was mishandled or accidentally released.</rdfs:comment>
        <rdfs:label xml:lang="en">Internal</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#Personal -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Personal">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Restricted"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Restricted information that contains personal data. Personal data, as defined by the General Data Protection Regulation (GDPR), is any data that relates to a person or that could be used to identify a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Project">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity"/>
        <rdfs:comment xml:lang="en">An individual or collaborative enterprise that is carefully planned to achieve a particular aim.</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataEntity"/>
        <rdfs:comment xml:lang="en">Project analysis is a high-level ark project analysis used to identify values, loss, efficacy etc</rdfs:comment>
        <rdfs:label xml:lang="en">Project Analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#Public -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Public">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Public information is defined as information that is available to the general public and is intended for distribution outside an organisation. There would be no impact on the organisation, its staff, clients or patients if this type of information was mishandled or accidentally released.</rdfs:comment>
        <rdfs:label xml:lang="en">Public</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#Restricted -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Restricted">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Restricted information is defined as highly sensitive confidential information. The unauthorised or accidental disclosure of this information would seriously and adversely impact the organisation, its patients, its staff and its business partners.</rdfs:comment>
        <rdfs:label xml:lang="en">Restricted</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#SpecialCategory -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#SpecialCategory">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects#Personal"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Special Category personal data, as defined by the General Data Protection Regulation (GDPR) Article 9, is any information that reveals a person&apos;s race, ethnic origin, political opinion, religious or philosophical beliefes, trade union membership, genetic data, biometric data for the purpose of uniquely identifying a natural person, data concerning health or data concerning a natural person’s sex life or sexual orientation.</rdfs:comment>
        <rdfs:label xml:lang="en">Special Category</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKProjects#User -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#User">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
        <dc:description xml:lang="en">The user of the ARK projects application</dc:description>
        <rdfs:comment xml:lang="en">The user of the project can take three types. Owner, Collaborator, ReadOnlyUser</rdfs:comment>
        <rdfs:label xml:lang="en">User</rdfs:label>
    </owl:Class>
    


