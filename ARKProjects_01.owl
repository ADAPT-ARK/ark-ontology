        <rdfs:range rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#User"/>
        <dc:description xml:lang="en">Relates the Project with its ReadOnlyUser. The readonly user can view a specific Project but has no grant right.</dc:description>
        <rdfs:comment xml:lang="en">Relates the Project with its ReadOnlyUser. The readonly user can view a specific Project but has no grant right.</rdfs:comment>
        <rdfs:label xml:lang="en">has readonly user</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ark.adaptcentre.ie/Ontologies/ARKProjects#hasSubProject -->

