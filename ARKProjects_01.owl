        <rdfs:range rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKProjects#ProjectAnalysis"/>
        <dc:description xml:lang="en">Relates a Project with all the analysis done on the Project.</dc:description>
        <rdfs:comment xml:lang="en">Relates a Project with all the analysis done on the Project.</rdfs:comment>
        <rdfs:label xml:lang="en">has project analysis</rdfs:label>
    </owl:ObjectProperty>
    


