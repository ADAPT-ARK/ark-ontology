<?xml version="1.0"?>
<rdf:RDF xmlns="https://ark.adaptcentre.ie/Ontologies/ARKProjects#"
     xml:base="https://ark.adaptcentre.ie/Ontologies/ARKProjects"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:vocab="http://purl.org/vocab/vann/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKProjects#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKProjects"/>
        <dc:modified>18/04/2020</dc:modified>
        <dc:creator>Yalemisew Abgaz</dc:creator>
        <dc:publisher>https://www.ark.adaptcentre.ie/</dc:publisher>
        <dc:description xml:lang="en">A model for representing concepts, relationships and axioms for Access Risk Knowledge for organisational risk analysis and management.</dc:description>
        <dc:contributor>Junli Liang</dc:contributor>
        <dc:contributor>Ademar Crotti Junior</dc:contributor>
        <dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
        <dc:contributor>Nick McDonald</dc:contributor>
        <dc:contributor>Rob Brennan</dc:contributor>
        <dc:title xml:lang="en">Access Risk Knowledge Projects Ontology</dc:title>
        <owl:versionInfo>0.2</owl:versionInfo>
        <vocab:preferredNamespacePrefix>ARKP</vocab:preferredNamespacePrefix>
        <dc:contributor>Lucy McKenna</dc:contributor>
        <dcterms:rights rdf:resource="https://creativecommons.org/licenses/by/3.0/at/deed.en"/>
        <vocab:preferredNamespaceUri>https://ark.adaptcentre.ie/Ontologies/ARKProjects#</vocab:preferredNamespaceUri>
        <dc:contributor>Natalia Duda</dc:contributor>
    </owl:Ontology>
    


