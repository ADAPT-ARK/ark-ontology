    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasCollaborator -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasCollaborator">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isCollaboratorOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:comment xml:lang="en">Relates the Project with its collaborating User. The collaborator has a read/write/add subproject rights but not grant rights.</rdfs:comment>
        <rdfs:label xml:lang="en">has collaborator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasOwner -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasOwner">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isOwnerOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:comment xml:lang="en">Relates the Project with its owner User. The owner has a full read/write/grant access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">has owner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasOwningOrganisation -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasOwningOrganisation">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Links a project to its owning organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">has owning organisation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasPlatformRole -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasPlatformRole">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Links a User to their Platform Role.</rdfs:comment>
        <rdfs:label xml:lang="en">has platform role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasReadOnlyUser -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#hasReadOnlyUser">
        <owl:inverseOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isReadOnlyUserOf"/>
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:comment xml:lang="en">Relates the Project with its ReadOnlyUser. The readonly user can view a specific Project but has no grant right.</rdfs:comment>
        <rdfs:label xml:lang="en">has readonly user</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isCollaboratorOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isCollaboratorOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:comment xml:lang="en">Relates the collaborating User with a project. </rdfs:comment>
        <rdfs:label xml:lang="en">is collaborator of</rdfs:label>
        <owl:inverseOf>hasCollaborator</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isOwnerOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isOwnerOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:comment xml:lang="en">Relates the Owner User with a Project. The owner has a full read/write/grant access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">is owner of</rdfs:label>
        <owl:inverseOf>hasOwner</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isReadOnlyUserOf -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#isReadOnlyUserOf">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
        <rdfs:comment xml:lang="en">Relates the ReadOnlyUser with a Project. </rdfs:comment>
        <rdfs:label xml:lang="en">is readonly user of</rdfs:label>
        <owl:inverseOf>hasReadOnlyUser</owl:inverseOf>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#&apos;has_data_classification&apos; -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#&apos;has_data_classification&apos;">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment>Ascribes a data classification level to an Entity.</rdfs:comment>
        <rdfs:label>has data classification</rdfs:label>
    </owl:ObjectProperty>
    


