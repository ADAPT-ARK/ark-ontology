     xmlns:arkp="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform"/>
        <dc:modified>18/04/2020</dc:modified>
        <dc:description xml:lang="en">An ontology for modelling for users, data classification &amp; access controls on the Access Risk Knowledge (ARK) Platform.</dc:description>
        <dc:creator>Yalemisew Abgaz</dc:creator>
        <dc:publisher>https://www.ark.adaptcentre.ie/</dc:publisher>
        <dc:modified>31/03/2021</dc:modified>
        <vocab:preferredNamespaceUri>https://openark.adaptcentre.ie/Ontologies/ARKProjects#</vocab:preferredNamespaceUri>
        <dc:contributor>Junli Liang</dc:contributor>
        <dc:contributor>Ademar Crotti Junior</dc:contributor>
        <dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
        <dc:contributor>Nick McDonald</dc:contributor>
        <dc:title xml:lang="en">Access Risk Knowledge Platform Ontology</dc:title>
        <dc:contributor>Rob Brennan</dc:contributor>
        <owl:versionInfo>0.2</owl:versionInfo>
        <vocab:preferredNamespacePrefix>arkp</vocab:preferredNamespacePrefix>
        <dc:contributor>Lucy McKenna</dc:contributor>
        <dcterms:rights rdf:resource="https://creativecommons.org/licenses/by/3.0/at/deed.en"/>
        <dc:contributor>Natalia Duda</dc:contributor>
    </owl:Ontology>
    


