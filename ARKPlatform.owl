    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Person -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Project -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#AdminUser -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#AdminUser">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User"/>
        <dc:creator>Ademar</dc:creator>
        <rdfs:comment>An admin user has access to all projects.</rdfs:comment>
        <rdfs:label>AdminUser</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Confidential -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Confidential">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Confidential information is defined as information which is protected by Irish and/or E.U. legislation or regulations, HSE policies or legal contracts. The unauthorised or accidental disclosure of this information could adversely impact the organisation, its patients, its staff and its business partners.</rdfs:comment>
        <rdfs:label xml:lang="en">Confidential</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification">
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Use to classifiy the sensitivity of data e.g., a project, an analysis or part of an analysis.  Data classification values are adapted from the HSE Information Classification &amp; Handling Policy.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Classification</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">A data entity can be Project, a Project Analysis, a Risk, a Cube question or any other unit of data on the ARK Platform.</rdfs:comment>
        <rdfs:comment xml:lang="en">A subclass of prov:Entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Internal -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Internal">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Internal information is defined as information that is only intended for internal distribution within an organisation. In the majority of instances there would be no significant impact on the organisation, its staff, clients or patients if this type of information was mishandled or accidentally released.</rdfs:comment>
        <rdfs:label xml:lang="en">Internal</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Personal -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Personal">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Restricted"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Restricted information that contains personal data. Personal data, as defined by the General Data Protection Regulation (GDPR), is any data that relates to a person or that could be used to identify a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole">
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">The role of a User on the ARK Platform.</rdfs:comment>
        <rdfs:label xml:lang="en">Platform Role</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Public -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Public">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Public information is defined as information that is available to the general public and is intended for distribution outside an organisation. There would be no impact on the organisation, its staff, clients or patients if this type of information was mishandled or accidentally released.</rdfs:comment>
        <rdfs:label xml:lang="en">Public</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Restricted -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Restricted">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataClassification"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Restricted information is defined as highly sensitive confidential information. The unauthorised or accidental disclosure of this information would seriously and adversely impact the organisation, its patients, its staff and its business partners.</rdfs:comment>
        <rdfs:label xml:lang="en">Restricted</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#SpecialCategory -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#SpecialCategory">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#Personal"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Special Category personal data, as defined by the General Data Protection Regulation (GDPR) Article 9, is any information that reveals a person&apos;s race, ethnic origin, political opinion, religious or philosophical beliefes, trade union membership, genetic data, biometric data for the purpose of uniquely identifying a natural person, data concerning health or data concerning a natural person’s sex life or sexual orientation.</rdfs:comment>
        <rdfs:label xml:lang="en">Special Category</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#User">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Person"/>
        <dc:description xml:lang="en">A User of the ARK Platform. A User is a subclass of arkc:Person.</dc:description>
        <rdfs:comment xml:lang="en">The user of the project can take three types. Owner, Collaborator, ReadOnlyUser.</rdfs:comment>
        <rdfs:label xml:lang="en">User</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#boardMember -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#boardMember">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:48:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">Member of the governing body of an organisation. Responsible for developing and reviewing the organisation’s mission and strategy. Guides the organisation’s long-term goals and policies.</rdfs:comment>
        <rdfs:label xml:lang="en">Board Member</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#clinicalSpecialist -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#clinicalSpecialist">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:47:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">Plays a role in the management of activities and staff resources in an area of specialisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Clinical Specialist</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#frontlineStaff -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#frontlineStaff">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:46:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">Including, but not limited to, firefighters, doctors, nurses, midwives, paramedics, healthcare assistants, social work practitioners and allied health staff who work directly with service users.</rdfs:comment>
        <rdfs:label xml:lang="en">Frontline Staff</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#operationsManager -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#operationsManager">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:46:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Responsible for managing the delivery of quality service user care. This includes, but is not limited to, maintaining, ordering and distributing appropriate Personal Protective Equipment (PPE).</rdfs:comment>
        <rdfs:label xml:lang="en">Operations Manager</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#organisationExecutive -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#organisationExecutive">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:47:33+00:00</dc:date>
        <rdfs:comment xml:lang="en">Responsible for all aspects of operations and for overseeing the functioning of the organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Organisation Executive</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#platformAdministrator -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#platformAdministrator">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">An administrator of the ARK Platform.</rdfs:comment>
        <rdfs:label xml:lang="en">Platform Administrator</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#safetyManager -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#safetyManager">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:49:16+00:00</dc:date>
        <rdfs:comment xml:lang="en">Directs the collection, measurement and presentation of data required for monitoring service quality and service user safety indicators. Assures compliance with regulations and standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety Manager</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKPlatform#unitManager -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#unitManager">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#PlatformRole"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-23T18:49:54+00:00</dc:date>
        <rdfs:comment xml:lang="en">Manager of a particular area or group of staff within an organisation e.g. ward manager, nursing manager.</rdfs:comment>
        <rdfs:label xml:lang="en">Unit Manager</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>



