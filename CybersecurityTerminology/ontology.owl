        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">extent to which planned activities are realized and planned results achieved.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Effectiveness</rdfs:label>
