        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">insight necessary to manage objectives (3.49), goals, risks and problems.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Information need</rdfs:label>
        <skos:definition xml:lang="en">insight necessary to manage objectives (3.49), goals, risks and problems.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Information need</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationProcessingFacility -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationProcessingFacility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">any information processing system, service or infrastructure, or the physical location housing it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Information processing facility</rdfs:label>
        <skos:definition xml:lang="en">any information processing system, service or infrastructure, or the physical location housing it.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Information processing facility</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationProtection -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationProtection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">Ensur(ing) that any data contained in a resource is not available when the resource is de-allocated from one object and reallocated to a different object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Information protection</rdfs:label>
        <skos:definition xml:lang="en">Ensur(ing) that any data contained in a resource is not available when the resource is de-allocated from one object and reallocated to a different object.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Information protection</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">preservation of confidentiality (3.10), integrity (3.36) and availability (3.7) of information Note 1 to entry: In addition, other properties, such as authenticity (3.6), accountability, non-repudiation (3.48), and reliability (3.55) can also be involved.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Information security</rdfs:label>
        <skos:definition xml:lang="en">preservation of confidentiality (3.10), integrity (3.36) and availability (3.7) of information Note 1 to entry: In addition, other properties, such as authenticity (3.6), accountability, non-repudiation (3.48), and reliability (3.55) can also be involved.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Information security</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityAssurance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityAssurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">Measure of confidence that the security features, practices, procedures, and architecture of an information system accurately mediates and enforces the security policy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Information security assurance</rdfs:label>
        <skos:definition xml:lang="en">Measure of confidence that the security features, practices, procedures, and architecture of an information system accurately mediates and enforces the security policy.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Information security assurance</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityContinuity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityContinuity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">processes (3.54) and procedures for ensuring continued information security (3.28) operations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Information security continuity</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurity"/>
        <skos:definition xml:lang="en">processes (3.54) and procedures for ensuring continued information security (3.28) operations.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Information security continuity</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityEvent -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityEvent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
