    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Effectiveness -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Effectiveness">
