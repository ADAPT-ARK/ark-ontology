        <terms:source>ISO27000:2036</terms:source>
        <rdfs:comment xml:lang="en">understanding the legal frameworks in which a business operates so that compliance can be achieved and maintained.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Legal environment</rdfs:label>
