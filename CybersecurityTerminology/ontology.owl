    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InternalContext -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InternalContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">internal environment in which the organization (3.50) seeks to achieve its objectives Note 1 to entry: Internal context can include: — governance, organizational structure, roles and accountabilities; — policies (3.53), objectives (3.49), and the strategies that are in place to achieve them; — the capabilities, understood in terms of resources and knowledge (e.g. capital, time, people, processes (3.54), systems and technologies); — information systems (3.35), information flows and decision-making processes (both formal and informal); — relationships with, and perceptions and values of, internal stakeholders (3.37); — the organization&apos;s culture; — standards, guidelines and models adopted by the organization; — form and extent of contractual relationships.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Internal context</rdfs:label>
        <skos:definition xml:lang="en">internal environment in which the organization (3.50) seeks to achieve its objectives Note 1 to entry: Internal context can include: — governance, organizational structure, roles and accountabilities; — policies (3.53), objectives (3.49), and the strategies that are in place to achieve them; — the capabilities, understood in terms of resources and knowledge (e.g. capital, time, people, processes (3.54), systems and technologies); — information systems (3.35), information flows and decision-making processes (both formal and informal); — relationships with, and perceptions and values of, internal stakeholders (3.37); — the organization&apos;s culture; — standards, guidelines and models adopted by the organization; — form and extent of contractual relationships.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CapabilitiesContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ContractualContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CultureContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#DecisionMakingProcessContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#GovernanceContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#GuidelinesContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationFlowContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSystemContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InternalStakeholderContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ModelsContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ObjectiveContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#OrganisationalStructureContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#OrganizationalAccountabilityContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#OrganizationalRoleContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#PolicyContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StandardsContext"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StrategyContext"/>
        <skos:prefLabel xml:lang="en">Internal context</skos:prefLabel>
    </owl:NamedIndividual>
    


