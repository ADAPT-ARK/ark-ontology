    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AccessControl -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AccessControl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">means to ensure that access to assets is authorized and restricted based on business and security requirements</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Access control</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurity"/>
        <skos:definition xml:lang="en">means to ensure that access to assets is authorized and restricted based on business and security requirements</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Access control</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ApplicationSecurity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ApplicationSecurity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">includes all tasks that introduce a secure software development life cycle to development teams. Its final goal is to improve security practices and, through that, to find, fix and preferably prevent security issues within applications.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Application security</rdfs:label>
        <skos:definition xml:lang="en">includes all tasks that introduce a secure software development life cycle to development teams. Its final goal is to improve security practices and, through that, to find, fix and preferably prevent security issues within applications.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Application security</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AssetManagement -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AssetManagement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">An ISCM capability that identifies unauthorized software or unmanaged devices that are likely to be used by attackers as a platform from which to extend compromise of the network to be mitigated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Asset management</rdfs:label>
        <skos:definition xml:lang="en">An ISCM capability that identifies unauthorized software or unmanaged devices that are likely to be used by attackers as a platform from which to extend compromise of the network to be mitigated.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Asset management</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Attack -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Attack">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">attempt to destroy, expose, alter, disable, steal or gain unauthorized access to or make unauthorized use of an asset.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Attack</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityIncident"/>
        <skos:definition xml:lang="en">attempt to destroy, expose, alter, disable, steal or gain unauthorized access to or make unauthorized use of an asset.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Attack</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Audit -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Audit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">systematic, independent and documented process (3.54) for obtaining audit evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled Note 1 to entry: An audit can be an internal audit (first party) or an external audit (second party or third party), and it can be a combined audit (combining two or more disciplines). Note 2 to entry: An internal audit is conducted by the organization itself, or by an external party on its behalf. Note 3 to entry: “Audit evidence” and “audit criteria” are defined in ISO 19011.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Audit</rdfs:label>
        <skos:definition xml:lang="en">systematic, independent and documented process (3.54) for obtaining audit evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled Note 1 to entry: An audit can be an internal audit (first party) or an external audit (second party or third party), and it can be a combined audit (combining two or more disciplines). Note 2 to entry: An internal audit is conducted by the organization itself, or by an external party on its behalf. Note 3 to entry: “Audit evidence” and “audit criteria” are defined in ISO 19011.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CombinedAudit"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ExternalAudit"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InternalAudit"/>
        <skos:prefLabel xml:lang="en">Audit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AuditScope -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#AuditScope">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">extent and boundaries of an audit (3.3)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Audit scope</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Audit"/>
        <skos:definition xml:lang="en">extent and boundaries of an audit (3.3)</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Audit scope</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Authentication -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Authentication">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
