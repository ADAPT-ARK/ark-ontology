    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CapabilitiesContext -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CapabilitiesContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2030</terms:source>
        <rdfs:comment xml:lang="en">Context capabilities are essential capabilities to get things done for a company. The context capabilities constitute the transactional services that typically are under the radar but surface when they do not work well. For example, Finance and Accounting are context capabilities for most companies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Capabilities context</rdfs:label>
        <skos:definition xml:lang="en">Context capabilities are essential capabilities to get things done for a company. The context capabilities constitute the transactional services that typically are under the radar but surface when they do not work well. For example, Finance and Accounting are context capabilities for most companies.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Capabilities context</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CombinedAudit -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CombinedAudit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
