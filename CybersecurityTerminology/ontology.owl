        <terms:source>ISO27000:2024</terms:source>
        <rdfs:comment xml:lang="en">landscape in which various organizations, service providers, and technology developers operate, compete, and collaborate to offer cybersecurity solutions and services.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Competitive environment</rdfs:label>
