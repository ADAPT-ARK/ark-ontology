    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ExternalStakeholder -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ExternalStakeholder">
