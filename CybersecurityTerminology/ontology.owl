        <skos:prefLabel xml:lang="en">Models context</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Monitoring -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Monitoring">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
