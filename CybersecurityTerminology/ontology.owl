    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CompetitiveEnvironment -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CompetitiveEnvironment">
