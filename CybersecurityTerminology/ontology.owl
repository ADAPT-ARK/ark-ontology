        <rdfs:comment xml:lang="en">measure (3.42) that is defined as a function of two or more values of base measures (3.8)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Derived measure</rdfs:label>
