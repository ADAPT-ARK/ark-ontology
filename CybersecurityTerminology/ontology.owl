     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#">
        <terms:abstract xml:lang="en">This taxonomy defines cybersecurity terms, taken from ISO and NIST documents, that are used to model this domain on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO terms.</terms:abstract>
        <terms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:description xml:lang="en">This taxonomy defines cybersecurity terms, taken from ISO and NIST documents, that are used to model this domain on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO terms.</terms:description>
        <terms:format>text/turtle</terms:format>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-29</terms:modified>
        <terms:rights rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#RightsStatement"/>
        <bibo:status rdf:resource="http://purl.org/ontology/bibo/status/draft"/>
        <vann:preferredNamespacePrefix>arkcyt</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <schema:codeRepository rdf:resource="https://gogs.adaptcentre.ie/ARK/Ontologies/src/master/ARKControlOntology"/>
        <schema:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment xml:lang="en">This taxonomy defines cybersecurity terms, taken from ISO and NIST documents, that are used to model this domain on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO terms.</rdfs:comment>
        <rdfs:label xml:lang="en">ARK Cybersecurity Terminology</rdfs:label>
        <owl:versionInfo>0.1</owl:versionInfo>
        <ns:status rdf:resource="http://www.w3.org/2003/06/sw-vocab-status/ns#unstable"/>
        <skos:prefLabel xml:lang="en">ARK Cybersecurity Terminology</skos:prefLabel>
        <dcat:accessURL rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology/ontology.ttl"/>
        <dcat:byteSize>250KB</dcat:byteSize>
        <dcat:downloadURL rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology/ontology.ttl"/>
        <vocab:introduction xml:lang="en">This taxonomy defines cybersecurity terms, taken from ISO and NIST documents, that are used to model this domain on the ARK Platform. Due to copyright restrictions, no definitions are provided for ISO terms.</vocab:introduction>
        <vocab:rdfxmlSerialization rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlOntology/ontology.ttl"/>
    </owl:Ontology>
    


