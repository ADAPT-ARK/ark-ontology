        <terms:source>ISO27000:2021</terms:source>
        <rdfs:comment xml:lang="en">A combined audit is an efficient and cost-effective approach for organizations seeking to comply with multiple standards or regulatory requirements.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Combined audit</rdfs:label>
        <skos:definition xml:lang="en">A combined audit is an efficient and cost-effective approach for organizations seeking to comply with multiple standards or regulatory requirements.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Combined audit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Competence -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Competence">
