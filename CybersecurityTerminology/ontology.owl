    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Governance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Governance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">A set of processes that ensures that data assets are formally managed throughout the enterprise. A data governance model establishes authority and management and decision making parameters related to the data produced or managed by the enterprise.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Governance</rdfs:label>
        <skos:definition xml:lang="en">A set of processes that ensures that data assets are formally managed throughout the enterprise. A data governance model establishes authority and management and decision making parameters related to the data produced or managed by the enterprise.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Governance</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#GovernanceContext -->


