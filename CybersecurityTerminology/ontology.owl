        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Competitive environment</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Confidentiality -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Confidentiality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">Preserving authorized restrictions on information access and disclosure, including means for protecting personal privacy and proprietary information.</rdfs:comment>
        <rdfs:comment xml:lang="en">property that information is not made available or disclosed to unauthorized individuals, entities, or processes (3.54)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Confidentiality</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurity"/>
        <skos:definition xml:lang="en">Preserving authorized restrictions on information access and disclosure, including means for protecting personal privacy and proprietary information.</skos:definition>
        <skos:definition xml:lang="en">property that information is not made available or disclosed to unauthorized individuals, entities, or processes (3.54)</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Confidentiality</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Conformity -->


