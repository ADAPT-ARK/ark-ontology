    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ThreatAndVulnerabilityManagement -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ThreatAndVulnerabilityManagement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
