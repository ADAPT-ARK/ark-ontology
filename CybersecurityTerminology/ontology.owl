    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Outsource -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Outsource">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">make an arrangement where an external organization (3.50) performs part of an organization’s function or process (3.54) Note 1 to entry: An external organization is outside the scope of the management system (3.41), although the outsourced function or process is within the scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Outsource</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Organization"/>
        <skos:definition xml:lang="en">make an arrangement where an external organization (3.50) performs part of an organization’s function or process (3.54) Note 1 to entry: An external organization is outside the scope of the management system (3.41), although the outsourced function or process is within the scope.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Outsource</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Performance -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Performance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
