    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityIncident -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#InformationSecurityIncident">
