    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CultureContext -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#CultureContext">
