    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#SupplierRelationshipsSecurity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#SupplierRelationshipsSecurity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">In a supplier relationship, it is important for an organisation to ensure that its information is protected against risks such as data breaches, unauthorized access, or loss of confidentiality. This can be achieved through a combination of technical and organisational measures and through establishing clear policies and procedures for handling and protecting information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Supplier relationship security</rdfs:label>
        <skos:definition xml:lang="en">In a supplier relationship, it is important for an organisation to ensure that its information is protected against risks such as data breaches, unauthorized access, or loss of confidentiality. This can be achieved through a combination of technical and organisational measures and through establishing clear policies and procedures for handling and protecting information.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Supplier relationship security</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#SystemAndNetworkSecurity -->


