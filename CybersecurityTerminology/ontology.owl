    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#BaseMeasure -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#BaseMeasure">
