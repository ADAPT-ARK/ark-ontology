        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderRelationship"/>
        <skos:narrower rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderValue"/>
        <skos:prefLabel xml:lang="en">Stakeholder Context</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderPerception -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderPerception">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2035</terms:source>
        <rdfs:comment xml:lang="en">The stakeholder perception approach refers to the way stakeholders perceive and evaluate the actions and behavior of a company or organization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Stakeholder perception</rdfs:label>
        <skos:definition xml:lang="en">The stakeholder perception approach refers to the way stakeholders perceive and evaluate the actions and behavior of a company or organization.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Stakeholder perception</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderRelationship -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderRelationship">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2031</terms:source>
        <rdfs:comment xml:lang="en">professional connections businesses form with people or groups who have an interest in their activities and decisions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Stakeholder relationship</rdfs:label>
        <skos:definition xml:lang="en">professional connections businesses form with people or groups who have an interest in their activities and decisions.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Stakeholder relationship</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderValue -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StakeholderValue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2026</terms:source>
        <rdfs:comment xml:lang="en">Stakeholder value refers to the benefits and advantages that various stakeholders derive from an organization&apos;s activities, policies, and performance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Stakeholder value</rdfs:label>
        <skos:definition xml:lang="en">Stakeholder value refers to the benefits and advantages that various stakeholders derive from an organization&apos;s activities, policies, and performance.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Stakeholder value</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StandardsContext -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StandardsContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2028</terms:source>
        <rdfs:comment xml:lang="en">Standards in the context of cybersecurity are established frameworks, guidelines, and specifications that organizations follow to ensure their systems, processes, and practices are secure and resilient against cyber threats.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Standards Context</rdfs:label>
        <skos:definition xml:lang="en">Standards in the context of cybersecurity are established frameworks, guidelines, and specifications that organizations follow to ensure their systems, processes, and practices are secure and resilient against cyber threats.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Standards Context</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#StrategyContext -->


