    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#DocumentedInformation -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#DocumentedInformation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
