        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">measurable result Note 1 to entry: Performance can relate either to quantitative or qualitative findings. Note 2 to entry: Performance can relate to the management of activities, processes (3.54), products (including services), systems or organizations (3.50)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Performance</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Measurement"/>
        <skos:definition xml:lang="en">measurable result Note 1 to entry: Performance can relate either to quantitative or qualitative findings. Note 2 to entry: Performance can relate to the management of activities, processes (3.54), products (including services), systems or organizations (3.50)</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Performance</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#PhysicalSecurity -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#PhysicalSecurity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</terms:created>
        <terms:source>ISO/IEC 27002:2022(E)</terms:source>
        <rdfs:comment xml:lang="en">A set of mutually reinforcing security controls implemented by technical, physical, and procedural means. Such controls are typically selected to achieve a common information security-related purpose.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Physical security</rdfs:label>
        <skos:definition xml:lang="en">A set of mutually reinforcing security controls implemented by technical, physical, and procedural means. Such controls are typically selected to achieve a common information security-related purpose.</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Physical security</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Policy -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#Policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
        <terms:source>ISO27000:2018</terms:source>
        <rdfs:comment xml:lang="en">intentions and direction of an organization (3.50), as formally expressed by its top management (3.75)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <rdfs:label xml:lang="en">Policy</rdfs:label>
        <skos:broader rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#ManagementSystem"/>
        <skos:definition xml:lang="en">intentions and direction of an organization (3.50), as formally expressed by its top management (3.75)</skos:definition>
        <skos:inScheme rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#"/>
        <skos:prefLabel xml:lang="en">Policy</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#PolicyContext -->


    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKControlTerminology#PolicyContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-08</terms:created>
