    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Accept -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Accept">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Accept the level of risk based on existing information e.g. pursue the opportunity.</skos:definition>
        <skos:prefLabel xml:lang="en">Accept</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ActionOwner -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ActionOwner">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">in order to monitor the action one person must have lead responsibility.</skos:definition>
        <skos:prefLabel xml:lang="en">Action. owner</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Actions -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Actions">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Actions are a future measure that will maintain and/or modify a risk. In the HSE, an action is a future measure to further reduce either the likelihood or impact of a risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Actions</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#AvoidOrTerminate -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#AvoidOrTerminate">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Avoid/Terminate it completely e.g. do not proceed with the planned activity.</skos:definition>
        <skos:prefLabel xml:lang="en">Avoid/terminate</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ControlOwner -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ControlOwner">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:prefLabel xml:lang="en">Control owner</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Controls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Controls">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Controls are measures that maintain and/or modify risk. In the HSE, a control is a measure that is in place, is working effectively and operating to reduce either the likelihood or impact of a risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#CorrectiveControls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#CorrectiveControls">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControls"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Corrective controls are designed to correct errors or undesirable events which have occurred and will prevent further occurrences.</skos:definition>
        <skos:prefLabel xml:lang="en">Corrective controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#CurrentRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#CurrentRisk">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Current risk is the level of risk after both the existing controls and actions are considered at the point in time the risk is being assessed</skos:definition>
        <skos:prefLabel xml:lang="en">Current risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DetectiveControls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DetectiveControls">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControls"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Detective controls are designed to search for and identify errors or undesirable events after they have occurred so that corrective actions can be taken.</skos:definition>
        <skos:prefLabel xml:lang="en">Detective controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DirectiveControls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#DirectiveControls">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControls"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Directive controls give direction. These can be, for example, statutory obligations, regulatory standards including professional standards, or other organisational requirements or instructions, many of which are converted into policies, procedures, circulars, standard operating procedures and training.</skos:definition>
        <skos:prefLabel xml:lang="en">Directive controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ExternalAssuranceProviders -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ExternalAssuranceProviders">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">assurance from external independent assurance providers such as Regulators.</skos:definition>
        <skos:prefLabel xml:lang="en">External Assurance providers</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#FirstLineOfDefence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#FirstLineOfDefence">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">the way risks are managed and controlled day-to-day. Assurance comes directly from those responsible for delivering specific objectives or processes. Its value comes from those who know the business, culture and day-to-day challenges.</skos:definition>
        <skos:prefLabel xml:lang="en">First line of defence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#InherentRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#InherentRisk">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Inherent risk in the HSE is the level of risk before consideration of control and/or action measures.</skos:definition>
        <skos:prefLabel xml:lang="en">Inherent risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#InitialRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#InitialRisk">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Initial risk is the level of risk after existing controls are considered when the risk was originally assessed.</skos:definition>
        <skos:prefLabel xml:lang="en">Initial risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#PreventativeControls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#PreventativeControls">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControls"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Preventative controls are controls designed to stop, discourage, pre-empt or limit the possibility of an undesirable event before it occurs.</skos:definition>
        <skos:prefLabel xml:lang="en">Preventative controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ProactiveControls">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Proactive controls are put in place before the risk materialises</skos:definition>
        <skos:prefLabel xml:lang="en">Proactive controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#REsidualRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#REsidualRisk">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Residual risk in the HSE is the level of risk remaining after consideration of existing controls.</skos:definition>
        <skos:prefLabel xml:lang="en">Residual risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControls -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ReactiveControls">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Reactive controlsfocus on what happens after the risk occurs or which identify weaknesses in our current controls</skos:definition>
        <skos:prefLabel xml:lang="en">Reactive controls</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Reduce -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#Reduce">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Reduce the risk with further actions.</skos:definition>
        <skos:prefLabel xml:lang="en">Reduce</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#RiskTreatment -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#RiskTreatment">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Risk treatment is the process to modify risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Risk treatment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#SecondLineOfDefence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#SecondLineOfDefence">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">the way the organisation oversees the control framework so that it operates effectively. The assurance provided is separate from those responsible for delivery, but not independent of the management chain, such as risk and compliance functions.</skos:definition>
        <skos:prefLabel xml:lang="en">Second line of defence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TargetRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TargetRisk">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Target risk in the HSE is the planned level of risk after consideration of both control and action measures.</skos:definition>
        <skos:prefLabel xml:lang="en">Target risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ThirdLineOfDefence -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#ThirdLineOfDefence">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">objective and independent assurance, e.g. internal audit, providing reasonable (not absolute) assurance of the overall effectiveness of governance, risk management and controls.</skos:definition>
        <skos:prefLabel xml:lang="en">Third line of defence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TransferRisk -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TransferRisk">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">Transfer the risk e.g. to an identified individual or unit, that has been communicated to and notified, where many of the actions identified as required to mitigate are better managed and are within their span of control.</skos:definition>
        <skos:prefLabel xml:lang="en">Transfer the risk</skos:prefLabel>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TreaementPlan -->


    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#TreaementPlan">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:creator>Nick McDonald</terms:creator>
        <terms:source rdf:resource="https://www2.healthservice.hse.ie/organisation/national-pppgs/hse-integrated-risk-management-policy/"/>
        <rdfs:isDefinedBy rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <skos:definition xml:lang="en">treatment plans detail both action and effective control plans, to minimise the likelihood and impact of the identified risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatmant plan</skos:prefLabel>
    </owl:Class>
</rdf:RDF>



