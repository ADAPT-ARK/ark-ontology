     xml:base="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="https://w3id.org/widoco/vocab#">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <dc:title xml:lang="en">HSE ERM Control Ontology</dc:title>
        <terms:abstract xml:lang="en">This ontology defines the sets of owl classes to be used to instantiate Controls</terms:abstract>
        <terms:contributor>Junli Liang</terms:contributor>
        <terms:contributor>Nick McDonald</terms:contributor>
        <terms:contributor>Rob Brennan</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:created>
        <terms:description xml:lang="en">This ontology defines the sets of owl classes to be used to instantiate Controls</terms:description>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-15</terms:modified>
        <terms:publisher rdf:resource="https://openark.adaptcentre.ie"/>
        <terms:rights rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:source xml:lang="en">HSE ERM Control Ontology</terms:source>
        <vann:preferredNamespacePrefix>hseERM</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://openark.adaptcentre.ie/Ontologies/HSE-ERM-ControlOntology#"/>
        <rdfs:comment xml:lang="en">This ontology defines the sets of owl classes to be used to instantiate Controls</rdfs:comment>
        <owl:versionInfo>0.1</owl:versionInfo>
        <vocab:introduction xml:lang="en">This ontology defines the sets of owl classes to be used to instantiate Controls</vocab:introduction>
    </owl:Ontology>
    


