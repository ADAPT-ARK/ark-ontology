<?xml version="1.0"?>
<rdf:RDF xmlns="https://ark.adaptcentre.ie/Ontologies/ARKCube#"
     xml:base="https://ark.adaptcentre.ie/Ontologies/ARKCube"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vocab="http://purl.org/vocab/vann/">
    <owl:Ontology rdf:about="https://ark.adaptcentre.ie/Ontologies/ARKCube#">
        <owl:versionIRI rdf:resource="https://ark.adaptcentre.ie/Ontologies/ARKCube"/>
        <dc:contributor xml:lang="en">Ademar Crotti Junior</dc:contributor>
        <dc:contributor xml:lang="en">Junli Liang</dc:contributor>
        <dc:contributor xml:lang="en">Natalia Duda</dc:contributor>
        <dc:contributor xml:lang="en">Nick Mcdonald</dc:contributor>
        <dc:contributor xml:lang="en">Rob Brennan</dc:contributor>
        <dc:creator xml:lang="en">Yalemisew Abgaz</dc:creator>
        <dc:modified>182/04/2020</dc:modified>
        <dc:publisher>https://www.ARKAmarach.adaptcentre.ie/</dc:publisher>
        <dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
        <dc:title xml:lang="en">Access Risk Knowledge Cube Questionnaire Ontology</dc:title>
        <vocab:preferredNamespacePrefix>ARKC</vocab:preferredNamespacePrefix>
        <vocab:preferredNamespaceUri>https://ARKAmarach.adaptcentre.ie/Ontologies/ARKCube#</vocab:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, Trinity College Dublin (Prof Nick Mcdonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</rdfs:comment>
        <rdfs:comment xml:lang="en">This ontology supports the cube questionnaire developed by TCD</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</owl:versionInfo>
    </owl:Ontology>
    


