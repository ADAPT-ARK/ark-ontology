        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:18:16+00:00</dc:date>
        <rdfs:comment xml:lang="en">Repeated failure to meet external standards. Failure to meet national norms and standards/Regulations (e.g. Mental Health, Child Care Act etc). Critical report or substantial number of significant findings and/or lack of adherence to regulations.</rdfs:comment>
        <rdfs:label xml:lang="en">Major Impact - Compliance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#majorImpactEnvironment -->

