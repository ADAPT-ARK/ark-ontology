        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T18:56:12+00:00</dc:date>
        <rdfs:comment xml:lang="en">Minor non-compliance with internal PPPGs. Small number of minor issues requiring improvement.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Compliance</rdfs:label>
    </owl:NamedIndividual>
    


