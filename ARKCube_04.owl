        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-18T13:34:27+00:00</dc:date>
        <rdfs:label xml:lang="en">has efficacy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasEvidence -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasEvidence">
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Evidence"/>
        <dc:contributor>Ademar</dc:contributor>
        <dc:creator>yalemisew</dc:creator>
        <dc:date>2019-11-18T13:07:27+00:00</dc:date>
        <dc:modified>2020-05-20T12:28:07.518488</dc:modified>
