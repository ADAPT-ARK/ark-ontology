        <rdfs:label xml:lang="en">has evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasEvidenceRule -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasEvidenceRule">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Answer"/>
        <dc:creator>yalemisew</dc:creator>
        <dc:date>2019-11-18T13:07:41+00:00</dc:date>
        <rdfs:comment>Represents and links evidence rule with  question.</rdfs:comment>
        <rdfs:label xml:lang="en">has evidence rule</rdfs:label>
        <owl:deprecated xml:lang="en">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasExistingControl -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasExistingControl">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"/>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk with a description of what administrative/procedural/existing controls measures are currently in place to mitigate the risk. Include engineering controls, policies, procedures, protocols, guidelines (clinical and non-clinical), training, emergency arrangements, preventative maintenance controls etc. When examining existing control measures, consider the adequacy, method of implementation and level of effectiveness in eliminating or minimising risk to the lowest practicable level.</rdfs:comment>
        <rdfs:label xml:lang="en">has existing control</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasGainAchieved -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasGainAchieved">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskVerificationAssessment"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#GainAchieved"/>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date>2020-12-18T13:34:27+00:00</dc:date>
        <rdfs:comment xml:lang="en">Connects risk verifaction assessment with gain achieved</rdfs:comment>
        <rdfs:label xml:lang="en">has gain achieved</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasImpact -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasImpact">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Impact"/>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk to its Impact. Based on the HSE Risk Matrix – what Impact score would you give the risk (1-5)?</rdfs:comment>
        <rdfs:label xml:lang="en">has impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasImportance -->

