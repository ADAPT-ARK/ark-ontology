        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29t09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The source from which the risk was identified e.g. Incident Management, Audit, Health and Safety Risk Assessment, Inspection Report, Complaint.</rdfs:comment>
        <rdfs:label xml:lang="en">risk source</rdfs:label>
    </owl:DatatypeProperty>
    


