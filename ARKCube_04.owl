        <dc:date>2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks relating to procedures/systems/accounting records which expose the organisation to financial risks, including risks to assets. A type of Risk Impact Category described in the HSE Risk Assessment Tool.</rdfs:comment>
        <rdfs:label xml:lang="en">Finance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#harmToAPerson -->

