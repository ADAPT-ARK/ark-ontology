        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defines a numerical value for a risk rating, risk likelihood or impact based on the HSE risk tables.</rdfs:comment>
        <rdfs:label xml:lang="en">score</rdfs:label>
    </owl:DatatypeProperty>
    


