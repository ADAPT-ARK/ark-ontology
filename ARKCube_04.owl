    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#riskSource -->

    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#riskSource">
