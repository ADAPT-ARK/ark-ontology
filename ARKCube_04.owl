        <rdfs:comment xml:lang="en">Adverse event leading to minor injury not requiring first aid. No impaired Psychosocial functioning.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Harm to a Person</rdfs:label>
