        <rdfs:comment xml:lang="en">The primary area impacted by a Risk. The HSE Risk Assessment tool identifies eight primary impact areas.</rdfs:comment>
        <rdfs:label xml:lang="en">Primary Impact Category</rdfs:label>
    </owl:Class>
    


