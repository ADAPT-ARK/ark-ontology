                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis"/>
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk"/>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Links a Risk Assessment Record, a Project, a Project Analysis or a Stage to a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskAssessmentRecord -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskAssessmentRecord">
        <rdfs:domain rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRegister"/>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord"/>
        <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-15T22:46:04+00:00</dc:creator>
        <dc:creator>Lucy McKenna</dc:creator>
        <rdfs:comment xml:lang="en">Links a Risk Register to a Risk Assessment Record.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk assessment record</rdfs:label>
    </owl:ObjectProperty>
    


