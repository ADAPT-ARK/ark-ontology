    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent"/>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Action -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Action">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Control"/>
