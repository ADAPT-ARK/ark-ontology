        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks which threaten the organisation’s ability to deliver its services and serve the community. A type of Risk Impact Category described in the HSE Risk Assessment Tool.</rdfs:comment>
        <rdfs:label xml:lang="en">Business Continuity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#catastrophic -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#catastrophic">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Severity"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Death or multiple irreversible injuries.</rdfs:comment>
        <rdfs:label xml:lang="en">Catastrophic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#closed -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#closed">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskStatus"/>
        <rdfs:comment>Closed, i.e. that the risk no longer exists e.g. where an unsuitable premises is replaced by a suitable one.</rdfs:comment>
        <rdfs:label xml:lang="en">Closed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#compliance -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#compliance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory"/>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks associated with compliance with requirements in relation to the standards set out in relation  to  the  organisation  and  delivery  of  high  quality  services i.e. Statutory, Clinical, Professional and Management Standards. A type of Risk Impact Category described in the HSE Risk Assessment Tool.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbAlmostCertain -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbAlmostCertain">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Inadequate health and safety controls, an accident will occur.</rdfs:comment>
        <rdfs:label xml:lang="en">Almost Certain</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbPossible -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbPossible">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">If the situation is not well managed an accident is likely to occur.</rdfs:comment>
        <rdfs:label xml:lang="en">Possible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbRare -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbRare">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Accidents could only happen under certain conditions. The situation is very well controlled, and all reasonable precautions have been taken.</rdfs:comment>
        <rdfs:label xml:lang="en">Rare</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbUnlikely -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbUnlikely">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The situation is well under control, but occasional lapses could occur.</rdfs:comment>
        <rdfs:label xml:lang="en">Unlikely</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbVeryLikely -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#dfbVeryLikely">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-28T11:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Inadequate health and safety controls in place. If conditions remain unchanged there is a high probability of an accident.</rdfs:comment>
        <rdfs:label xml:lang="en">Very Likely</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#dublinFireBrigade -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#dublinFireBrigade">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Organisation"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-26T14:14:43+00:00</dc:date>
        <rdfs:label xml:lang="en">Dublin Fire Brigade</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#environment -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#environment">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory"/>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2021-01-29T09:52:00+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risks which threaten the prevention, limitation, elimination, abatement or reduction of environmental   pollution and the preservation of a quality environment. A type of Risk Impact Category described in the HSE Risk Assessment Tool.</rdfs:comment>
        <rdfs:label xml:lang="en">Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactAdversePublicity-Reputation -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactAdversePublicity-Reputation">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">National/International media/adverse publicity, &gt; than 3 days. Editorial follows days of news stories &amp; features in National papers.Public confidence in the organisation undermined.HSE use of resources questioned. CEO’s performance questioned. Calls for individual HSE officials to be sanctioned. Taoiseach/Minister forced to comment or intervene. Questions in the Dáil. Public calls (at national level) for specific remedial actions to be taken. Court action. Public (independent) Inquiry.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Adverse Publicity/Reputation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactBusinessContinuity -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactBusinessContinuity">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Permanent loss of core service or facility.Disruption to facility leading to significant ‘knock on’ effect.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Business Continuity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactCompliance -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactCompliance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Gross failure to meet external standards. Repeated failure to meet national norms and standards/regulations. Severely critical report with possible major reputational or financial implications.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Compliance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactEnvironment -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactEnvironment">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Toxic release affecting off-site with detrimental effect requiring outside assistance.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Environment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactFinance -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactFinance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">&gt;2.0% budget deficit.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Finance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHarmToAPerson -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactHarmToAPerson">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Incident leading to death or major permanent incapacity. Event which impacts on large number of service users or member of the public. Permanent psychosocial functioning incapacity.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Harm to a Person</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactObjectivesAndProjects -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactObjectivesAndProjects">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Inability to meet project objectives. Reputation of the organisation seriously damaged.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Objectives/Projects</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactServiceUserExperience -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#extremeImpactServiceUserExperience">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ExtremeImpact"/>
        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T20:33:47+00:00</dc:date>
        <rdfs:comment xml:lang="en">Totally unsatisfactory service user outcome resulting in long term effects, or extremely poor experience of care provision.</rdfs:comment>
        <rdfs:label xml:lang="en">Extreme Impact - Service User Experience</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#finance -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#finance">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#ImpactCategory"/>
