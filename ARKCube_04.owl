        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Used to hold a signature of the responsible person in a risk assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">signature</rdfs:label>
    </owl:DatatypeProperty>
    


