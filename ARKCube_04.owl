        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-15T11:38:03+00:00</dc:date>
        <rdfs:comment xml:lang="en">A report format template.</rdfs:comment>
        <rdfs:label xml:lang="en">Report Template</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Risk">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasRiskRating"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Risk is the effect of uncertainty on objectives. It is measured in terms of consequences and likelihood. In the context of the HSE and its services, it is any condition or circumstance which may impact on the achievement of objectives and/or have a significant impact on the day-to-day operations. This includes failing to maximise any opportunity that would help the HSE or service meet its objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessment -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessment">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasImportance"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Importance"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date>2020-12-18T13:34:27+00:00</dc:date>
        <dc:description xml:lang="en">Identfied during the CUBE problem stage.</dc:description>
        <rdfs:label xml:lang="en">Risk Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskAssessmentRecord">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Used to collect risk information from a risk assessment, for example in a risk register. Supports HSE risk assessment form fields.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Assessment Record (Form)</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskContext -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskContext">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Context"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <rdfs:comment xml:lang="en">The context of a Risk. Used for risk description in ICC (impact, cause, context) format. Used to relate HSE concept of the context of a risk to CUBE concept of context.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Context</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskDescription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Desribes a risk in ICC (Impact, Cause, Context) format.</rdfs:comment>
        <rdfs:comment>Rob Brennan</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Description</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskImplementationAssessment -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskImplementationAssessment">
        <rdfs:subClassOf>
