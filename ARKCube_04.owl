                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <dc:date>2020-12-18T13:34:27+00:00</dc:date>
        <dc:description xml:lang="en">Identfied during the CUBE solution stage.</dc:description>
        <rdfs:label xml:lang="en">Projected Gain</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedReliabilityOfGain -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectedReliabilityOfGain">
        <rdfs:subClassOf>
            <owl:Class>
