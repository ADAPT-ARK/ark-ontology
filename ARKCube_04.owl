        <score rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</score>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-25T19:15:34+00:00</dc:date>
        <rdfs:comment xml:lang="en">Interruption in a service which does not impact on the delivery of service user care or the ability to continue to provide service.</rdfs:comment>
        <rdfs:label xml:lang="en">Negligible Impact - Business Continuity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactCompliance -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#negligibleImpactCompliance">
