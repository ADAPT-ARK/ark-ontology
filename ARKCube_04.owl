<?xml version="1.0"?>
<rdf:RDF xmlns="https://openark.adaptcentre.ie/Ontologies/ARKCube#"
     xml:base="https://openark.adaptcentre.ie/Ontologies/ARKCube"
     xmlns:arkc="https://openark.adaptcentre.ie/Ontologies/ARKCube#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:vocab="http://purl.org/vocab/vann/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:arkp="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#"
     xmlns:ARKCube="https://openark.adaptcentre.ie/Ontologies/ARKCube#:"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#">
        <owl:versionIRI rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube"/>
        <dc:contributor xml:lang="en">Natalia Duda</dc:contributor>
        <dc:creator xml:lang="en">Yalemisew Abgaz</dc:creator>
        <dc:creator xml:lang="en">Rob Brennan</dc:creator>
        <vocab:preferredNamespacePrefix>arkc</vocab:preferredNamespacePrefix>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.81</owl:versionInfo>
        <dc:contributor xml:lang="en">Junli Liang</dc:contributor>
        <dc:modified>08/02/2021</dc:modified>
        <dc:publisher>https://openark.adaptcentre.ie/</dc:publisher>
        <dc:contributor xml:lang="en">Ademar Crotti Junior</dc:contributor>
        <dc:contributor xml:lang="en">Nick McDonald</dc:contributor>
        <rdfs:comment xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, the Centre for Innovative Human Systems, Trinity College Dublin (Prof Nick McDonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</rdfs:comment>
        <vocab:preferredNamespaceUri>https://openark.adaptcentre.ie/Ontologies/ARKCube#</vocab:preferredNamespaceUri>
        <dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
        <dc:contributor xml:lang="en">Rob Brennan</dc:contributor>
        <dc:contributor>Lucy McKenna</dc:contributor>
        <dc:description xml:lang="en">The ARK Cube ontology represents the concepts and relationships that are represented in organisational change and its risk. To analyse the organisational change and the risks associated with it, the Centre for Innovative Human Systems, Trinity College Dublin (Prof Nick McDonald and his team) developed the cube methodology which uses a series of questions categorised into project phases, dimensions and aspects of reality. The ARKCube ontology models the cube methodology and modelled the process, content and outcome of such processes (ARK Cube ontology).</dc:description>
        <dc:title xml:lang="en">Access Risk Knowledge Cube Ontology</dc:title>
    </owl:Ontology>
    


