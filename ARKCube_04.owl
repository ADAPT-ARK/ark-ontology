    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#RiskRating">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#isProjected"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#score"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The estimated level of risk taking into consideration the existing controls in place. Defined by cross-referencing the impact and likelihood in the risk matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Rating</rdfs:label>
    </owl:Class>
    


