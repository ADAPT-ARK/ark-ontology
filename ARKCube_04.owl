    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasContext -->

    <owl:ObjectProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasContext">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Project"/>
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#ProjectAnalysis"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Context"/>
        <dc:creator>yalemisew</dc:creator>
        <dc:date>2020-01-29T16:05:29+00:00</dc:date>
        <rdfs:comment xml:lang="en">The context of a project phase.</rdfs:comment>
        <rdfs:label xml:lang="en">has context</rdfs:label>
        <owl:inverseOf>isContextOf</owl:inverseOf>
    </owl:ObjectProperty>
    


