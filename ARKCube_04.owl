    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Impact -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Impact">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-22T09:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The imact of a Risk. Used for risk description following the ICC (impact, cause, context) approach. The outcome or consequence of an event affecting objectives. It can be expressed either qualitatively or quantitatively, being a loss, disadvantage or gain. There may be a range of possible outcomes associated with an event.</rdfs:comment>
        <rdfs:label xml:lang="en">Impact</rdfs:label>
    </owl:Class>
    


