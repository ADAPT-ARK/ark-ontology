        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:label xml:lang="en">Action</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Activity -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Activity">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality"/>
        <dc:creator>Yalemisew</dc:creator>
        <dc:date>2019-11-13T15:29:07+00:00</dc:date>
        <rdfs:comment xml:lang="en">The condition in which things are happening or being done. Activity refers to the measurable activity within the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Answer -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Answer">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasEvidence"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Evidence"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator>Yalemisew</dc:creator>
        <dc:date>2019-11-13T15:29:27+00:00</dc:date>
        <rdfs:comment xml:lang="en">A written account in response to a question asked.</rdfs:comment>
        <rdfs:label xml:lang="en">Answer</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Artefact -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Artefact">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <dc:creator>Ademar</dc:creator>
        <dc:date>2020-05-20T14:31:50.607524</dc:date>
        <rdfs:comment>Artefacts are associated to an evidence collection. An artefact may be, for example, a dataset containing information relevant to an answer.</rdfs:comment>
        <rdfs:label>Artefact</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality">
        <dc:creator>Yalemisew</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-13T15:26:56+00:00</dc:date>
        <rdfs:comment xml:lang="en">Aspect of Reality is a dimension which explores the Functional System, Activity, Sensemaking and Culture across four System Dimensions: Goals, Process, Social, and Knowledge and Information.</rdfs:comment>
        <rdfs:label xml:lang="en">Aspect of Reality</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Cause -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Cause">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">The cause of a Risk. Used for risk description in ICC (impact, cause, context) format.</rdfs:comment>
        <rdfs:label xml:lang="en">Cause</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Context -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Context">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:creator>Yalemisew</dc:creator>
        <dc:date>2020-01-28T16:34:24+00:00</dc:date>
        <rdfs:comment xml:lang="en">Wider circumstances of the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Context</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Control -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Control">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">A mechanism, process, procedure or action which can be verified, which seeks to reduce the likelihood and/or consequence of a risk. Controls include any process, policy, device, practice, or other  actions which modify risk. They can exist or be required as additional in order to further mitigate the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Control</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Culture -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Culture">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#AspectOfReality"/>
        <dc:creator>Yalemisew</dc:creator>
        <dc:date>2019-11-13T15:29:07+00:00</dc:date>
        <rdfs:comment xml:lang="en">A set of collective attitudes, values, goals and practices that characterize a community or system</rdfs:comment>
        <rdfs:label xml:lang="en">Culture</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#DFBLikelihood">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#Likelihood"/>
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date xml:lang="en">2021-09-28T16:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">Likelihood ratings as per Dublin Fire Brigade&apos;s Risk Rating Matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">DFB Likelihood</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#Deliverable -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#Deliverable">
        <rdfs:subClassOf rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKPlatform#DataEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#textualDescription"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
