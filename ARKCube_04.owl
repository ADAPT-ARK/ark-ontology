            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:creator>Rob Brennan</dc:creator>
        <dc:date>2020-09-29T09:09:10+00:00</dc:date>
        <rdfs:comment xml:lang="en">Defines a person, for example in an organisation.</rdfs:comment>
        <rdfs:comment xml:lang="en">arkc:Person is a subclass of prov:Agent.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#PlanPrepareStage -->

    <owl:Class rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#PlanPrepareStage">
