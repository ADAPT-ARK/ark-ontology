    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#majorImpactAdversePublicity-Reputation -->

    <owl:NamedIndividual rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#majorImpactAdversePublicity-Reputation">
        <rdf:type rdf:resource="https://openark.adaptcentre.ie/Ontologies/ARKCube#MajorImpact"/>
