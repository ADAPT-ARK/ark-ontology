    <owl:DatatypeProperty rdf:about="https://openark.adaptcentre.ie/Ontologies/ARKCube#hasDistribution">
        <dc:creator>Lucy McKenna</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-15T11:53:21+00:00</dc:date>
        <rdfs:comment xml:lang="en">The people, groups, departments or organisations with whom a report can be shared/distributed.</rdfs:comment>
        <rdfs:label xml:lang="en">has distribution</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://openark.adaptcentre.ie/Ontologies/ARKCube#hasDivision -->

